<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Hocon" Version="2.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DexaWeb.Dexa\DexaWeb.Dexa.fsproj" />
  </ItemGroup>

  <!-- DeepPinger.dll: 서버 빌드 전 C++ DLL 자동 빌드 -->
  <Target Name="BuildDeepPinger" BeforeTargets="Build" Condition="'$(SkipDeepPinger)' != 'true'">
    <MSBuild Projects="..\DeepPinger\DeepPinger.vcxproj"
             Properties="Configuration=$(Configuration);Platform=x64;SolutionDir=$(SolutionDir)" />
  </Target>

</Project>
