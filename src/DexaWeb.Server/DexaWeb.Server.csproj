<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Hocon" Version="2.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DexaWeb.Dexa\DexaWeb.Dexa.fsproj" />
  </ItemGroup>

  <!-- ServerConfig.razor에서 Akka.Actor.IActorRef 사용 -->
  <ItemGroup>
    <Reference Include="Akka">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\Akka.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- DeepPinger.dll: 미리 빌드된 DLL을 출력 폴더에 복사 -->
  <Target Name="CopyDeepPinger" BeforeTargets="Build">
    <Copy SourceFiles="..\libs\DeepPinger.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
