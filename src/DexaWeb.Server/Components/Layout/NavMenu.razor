@using static DexaWeb.Server.Helpers.LayoutHelpers
@inject DashboardService DashboardService
@inject AssetStatusService AssetStatusService
@inject AssetService AssetService
@inject DexaNotificationService NotificationService
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Config
@implements IDisposable

<div class="nav-wrapper">
    @if (!string.IsNullOrEmpty(_logoUrl))
    {
        <div class="nav-logo-area" style="padding: @(_logoPadding)px;">
            <a href="/" style="display:flex; align-items:center; justify-content:center; width:100%;">
                <img src="@_logoUrl" alt="로고" class="nav-logo" />
            </a>
        </div>
    }
    <div class="nav-top-section">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Class="nav-top-link">
                대시보드
            </MudNavLink>

            <MudNavLink Href="/layout" Class="nav-top-link">
                레이아웃
            </MudNavLink>

            <MudNavLink Href="/history" Class="nav-top-link">
                자산 통합조회
            </MudNavLink>

            <AuthorizeView Roles="Admin">
                <MudNavLink Href="/admin" Class="nav-top-link">
                    관리
                </MudNavLink>
            </AuthorizeView>

            <MudDivider Class="my-2" />

            <div class="nav-tree-lines">
            @foreach (var line in _lineNodes)
            {
                <div class="nav-tree-line-group">
                    <div class="d-flex align-center nav-plc-row nav-tree-row--line">
                        <MudIconButton Icon="@(line.Expanded ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)"
                                       Size="Size.Small"
                                       OnClick="@(() => line.Expanded = !line.Expanded)"
                                       Class="nav-plc-toggle"
                                       Style="@($"--status-color: {GetLineAggregateColor(line)};")" />
                        <MudNavLink Href="@($"/history?tab=0&line={Uri.EscapeDataString(line.LineName)}")"
                                    Class="flex-grow-1" Style="min-width: 0;">
                            <span class="nav-tree-label--line">@line.LineName</span>
                        </MudNavLink>
                    </div>
                    @if (line.Expanded)
                    {
                        <div class="nav-tree-branch">
                        @foreach (var plcNode in line.PlcNodes)
                        {
                            @if (plcNode.Children.Count > 0)
                            {
                                <div class="nav-tree-node">
                                    <div class="d-flex align-center nav-plc-row">
                                        <MudIconButton Icon="@(plcNode.Expanded ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)"
                                                       Size="Size.Small"
                                                       OnClick="@(() => plcNode.Expanded = !plcNode.Expanded)"
                                                       Class="nav-plc-toggle"
                                                       Style="@($"--status-color: {GetPlcAggregateColor(plcNode)};")" />
                                        <MudNavLink Href="@($"/assets/{plcNode.Plc.AssetId}")"
                                                    Class="flex-grow-1" Style="min-width: 0;">
                                            <div class="d-flex align-center">
                                                <span class="nav-icon-status-wrap">
                                                    <img src="@GetNavIcon(plcNode.Plc)" class="asset-type-icon-nav" />
                                                    @if (IsOffline(plcNode.Plc.AssetId))
                                                    {
                                                        <span class="nav-status-offline-bg"></span>
                                                    }
                                                    <span class="nav-status-dot-indicator" style="background:@GetAssetStatusColor(plcNode.Plc.AssetId);"></span>
                                                </span>
                                                @plcNode.Plc.DisplayName
                                            </div>
                                        </MudNavLink>
                                    </div>
                                    @if (plcNode.Expanded)
                                    {
                                        <div class="nav-tree-branch nav-tree-branch--leaf">
                                            @foreach (var child in plcNode.Children)
                                            {
                                                <div class="nav-tree-node">
                                                    <MudNavLink Href="@($"/assets/{child.AssetId}")">
                                                        <div class="d-flex align-center">
                                                            <span class="nav-icon-status-wrap">
                                                                <img src="@GetNavIcon(child)" class="asset-type-icon-nav" />
                                                                @if (IsOffline(child.AssetId))
                                                                {
                                                                    <span class="nav-status-offline-bg"></span>
                                                                }
                                                                <span class="nav-status-dot-indicator" style="background:@GetAssetStatusColor(child.AssetId);"></span>
                                                            </span>
                                                            @child.DisplayName
                                                        </div>
                                                    </MudNavLink>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="nav-tree-node">
                                    <MudNavLink Href="@($"/assets/{plcNode.Plc.AssetId}")">
                                        <div class="d-flex align-center">
                                            <span class="nav-icon-status-wrap">
                                                <img src="@GetNavIcon(plcNode.Plc)" class="asset-type-icon-nav" />
                                                @if (IsOffline(plcNode.Plc.AssetId))
                                                {
                                                    <span class="nav-status-offline-bg"></span>
                                                }
                                                <span class="nav-status-dot-indicator" style="background:@GetAssetStatusColor(plcNode.Plc.AssetId);"></span>
                                            </span>
                                            @plcNode.Plc.DisplayName
                                        </div>
                                    </MudNavLink>
                                </div>
                            }
                        }
                        @foreach (var asset in line.Standalone)
                        {
                            <div class="nav-tree-node">
                                <MudNavLink Href="@($"/assets/{asset.AssetId}")">
                                    <div class="d-flex align-center">
                                        <span class="nav-icon-status-wrap">
                                            <img src="@GetNavIcon(asset)" class="asset-type-icon-nav" />
                                            @if (IsOffline(asset.AssetId))
                                            {
                                                <span class="nav-status-offline-bg"></span>
                                            }
                                            <span class="nav-status-dot-indicator" style="background:@GetAssetStatusColor(asset.AssetId);"></span>
                                        </span>
                                        @asset.DisplayName
                                    </div>
                                </MudNavLink>
                            </div>
                        }
                        </div>
                    }
                </div>
            }
            </div>

        </MudNavMenu>
    </div>

    <div class="nav-mini-dashboard">
        <div class="nav-mini-kpi-grid">
            <div class="nav-mini-kpi-item">
                <span class="nav-mini-kpi-dot" style="background: var(--mud-palette-primary);"></span>
                <span class="nav-mini-kpi-value">@_assetStatuses.Count</span>
                <span class="nav-mini-kpi-label">전체</span>
            </div>
            <div class="nav-mini-kpi-item">
                <span class="nav-mini-kpi-dot" style="background: var(--mud-palette-success);"></span>
                <span class="nav-mini-kpi-value">@_statBackedUp</span>
                <span class="nav-mini-kpi-label">갱신</span>
            </div>
            <div class="nav-mini-kpi-item">
                <span class="nav-mini-kpi-dot" style="background: var(--mud-palette-info);"></span>
                <span class="nav-mini-kpi-value">@_statUnchanged</span>
                <span class="nav-mini-kpi-label">유지</span>
            </div>
            <div class="nav-mini-kpi-item">
                <span class="nav-mini-kpi-dot" style="background: var(--mud-palette-error);"></span>
                <span class="nav-mini-kpi-value">@_statFailed</span>
                <span class="nav-mini-kpi-label">주의</span>
            </div>
        </div>
    </div>

</div>

@code {
    private bool _dexaConnected;
    private AgentSummary _agents = new();
    private System.Threading.Timer? _timer;

    private List<AssetStatusInfo> _assetStatuses = [];
    private List<AssetStatusInfo> _heatmapAssets = [];
    private int _statBackedUp;
    private int _statUnchanged;
    private int _statFailed;

    private bool _isDashboardPage;
    private string? _logoUrl;
    private int _logoPadding = 10;

    private List<NavLineNode> _lineNodes = [];
    private Dictionary<int, AssetStatusInfo> _statusMap = [];

    protected override async Task OnInitializedAsync()
    {
        _isDashboardPage = IsDashboardPath(Navigation.Uri);
        _logoPadding = Config.GetValue("App:LogoPadding", 10);
        Navigation.LocationChanged += OnLocationChanged;
        NotificationService.OnDatabaseChanged += HandleDatabaseChanged;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var isAdmin = auth.User.IsInRole("Admin");

        await Task.WhenAll(LoadStatusAsync(), LoadAssetTreeAsync());
        _timer = new System.Threading.Timer(async _ =>
        {
            await LoadStatusAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _isDashboardPage = IsDashboardPath(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private bool IsDashboardPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath;
        return path == "/" || path.Equals("/index", StringComparison.OrdinalIgnoreCase);
    }

    private async void HandleDatabaseChanged(string tableName)
    {
        if (tableName is "action" or "actionlog" or "asset" or "agent" or "connectivity" or "*")
        {
            await InvokeAsync(async () =>
            {
                var tasks = new List<Task> { LoadStatusAsync() };
                if (tableName is "asset" or "*")
                    tasks.Add(LoadAssetTreeAsync());
                await Task.WhenAll(tasks);
                StateHasChanged();
            });
        }
    }

    private string? ScanLogoUrl()
    {
        try
        {
            if (!Directory.Exists(TwmsDataPath.Uploads)) return null;
            var files = Directory.GetFiles(TwmsDataPath.Uploads, "app-logo.*");
            if (files.Length == 0) return null;
            var fi = new FileInfo(files[0]);
            var ts = fi.LastWriteTimeUtc.Ticks;
            return $"/uploads/{Path.GetFileName(files[0])}?t={ts}";
        }
        catch { return null; }
    }

    private async Task LoadStatusAsync()
    {
        try
        {
            var connTask = DashboardService.GetConnectionStatusAsync();
            var agentTask = DashboardService.GetAgentSummaryAsync();
            var assetTask = AssetStatusService.GetAssetStatusesAsync();
            await Task.WhenAll(connTask, agentTask, assetTask);

            _logoPadding = Config.GetValue("App:LogoPadding", 10);
            _dexaConnected = connTask.Result.DexaConnected;
            _agents = agentTask.Result;
            _assetStatuses = assetTask.Result;
            _statusMap = _assetStatuses.ToDictionary(s => s.AssetId);
            _logoUrl = ScanLogoUrl();

            // KPI 통계
            var total = _assetStatuses.Count;
            var backupSuccessCount = _assetStatuses.Count(s => s.LastBackupSucceeded);
            var changedCount = _assetStatuses.Count(s => s.LastBackupChanged == true);
            var noBackup = _assetStatuses.Count(s => s.LastBackupTime == null);
            var failed = total - backupSuccessCount - noBackup;
            var unchanged = backupSuccessCount - changedCount;

            _statBackedUp = changedCount;
            _statUnchanged = unchanged;
            _statFailed = failed;

            // 히트맵 정렬
            _heatmapAssets = _assetStatuses
                .OrderBy(a => a.Health switch
                {
                    AssetHealthStatus.BackedUp => 0,
                    AssetHealthStatus.InProgress => 1,
                    AssetHealthStatus.Failed => 2,
                    AssetHealthStatus.Unknown => 3,
                    AssetHealthStatus.Unchanged => 4,
                    _ => 5,
                })
                .ThenBy(a => a.LatestPing is { Reachable: false } ? 1 : 0)
                .ThenBy(a => a.Name)
                .ToList();
        }
        catch { /* 사이드바가 오류로 깨지지 않도록 */ }
    }

    private static string GetHeatmapTileClass(AssetHealthStatus health) => health switch
    {
        AssetHealthStatus.BackedUp => "heatmap-tile-success",
        AssetHealthStatus.Unchanged => "heatmap-tile-info",
        AssetHealthStatus.Failed => "heatmap-tile-error",
        AssetHealthStatus.InProgress => "heatmap-tile-inprogress",
        _ => "heatmap-tile-warning",
    };

    private async Task LoadAssetTreeAsync()
    {
        try
        {
            // 기존 펼침 상태 캡처
            var oldLineExp = _lineNodes.Where(l => l.Expanded)
                .Select(l => l.LineName).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var oldPlcExp = _lineNodes.SelectMany(l => l.PlcNodes)
                .Where(p => p.Expanded).Select(p => p.Plc.AssetId).ToHashSet();

            var all = await AssetService.GetAllAssetsAsync();
            var realAssets = all.Where(a => a.IsRealAsset).ToList();
            _lineNodes = BuildAssetTree(realAssets);

            // 펼침 상태 복원
            foreach (var line in _lineNodes)
            {
                if (oldLineExp.Contains(line.LineName))
                    line.Expanded = true;
                foreach (var plc in line.PlcNodes)
                    if (oldPlcExp.Contains(plc.Plc.AssetId))
                        plc.Expanded = true;
            }
        }
        catch { /* 트리 로드 실패 시 무시 */ }
    }

    private static List<NavLineNode> BuildAssetTree(List<ViewAsset> assets)
    {
        var result = new List<NavLineNode>();

        var byLine = assets
            .GroupBy(a => a.LayoutLineName ?? "라인없음")
            .OrderBy(g => g.Key == "라인없음" ? 1 : 0)
            .ThenBy(g => g.Key);

        foreach (var lineGrp in byLine)
        {
            var lineAssets = lineGrp.ToList();
            var lineNode = new NavLineNode { LineName = lineGrp.Key };

            var ipToAsset = new Dictionary<string, ViewAsset>(StringComparer.OrdinalIgnoreCase);
            foreach (var a in lineAssets)
            {
                if (!string.IsNullOrEmpty(a.Ip))
                    ipToAsset.TryAdd(a.Ip, a);
            }

            var plcChildren = new Dictionary<int, List<ViewAsset>>();
            var assignedIds = new HashSet<int>();

            foreach (var a in lineAssets)
            {
                if (string.IsNullOrEmpty(a.AugIpVia)) continue;
                if (ipToAsset.TryGetValue(a.AugIpVia, out var plc) && plc.AssetId != a.AssetId)
                {
                    if (!plcChildren.ContainsKey(plc.AssetId))
                        plcChildren[plc.AssetId] = [];
                    plcChildren[plc.AssetId].Add(a);
                    assignedIds.Add(a.AssetId);
                }
            }

            foreach (var (plcId, children) in plcChildren.OrderBy(kv => kv.Value.First().AugIpVia))
            {
                var plc = lineAssets.First(a => a.AssetId == plcId);
                assignedIds.Add(plc.AssetId);
                lineNode.PlcNodes.Add(new NavPlcNode
                {
                    Plc = plc,
                    Children = children.OrderBy(c => c.DisplayName).ToList(),
                });
            }

            lineNode.Standalone = lineAssets
                .Where(a => !assignedIds.Contains(a.AssetId))
                .OrderBy(a => a.DisplayName)
                .ToList();

            result.Add(lineNode);
        }

        return result;
    }

    private static string GetNavIcon(ViewAsset asset) => asset.AssetTypeUserFriendlyName switch
    {
        var n when n != null && n.Contains("PLC") && asset.AugIsRobotPLC is > 0 => "images/icons/robot.png",
        var n when n != null && n.Contains("PLC") => "images/icons/plc.png",
        var n when n != null && n.Contains("Servo") => "images/icons/servo.png",
        var n when n != null && (n.Contains("HMI") || n.Contains("XP")) => "images/icons/hmi.png",
        var n when n != null && n.Contains("Drive") => "images/icons/drive.png",
        var n when n != null && n.Contains("FTP") => "images/icons/ftp.png",
        _ => "images/icons/plc.png"
    };

    private AssetStatusInfo? GetStatus(int assetId) =>
        _statusMap.GetValueOrDefault(assetId);

    private bool IsOffline(int assetId) =>
        GetStatus(assetId)?.LatestPing is { Reachable: false };

    private string GetAssetStatusColor(int assetId) =>
        GetHealthColor(GetStatus(assetId)?.Health ?? AssetHealthStatus.Unknown);

    /// <summary>자산 ID 목록의 상태 취합: 실패 > 작업중 > 갱신 > 유지 > 내역없음</summary>
    private string AggregateHealthColor(IEnumerable<int> assetIds)
    {
        var hasAny = false;
        var hasFailed = false;
        var hasInProgress = false;
        var hasBackedUp = false;
        var hasUnchanged = false;
        foreach (var id in assetIds)
        {
            var s = GetStatus(id);
            if (s == null) continue;
            hasAny = true;
            switch (s.Health)
            {
                case AssetHealthStatus.Failed: hasFailed = true; break;
                case AssetHealthStatus.InProgress: hasInProgress = true; break;
                case AssetHealthStatus.BackedUp: hasBackedUp = true; break;
                case AssetHealthStatus.Unchanged: hasUnchanged = true; break;
            }
        }
        if (!hasAny) return GetHealthColor(AssetHealthStatus.Unknown);
        if (hasFailed) return GetHealthColor(AssetHealthStatus.Failed);
        if (hasInProgress) return GetHealthColor(AssetHealthStatus.InProgress);
        if (hasBackedUp) return GetHealthColor(AssetHealthStatus.BackedUp);
        if (hasUnchanged) return GetHealthColor(AssetHealthStatus.Unchanged);
        return GetHealthColor(AssetHealthStatus.Unknown);
    }

    private string GetPlcAggregateColor(NavPlcNode plcNode)
    {
        var ids = plcNode.Children.Select(c => c.AssetId);
        return AggregateHealthColor(ids);
    }

    private string GetLineAggregateColor(NavLineNode line)
    {
        var ids = line.PlcNodes.SelectMany(p => p.Children.Select(c => c.AssetId).Prepend(p.Plc.AssetId))
            .Concat(line.Standalone.Select(a => a.AssetId));
        return AggregateHealthColor(ids);
    }

    private class NavLineNode
    {
        public string LineName { get; set; } = "";
        public List<NavPlcNode> PlcNodes { get; set; } = [];
        public List<ViewAsset> Standalone { get; set; } = [];
        public bool Expanded { get; set; }
    }

    private class NavPlcNode
    {
        public ViewAsset Plc { get; set; } = null!;
        public List<ViewAsset> Children { get; set; } = [];
        public bool Expanded { get; set; }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        NotificationService.OnDatabaseChanged -= HandleDatabaseChanged;
        _timer?.Dispose();
    }
}
