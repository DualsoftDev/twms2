@inject AssetService AssetService
@inject ISnackbar Snackbar

<MudDrawer @bind-Open="IsOpen" Anchor="Anchor.End" Elevation="4"
           Width="600px" Variant="@DrawerVariant.Temporary"
           Style="z-index: 1300;">
    <MudDrawerHeader Class="d-flex align-center justify-space-between">
        <MudText Typo="Typo.h6">
            @(_asset?.DisplayName ?? "자산 편집")
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" Size="Size.Small" />
    </MudDrawerHeader>
    <div class="pa-3" style="overflow-y: auto; height: calc(100% - 64px);">
        @if (_asset != null)
        {
            <AssetDetail Asset="_asset" OnSaved="HandleSaved" HeightOverride="auto" />
        }
        else if (AssetId.HasValue)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
    </div>
</MudDrawer>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int? AssetId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private ViewAsset? _asset;
    private List<ViewAsset> _allAssets = [];

    protected override async Task OnParametersSetAsync()
    {
        if (AssetId.HasValue)
        {
            if (_allAssets.Count == 0)
                _allAssets = (await AssetService.GetAllAssetsAsync()).Where(a => a.IsRealAsset).ToList();
            _asset = _allAssets.FirstOrDefault(a => a.AssetId == AssetId.Value);
        }
        else
        {
            _asset = null;
        }
    }

    private async Task HandleSaved()
    {
        Snackbar.Add("자산 정보가 저장되었습니다.", Severity.Success);
        // 캐시 갱신
        _allAssets = (await AssetService.GetAllAssetsAsync()).Where(a => a.IsRealAsset).ToList();
        _asset = _allAssets.FirstOrDefault(a => a.AssetId == AssetId);
        await OnSaved.InvokeAsync();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}
