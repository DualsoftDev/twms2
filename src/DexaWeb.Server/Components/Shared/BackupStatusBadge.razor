@using DexaWeb.Server.Models.Dashboard

<MudChip T="string"
         Size="Size.Small"
         Color="@GetColor()"
         Variant="Variant.Filled"
         Icon="@GetIcon()"
         Style="@GetStyle()"
>
    @GetLabel()
</MudChip>

@code {
    [Parameter] public AssetHealthStatus Health { get; set; }
    [Parameter] public bool AgentOnline { get; set; } = true;

    private Color GetColor() => Health switch
    {
        AssetHealthStatus.BackedUp => Color.Success,
        AssetHealthStatus.Unchanged => Color.Info,
        AssetHealthStatus.Failed => Color.Error,
        AssetHealthStatus.InProgress => Color.Warning,
        _ => Color.Default,
    };

    private string GetIcon() => Health switch
    {
        AssetHealthStatus.BackedUp => Icons.Material.Filled.CheckCircle,
        AssetHealthStatus.Unchanged => Icons.Material.Filled.Remove,
        AssetHealthStatus.Failed => Icons.Material.Filled.Error,
        AssetHealthStatus.InProgress => Icons.Material.Filled.HourglassTop,
        _ => Icons.Material.Filled.HelpOutline,
    };

    private string GetStyle() => "font-weight: 600; letter-spacing: 0.3px; min-width: 80px; justify-content: center;";

    private string GetLabel() => Health switch
    {
        AssetHealthStatus.BackedUp => "백업 갱신",
        AssetHealthStatus.Unchanged => "변경 없음",
        AssetHealthStatus.Failed => "작업 실패",
        AssetHealthStatus.InProgress => "작업중",
        _ => "내역 없음",
    };
}
