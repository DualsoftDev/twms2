@page "/history"
@implements IDisposable
@inject DexaReadService DexaRead
@inject AssetStatusService AssetStatus
@inject DexaNotificationService NotificationService
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TwmDbService TwmDb
@using System.Text
@using DexaWeb.Server.Models.Dashboard
@using DexaWeb.Server.Models.Twm
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>TWM - 자산 통합조회</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">자산 통합조회</MudText>

<MudTabs Elevation="1" Rounded="true" PanelClass="pt-3" ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChanged">
    @* ─── 탭 1: 자산 정보 ─── *@
    <MudTabPanel Text="자산 정보">
        <MudPaper Class="pa-4" Elevation="2">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
                <input type="text" @bind="_searchText" @bind:event="oninput" @bind:after="OnSearchTextChanged"
                       placeholder="자산명 / IP 검색" class="date-input" style="width: 200px;" />
                <MudButtonGroup OverrideStyles="false" Size="Size.Small" Style="gap: 10px; flex: 0 0 auto;">
                    <MudButton Variant="@(_searchMode == "contains" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("contains"))">포함</MudButton>
                    <MudButton Variant="@(_searchMode == "exact" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("exact"))">정확한 단어</MudButton>
                    <MudButton Variant="@(_searchMode == "exclude" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("exclude"))">제외</MudButton>
                </MudButtonGroup>
                <div style="width: 1px; height: 24px; background: var(--mud-palette-lines-default); opacity: 0.4; margin: 0 6px;"></div>
                <select value="@_filterAssetType" @onchange="OnAssetTypeChanged" class="date-input"
                        style="width: 140px; cursor: pointer;">
                    <option value="">전체 타입</option>
                    @foreach (var t in _assetTypeNames)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <select value="@_filterLine" @onchange="OnLineChanged" class="date-input"
                        style="width: 140px; cursor: pointer;">
                    <option value="">전체 라인</option>
                    @foreach (var l in _lineNames)
                    {
                        <option value="@l">@l</option>
                    }
                </select>
                <select value="@_filterHealth" @onchange="OnHealthChanged" class="date-input"
                        style="width: 140px; cursor: pointer;">
                    <option value="">전체 상태</option>
                    <option value="backedup">백업 갱신</option>
                    <option value="unchanged">변경 없음</option>
                    <option value="failed">작업 실패</option>
                    <option value="inprogress">작업중</option>
                    <option value="unknown">내역 없음</option>
                </select>
                <div style="flex: 1 1 auto;"></div>
                <div style="width: 1px; height: 24px; background: var(--mud-palette-lines-default); opacity: 0.4; margin: 0 6px;"></div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="ExportAssetCsv" Disabled="!FilteredAssets.Any()"
                           StartIcon="@Icons.Material.Filled.Save"
                           Style="flex: 0 0 auto;">저장</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           OnClick="CopyLink"
                           StartIcon="@Icons.Material.Filled.Link"
                           Style="flex: 0 0 auto;">링크 복사</MudButton>
            </div>

            <MudDivider Class="mb-3" />

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_assetList.Count == 0)
            {
                <MudAlert Severity="Severity.Info">자산 데이터가 없습니다.</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-2">@FilteredAssets.Count() 건 조회됨</MudText>
                <MudDataGrid T="AssetStatusInfo" Items="@FilteredAssets" Dense="true" Hover="true" Bordered="true"
                             SortMode="SortMode.Multiple" RowsPerPage="25">
                    <Columns>
                        <TemplateColumn Title="자산명" SortBy="x => x.Name">
                            <CellTemplate>
                                <MudLink Href="@($"/assets/{context.Item.AssetId}")" Color="Color.Default" Underline="Underline.Hover">
                                    @(context.Item.Name)
                                </MudLink>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.AssetTypeName" Title="타입" />
                        <TemplateColumn Title="라인" SortBy="x => x.LayoutLineName ?? string.Empty">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.LayoutLineName ?? "-")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="벤더" SortBy="x => x.AugVendor ?? string.Empty">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.AugVendor ?? "-")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="스펙" SortBy="x => x.AugSpec ?? string.Empty">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.AugSpec ?? "-")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="설명" SortBy="x => x.Description ?? string.Empty">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    @(context.Item.Description ?? "-")
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        @if (ShowConnColumns)
                        {
                            <TemplateColumn Title="ViaIP" SortBy="x => x.AugIpVia ?? string.Empty">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">@(context.Item.AugIpVia ?? "-")</MudText>
                                </CellTemplate>
                            </TemplateColumn>
                        }
                        <PropertyColumn Property="x => x.Ip" Title="IP" />
                        @if (ShowConnColumns)
                        {
                            <TemplateColumn Title="Base" SortBy="x => x.AugBaseNumber ?? 0">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">@(context.Item.AugBaseNumber?.ToString() ?? "-")</MudText>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Slot" SortBy="x => x.AugSlotNumber ?? 0">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">@(context.Item.AugSlotNumber?.ToString() ?? "-")</MudText>
                                </CellTemplate>
                            </TemplateColumn>
                        }
                        <TemplateColumn Title="스테이션" SortBy="x => x.AugStationNumber ?? 0">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.AugStationNumber?.ToString() ?? "-")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        @if (ShowModelVersion)
                        {
                            <TemplateColumn Title="모델버전" SortBy="x => x.ModelVersion ?? string.Empty">
                                <CellTemplate>
                                    <MudText Typo="Typo.body2">@(context.Item.ModelVersion ?? "-")</MudText>
                                </CellTemplate>
                            </TemplateColumn>
                        }
                        @if (ShowRobotColumn)
                        {
                            <TemplateColumn Title="로봇PLC" SortBy="x => x.AugIsRobotPLC ?? 0">
                                <CellTemplate>
                                    @if (context.Item.AugIsRobotPLC == 1)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2">-</MudText>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        }

                        @* ── 상태 컬럼 ── *@
                        <TemplateColumn Title="상태" SortBy="x => (int)x.Health">
                            <CellTemplate>
                                <BackupStatusBadge Health="@context.Item.Health" AgentOnline="@context.Item.AgentOnline" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="마지막 백업" SortBy="x => x.LastBackupTime ?? DateTime.MinValue">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(context.Item.LastBackupTime?.ToString("MM/dd HH:mm") ?? "-")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="AssetStatusInfo" PageSizeOptions="new[] { 25, 50, 100 }" />
                    </PagerContent>
                </MudDataGrid>
            }
        </MudPaper>
    </MudTabPanel>

    @* ─── 탭 2: 백업 이력 ─── *@
    <MudTabPanel Text="백업 이력">
        <MudPaper Class="pa-4" Elevation="2">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
                <input type="text" @bind="_searchText" @bind:event="oninput" @bind:after="OnSearchTextChanged"
                       placeholder="검색어 입력" class="date-input" style="width: 180px;" />
                <MudButtonGroup OverrideStyles="false" Size="Size.Small" Style="gap: 10px; flex: 0 0 auto;">
                    <MudButton Variant="@(_searchMode == "contains" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("contains"))">포함</MudButton>
                    <MudButton Variant="@(_searchMode == "exact" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("exact"))">정확한 단어</MudButton>
                    <MudButton Variant="@(_searchMode == "exclude" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("exclude"))">제외</MudButton>
                </MudButtonGroup>
                <div style="width: 1px; height: 24px; background: var(--mud-palette-lines-default); opacity: 0.4; margin: 0 6px;"></div>
                <div style="display: flex; align-items: center; gap: 8px; flex: 0 0 auto;">
                    <input type="date" @bind="_startDate" @bind:format="yyyy-MM-dd" @bind:after="OnDateManualChange"
                           max="@_endDate.ToString("yyyy-MM-dd")" class="date-input" />
                    <MudText Typo="Typo.body2" Style="opacity:0.5;">→</MudText>
                    <input type="date" @bind="_endDate" @bind:format="yyyy-MM-dd" @bind:after="OnDateManualChange"
                           min="@_startDate.ToString("yyyy-MM-dd")" class="date-input" />
                </div>
                <MudButtonGroup OverrideStyles="false" Size="Size.Small" Style="gap: 10px; flex: 0 0 auto;">
                    <MudButton Variant="@(_periodLabel == "today" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetPeriod(0))">오늘</MudButton>
                    <MudButton Variant="@(_periodLabel == "7days" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetPeriod(7))">최근 7일</MudButton>
                    <MudButton Variant="@(_periodLabel == "30days" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetPeriod(30))">최근 30일</MudButton>
                </MudButtonGroup>
                <div style="width: 1px; height: 24px; background: var(--mud-palette-lines-default); opacity: 0.4; margin: 0 6px;"></div>
                <select value="@_selectedResult" @onchange="OnResultSelectChanged" class="date-input"
                        style="width: 120px; cursor: pointer;">
                    <option value="">전체 결과</option>
                    <option value="백업 갱신">백업 갱신</option>
                    <option value="변경 없음">변경 없음</option>
                    <option value="작업 실패">작업 실패</option>
                    <option value="작업중">작업중</option>
                </select>
                <select value="@_filterLine" @onchange="OnHistoryLineChanged" class="date-input"
                        style="width: 140px; cursor: pointer;">
                    <option value="">전체 라인</option>
                    @foreach (var l in _lineNames)
                    {
                        <option value="@l">@l</option>
                    }
                </select>
                <div style="flex: 1 1 auto;"></div>
                <div style="width: 1px; height: 24px; background: var(--mud-palette-lines-default); opacity: 0.4; margin: 0 6px;"></div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="ExportCsv" Disabled="_actions.Count == 0"
                           StartIcon="@Icons.Material.Filled.Save"
                           Style="flex: 0 0 auto;">저장</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           OnClick="CopyLink"
                           StartIcon="@Icons.Material.Filled.Link"
                           Style="flex: 0 0 auto;">링크 복사</MudButton>
            </div>

            <MudDivider Class="mb-3" />

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_historyError != null)
            {
                <MudAlert Severity="Severity.Warning">@_historyError</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-2">@_actions.Count 건 조회됨</MudText>
                <MudDataGrid Items="_actions" Dense="true" Hover="true" Bordered="true"
                             SortMode="SortMode.Multiple"
                             RowsPerPage="25">
                    <Columns>
                        <TemplateColumn Title="자산" SortBy="x => GetAssetName(x.AssetId)">
                            <CellTemplate>
                                <MudLink Href="@($"/assets/{context.Item.AssetId}")" Color="Color.Default" Underline="Underline.Hover">
                                    @GetAssetName(context.Item.AssetId)
                                </MudLink>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="타입" SortBy="x => GetAssetType(x.AssetId)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@GetAssetType(context.Item.AssetId)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="라인" SortBy="x => GetAssetLine(x.AssetId)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(GetAssetLine(context.Item.AssetId) is var ln && ln != "" ? ln : "-")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="버전" SortBy="x => x.Version">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Inline="true">@context.Item.Version</MudText>
                                @if (IsNewUpdate(context.Item) && context.Item.Version > 1)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small"
                                             Variant="Variant.Outlined" Class="ml-1">
                                        @($"{context.Item.Version - 1} → {context.Item.Version}")
                                    </MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Started" Title="작업 시작" Format="yyyy-MM-dd HH:mm:ss" />
                        <PropertyColumn Property="x => x.Finished" Title="작업 종료" Format="yyyy-MM-dd HH:mm:ss" />
                        <TemplateColumn Title="결과" SortBy="x => GetResultLabel(x)">
                            <CellTemplate>
                                @if (IsInProgress(context.Item))
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Icon="@Icons.Material.Filled.HourglassTop"
                                             Style="font-weight:600; min-width:80px; justify-content:center;">작업중</MudChip>
                                }
                                else if (context.Item.Memo?.ToLower() != "true")
                                {
                                    @if (IsStaleIncomplete(context.Item))
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                                 Variant="Variant.Filled"
                                                 Icon="@Icons.Material.Filled.HourglassDisabled"
                                                 Style="font-weight:600; min-width:80px; justify-content:center;">미완료</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                                 Variant="Variant.Filled"
                                                 Icon="@Icons.Material.Filled.Error"
                                                 Style="font-weight:600; min-width:80px; justify-content:center;">작업 실패</MudChip>
                                    }
                                }
                                else if (context.Item.ContentsChanged == true)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Icon="@Icons.Material.Filled.CheckCircle"
                                             Style="font-weight:600; min-width:80px; justify-content:center;">백업 갱신</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Icon="@Icons.Material.Filled.Remove"
                                             Style="font-weight:600; min-width:80px; justify-content:center;">변경 없음</MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="다운로드" Sortable="false">
                            <CellTemplate>
                                @if (context.Item.Version.HasValue)
                                {
                                    @if (IsNewUpdate(context.Item))
                                    {
                                        <MudTooltip Text="@($"v{context.Item.Version} 새 백업 다운로드")">
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small"
                                                     Variant="Variant.Filled"
                                                     Icon="@Icons.Material.Filled.Download"
                                                     OnClick="() => DownloadBackup(context.Item)"
                                                     Style="font-weight:600; min-width:80px; justify-content:center; cursor:pointer;">
                                                새 백업
                                            </MudChip>
                                        </MudTooltip>
                                    }
                                    else if (IsInProgress(context.Item))
                                    {
                                        <MudTooltip Text="작업 진행 중 — 완료 후 다운로드 가능">
                                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                           Color="Color.Default" Size="Size.Small" Disabled="true" />
                                        </MudTooltip>
                                    }
                                    else if (context.Item.Memo?.ToLower() != "true")
                                    {
                                        <MudTooltip Text="@($"작업 실패 — 마지막 성공 백업 v{context.Item.Version} 다운로드")">
                                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                           Color="Color.Error" Size="Size.Small"
                                                           Style="opacity:0.5;"
                                                           OnClick="() => DownloadBackup(context.Item)" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="@($"변경 없음 — 현재 백업 v{context.Item.Version} 다운로드")">
                                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                           Color="Color.Info" Size="Size.Small"
                                                           OnClick="() => DownloadBackup(context.Item)" />
                                        </MudTooltip>
                                    }
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="리포트" Sortable="false">
                            <CellTemplate>
                                @if (context.Item.ContentsChanged == true)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                   Color="GetResultColor(context.Item)" Size="Size.Small"
                                                   Title="리포트 보기"
                                                   OnClick="() => OpenReport(context.Item)" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="로그" Sortable="false">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Article"
                                               Size="Size.Small" Color="GetResultColor(context.Item)"
                                               OnClick="() => ShowLogs(context.Item)" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="DexaAction" PageSizeOptions="new[] { 25, 50, 100 }" />
                    </PagerContent>
                </MudDataGrid>
            }
        </MudPaper>
    </MudTabPanel>

    @* ─── 탭 3: 통신 이력 ─── *@
    <MudTabPanel Text="통신 이력">
        <MudPaper Class="pa-4" Elevation="2">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
                <input type="text" @bind="_searchText" @bind:event="oninput" @bind:after="OnSearchTextChanged"
                       placeholder="자산명 / IP 검색" class="date-input" style="width: 180px;" />
                <MudButtonGroup OverrideStyles="false" Size="Size.Small" Style="gap: 10px; flex: 0 0 auto;">
                    <MudButton Variant="@(_searchMode == "contains" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("contains"))">포함</MudButton>
                    <MudButton Variant="@(_searchMode == "exact" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("exact"))">정확한 단어</MudButton>
                    <MudButton Variant="@(_searchMode == "exclude" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetSearchMode("exclude"))">제외</MudButton>
                </MudButtonGroup>
                <div style="width: 1px; height: 24px; background: var(--mud-palette-lines-default); opacity: 0.4; margin: 0 6px;"></div>
                <div style="display: flex; align-items: center; gap: 8px; flex: 0 0 auto;">
                    <input type="date" @bind="_startDate" @bind:format="yyyy-MM-dd" @bind:after="OnDateManualChange"
                           max="@_endDate.ToString("yyyy-MM-dd")" class="date-input" />
                    <MudText Typo="Typo.body2" Style="opacity:0.5;">→</MudText>
                    <input type="date" @bind="_endDate" @bind:format="yyyy-MM-dd" @bind:after="OnDateManualChange"
                           min="@_startDate.ToString("yyyy-MM-dd")" class="date-input" />
                </div>
                <MudButtonGroup OverrideStyles="false" Size="Size.Small" Style="gap: 10px; flex: 0 0 auto;">
                    <MudButton Variant="@(_periodLabel == "today" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetPeriod(0))">오늘</MudButton>
                    <MudButton Variant="@(_periodLabel == "7days" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetPeriod(7))">최근 7일</MudButton>
                    <MudButton Variant="@(_periodLabel == "30days" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" OnClick="@(() => SetPeriod(30))">최근 30일</MudButton>
                </MudButtonGroup>
                <div style="width: 1px; height: 24px; background: var(--mud-palette-lines-default); opacity: 0.4; margin: 0 6px;"></div>
                <select value="@_pingStatusFilter" @onchange="OnPingStatusChanged" class="date-input"
                        style="width: 120px; cursor: pointer;">
                    <option value="">전체 상태</option>
                    <option value="online">온라인</option>
                    <option value="offline">오프라인</option>
                </select>
                <select value="@_filterLine" @onchange="OnHistoryLineChanged" class="date-input"
                        style="width: 140px; cursor: pointer;">
                    <option value="">전체 라인</option>
                    @foreach (var l in _lineNames)
                    {
                        <option value="@l">@l</option>
                    }
                </select>
                <div style="flex: 1 1 auto;"></div>
                <div style="width: 1px; height: 24px; background: var(--mud-palette-lines-default); opacity: 0.4; margin: 0 6px;"></div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="ExportPingCsv" Disabled="_pingLogs.Count == 0"
                           StartIcon="@Icons.Material.Filled.Save"
                           Style="flex: 0 0 auto;">저장</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           OnClick="CopyLink"
                           StartIcon="@Icons.Material.Filled.Link"
                           Style="flex: 0 0 auto;">링크 복사</MudButton>
            </div>

            <MudDivider Class="mb-3" />

            @if (_pingLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_pingLogs.Count == 0)
            {
                <MudAlert Severity="Severity.Info">해당 기간에 온라인 상태 변경 이력이 없습니다.</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-2">@_pingLogs.Count 건 조회됨</MudText>
                <MudDataGrid Items="_pingLogs" Dense="true" Hover="true" Bordered="true"
                             SortMode="SortMode.Multiple" RowsPerPage="25">
                    <Columns>
                        <TemplateColumn Title="자산" SortBy="x => GetAssetName(x.DexaAssetId)">
                            <CellTemplate>
                                <MudLink Href="@($"/assets/{context.Item.DexaAssetId}")" Color="Color.Default" Underline="Underline.Hover">
                                    @GetAssetName(context.Item.DexaAssetId)
                                </MudLink>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="타입" SortBy="x => GetAssetType(x.DexaAssetId)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@GetAssetType(context.Item.DexaAssetId)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="라인" SortBy="x => GetAssetLine(x.DexaAssetId)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(GetAssetLine(context.Item.DexaAssetId) is var ln && ln != "" ? ln : "-")</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="IP" SortBy="x => GetAssetIp(x.DexaAssetId)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@GetAssetIp(context.Item.DexaAssetId)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="상태" SortBy="x => x.Reachable">
                            <CellTemplate>
                                @if (context.Item.Reachable)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Icon="@Icons.Material.Filled.Wifi"
                                             Style="font-weight:600; min-width:80px; justify-content:center;">온라인</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small"
                                             Variant="Variant.Filled"
                                             Icon="@Icons.Material.Filled.WifiOff"
                                             Style="font-weight:600; min-width:80px; justify-content:center;">오프라인</MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.CheckedAt" Title="변경 시각" Format="yyyy-MM-dd HH:mm:ss" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="TwmPingLog" PageSizeOptions="new[] { 25, 50, 100 }" />
                    </PagerContent>
                </MudDataGrid>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    // ─── 공통 ───
    private int _activeTab = 1; // 기본 탭: 백업 이력
    private bool _loading;

    // ─── URL 쿼리 파라미터 ───
    [SupplyParameterFromQuery(Name = "tab")]
    [Parameter] public int? QTab { get; set; }
    [SupplyParameterFromQuery(Name = "line")]
    [Parameter] public string? QLine { get; set; }
    [SupplyParameterFromQuery(Name = "type")]
    [Parameter] public string? QType { get; set; }
    [SupplyParameterFromQuery(Name = "period")]
    [Parameter] public string? QPeriod { get; set; }
    [SupplyParameterFromQuery(Name = "start")]
    [Parameter] public string? QStart { get; set; }
    [SupplyParameterFromQuery(Name = "end")]
    [Parameter] public string? QEnd { get; set; }
    [SupplyParameterFromQuery(Name = "q")]
    [Parameter] public string? QQ { get; set; }
    [SupplyParameterFromQuery(Name = "mode")]
    [Parameter] public string? QMode { get; set; }
    [SupplyParameterFromQuery(Name = "result")]
    [Parameter] public string? QResult { get; set; }
    [SupplyParameterFromQuery(Name = "pstatus")]
    [Parameter] public string? QPStatus { get; set; }
    [SupplyParameterFromQuery(Name = "health")]
    [Parameter] public string? QHealth { get; set; }

    // ─── 공유 검색 ───
    private string? _searchText;
    private string _searchMode = "contains";
    private string? _filterLine;

    // ─── 탭 1: 자산 정보 ───
    private List<AssetStatusInfo> _assetList = [];
    private List<string> _assetTypeNames = [];
    private List<string> _lineNames = [];
    private string? _filterAssetType;
    private string? _filterHealth;

    // 타입별 컬럼 가시성
    private bool ShowConnColumns => string.IsNullOrEmpty(_filterAssetType)
        || _filterAssetType == "XGT PLC" || _filterAssetType == "LS Servo" || _filterAssetType == "LS Drive";
    private bool ShowRobotColumn => string.IsNullOrEmpty(_filterAssetType)
        || _filterAssetType == "XGT PLC";
    private bool ShowModelVersion => string.IsNullOrEmpty(_filterAssetType)
        || _filterAssetType == "LS Drive";

    private IEnumerable<AssetStatusInfo> FilteredAssets
    {
        get
        {
            var q = _assetList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                var search = _searchText.Trim();
                q = _searchMode switch
                {
                    "exact" => q.Where(a =>
                        (a.Name?.Equals(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (a.Ip?.Equals(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (a.Description?.Split(' ').Any(w => w.Equals(search, StringComparison.OrdinalIgnoreCase)) ?? false)),
                    "exclude" => q.Where(a =>
                        !(a.Name?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) &&
                        !(a.Ip?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) &&
                        !(a.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)),
                    _ => q.Where(a =>
                        (a.Name?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (a.Ip?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (a.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)),
                };
            }

            if (!string.IsNullOrEmpty(_filterAssetType))
                q = q.Where(a => a.AssetTypeName == _filterAssetType);

            if (!string.IsNullOrEmpty(_filterLine))
                q = q.Where(a => a.LayoutLineName == _filterLine);

            if (!string.IsNullOrEmpty(_filterHealth))
            {
                var h = _filterHealth switch
                {
                    "backedup" => AssetHealthStatus.BackedUp,
                    "unchanged" => AssetHealthStatus.Unchanged,
                    "failed" => AssetHealthStatus.Failed,
                    "inprogress" => AssetHealthStatus.InProgress,
                    "unknown" => AssetHealthStatus.Unknown,
                    _ => (AssetHealthStatus?)null
                };
                if (h.HasValue)
                    q = q.Where(a => a.Health == h.Value);
            }

            return q;
        }
    }

    // ─── 탭 2: 백업 이력 ───
    private List<DexaAction> _allActions = [];
    private List<DexaAction> _actions = [];
    private Dictionary<int, string> _assetNames = [];
    private Dictionary<int, string> _assetTypes = [];
    private Dictionary<int, string> _assetLines = [];
    private string? _historyError;
    private string _periodLabel = "today";
    private string? _selectedResult;
    private DateTime _startDate = DateTime.Today;
    private DateTime _endDate = DateTime.Today;

    // ─── 탭 3: 통신 이력 ───
    private List<TwmPingLog> _allPingLogs = [];
    private List<TwmPingLog> _pingLogs = [];
    private Dictionary<int, string> _assetIps = [];
    private bool _pingLoading;
    private string? _pingStatusFilter;

    // ─── 라이프사이클 ───
    protected override async Task OnInitializedAsync()
    {
        // URL 쿼리에서 상태 복원
        _activeTab = QTab ?? 1;
        _filterLine = string.IsNullOrEmpty(QLine) ? null : QLine;
        _filterAssetType = string.IsNullOrEmpty(QType) ? null : QType;
        if (!string.IsNullOrEmpty(QPeriod))
            _periodLabel = QPeriod;
        if (DateTime.TryParse(QStart, out var s)) _startDate = s;
        if (DateTime.TryParse(QEnd, out var e)) _endDate = e;
        if (!string.IsNullOrEmpty(QQ)) _searchText = QQ;
        if (!string.IsNullOrEmpty(QMode)) _searchMode = QMode;
        if (!string.IsNullOrEmpty(QResult)) _selectedResult = QResult;
        if (!string.IsNullOrEmpty(QPStatus)) _pingStatusFilter = QPStatus;
        if (!string.IsNullOrEmpty(QHealth)) _filterHealth = QHealth;

        NotificationService.OnDatabaseChanged += HandleDatabaseChanged;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var assetsTask = DexaRead.GetViewAssetsAsync();
            var actionsTask = DexaRead.GetAllActionsAsync();
            var statusTask = AssetStatus.GetAssetStatusesAsync();
            await Task.WhenAll(assetsTask, actionsTask, statusTask);

            // 백업 이력 데이터
            var assets = await assetsTask;
            _assetNames = assets.ToDictionary(a => a.AssetId, a => a.DisplayName);
            _assetTypes = assets.ToDictionary(a => a.AssetId, a => a.AssetTypeUserFriendlyName ?? "");
            _assetIps = assets.ToDictionary(a => a.AssetId, a => a.Ip ?? "");
            // 라인 맵은 statusTask 이후에 구성
            _allActions = await actionsTask;
            FilterActions();

            // 자산 정보 데이터
            _assetList = await statusTask;
            _assetLines = _assetList
                .Where(a => !string.IsNullOrEmpty(a.LayoutLineName))
                .ToDictionary(a => a.AssetId, a => a.LayoutLineName!);
            _assetTypeNames = _assetList
                .Select(a => a.AssetTypeName)
                .Where(t => !string.IsNullOrEmpty(t))
                .Distinct()
                .OrderBy(t => t)
                .ToList()!;
            _lineNames = _assetList
                .Select(a => a.LayoutLineName)
                .Where(l => !string.IsNullOrEmpty(l))
                .Distinct()
                .OrderBy(l => l)
                .ToList()!;

            // 통신 이력 로드
            await LoadPingLogsAsync();
        }
        catch (Exception ex)
        {
            _historyError = $"데이터 조회 실패: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async void HandleDatabaseChanged(string tableName)
    {
        if (tableName is "action" or "actionlog" or "asset" or "*")
        {
            await InvokeAsync(async () =>
            {
                await LoadDataAsync();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        NotificationService.OnDatabaseChanged -= HandleDatabaseChanged;
    }

    // ─── URL 상태 관리 ───
    private void UpdateUrl()
    {
        var query = new Dictionary<string, object?>();
        if (_activeTab != 1) query["tab"] = _activeTab.ToString();
        if (!string.IsNullOrEmpty(_filterLine)) query["line"] = _filterLine;
        if (!string.IsNullOrEmpty(_filterAssetType)) query["type"] = _filterAssetType;
        if (_periodLabel != "today") query["period"] = _periodLabel;
        if (_startDate != DateTime.Today) query["start"] = _startDate.ToString("yyyy-MM-dd");
        if (_endDate != DateTime.Today) query["end"] = _endDate.ToString("yyyy-MM-dd");
        if (!string.IsNullOrEmpty(_searchText)) query["q"] = _searchText;
        if (_searchMode != "contains") query["mode"] = _searchMode;
        if (!string.IsNullOrEmpty(_selectedResult)) query["result"] = _selectedResult;
        if (!string.IsNullOrEmpty(_pingStatusFilter)) query["pstatus"] = _pingStatusFilter;
        if (!string.IsNullOrEmpty(_filterHealth)) query["health"] = _filterHealth;

        var uri = Navigation.GetUriWithQueryParameters("/history", query);
        Navigation.NavigateTo(uri, replace: true);
    }

    private void OnTabChanged(int index)
    {
        _activeTab = index;
        UpdateUrl();
    }

    private async Task CopyLink()
    {
        UpdateUrl();
        var url = Navigation.Uri;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
    }

    // ─── 탭 1: 자산 필터 핸들러 ───
    private void OnAssetTypeChanged(ChangeEventArgs e)
    {
        _filterAssetType = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        UpdateUrl();
    }

    private void OnLineChanged(ChangeEventArgs e)
    {
        _filterLine = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        FilterActions();
        FilterPingLogs();
        UpdateUrl();
    }

    private void OnHealthChanged(ChangeEventArgs e)
    {
        _filterHealth = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        UpdateUrl();
    }

    // ─── 탭 1: 자산 CSV ───
    private async Task ExportAssetCsv()
    {
        var sb = new StringBuilder();
        // 헤더 구성 (보이는 컬럼만)
        var headers = new List<string> { "자산명", "타입", "라인", "벤더", "스펙", "설명" };
        if (ShowConnColumns) headers.Add("ViaIP");
        headers.Add("IP");
        if (ShowConnColumns) { headers.Add("Base"); headers.Add("Slot"); }
        headers.Add("스테이션");
        if (ShowModelVersion) headers.Add("모델버전");
        if (ShowRobotColumn) headers.Add("로봇PLC");
        headers.Add("상태");
        headers.Add("마지막 백업");
        sb.AppendLine("\uFEFF" + string.Join(",", headers));

        foreach (var a in FilteredAssets)
        {
            var cols = new List<string>
            {
                EscapeCsv(a.Name ?? ""),
                EscapeCsv(a.AssetTypeName ?? ""),
                EscapeCsv(a.LayoutLineName ?? ""),
                EscapeCsv(a.AugVendor ?? ""),
                EscapeCsv(a.AugSpec ?? ""),
                EscapeCsv(a.Description ?? ""),
            };
            if (ShowConnColumns) cols.Add(EscapeCsv(a.AugIpVia ?? ""));
            cols.Add(EscapeCsv(a.Ip ?? ""));
            if (ShowConnColumns)
            {
                cols.Add(a.AugBaseNumber?.ToString() ?? "");
                cols.Add(a.AugSlotNumber?.ToString() ?? "");
            }
            cols.Add(a.AugStationNumber?.ToString() ?? "");
            if (ShowModelVersion) cols.Add(EscapeCsv(a.ModelVersion ?? ""));
            if (ShowRobotColumn) cols.Add(a.AugIsRobotPLC == 1 ? "Y" : "");
            cols.Add(GetHealthLabel(a.Health));
            cols.Add(a.LastBackupTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "");
            sb.AppendLine(string.Join(",", cols));
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"자산정보_{DateTime.Today:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("eval",
            $"((d,n)=>{{const b=atob(d),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);const u=URL.createObjectURL(new Blob([a],{{type:'text/csv'}})),l=document.createElement('a');l.href=u;l.download=n;l.click();URL.revokeObjectURL(u)}})('{base64}','{fileName}')");
    }

    private static string GetHealthLabel(AssetHealthStatus health) => health switch
    {
        AssetHealthStatus.BackedUp => "백업 갱신",
        AssetHealthStatus.Unchanged => "변경 없음",
        AssetHealthStatus.Failed => "작업 실패",
        AssetHealthStatus.InProgress => "작업중",
        _ => "내역 없음",
    };

    // ─── 탭 2: 백업 이력 로직 (기존) ───
    private string GetAssetName(int assetId)
        => _assetNames.TryGetValue(assetId, out var name) ? name : $"#{assetId}";

    private string GetAssetType(int assetId)
        => _assetTypes.TryGetValue(assetId, out var t) ? t : "";

    private string GetAssetIp(int assetId)
        => _assetIps.TryGetValue(assetId, out var ip) ? ip : "";

    private string GetAssetLine(int assetId)
        => _assetLines.TryGetValue(assetId, out var line) ? line : "";

    private async Task SetPeriod(int days)
    {
        _periodLabel = days switch { 0 => "today", 7 => "7days", 30 => "30days", _ => "" };
        _startDate = days == 0 ? DateTime.Today : DateTime.Today.AddDays(-(days - 1));
        _endDate = DateTime.Today;
        FilterActions();
        await LoadPingLogsAsync();
        UpdateUrl();
    }

    private async Task OnDateManualChange()
    {
        _periodLabel = "";
        FilterActions();
        await LoadPingLogsAsync();
        UpdateUrl();
    }

    private static bool IsInProgress(DexaAction a)
        => a.Finished == null && string.IsNullOrEmpty(a.Memo)
            && (!a.Started.HasValue || (DateTime.Now - a.Started.Value).TotalHours < 5);

    private static bool IsStaleIncomplete(DexaAction a)
        => a.Finished == null && string.IsNullOrEmpty(a.Memo)
            && a.Started.HasValue && (DateTime.Now - a.Started.Value).TotalHours >= 5;

    private bool IsNewUpdate(DexaAction a)
        => a.Memo?.ToLower() == "true" && a.ContentsChanged == true;

    private Color GetResultColor(DexaAction a)
        => IsInProgress(a) ? Color.Warning
         : a.Memo?.ToLower() != "true" ? Color.Error
         : a.ContentsChanged == true ? Color.Success
         : Color.Info;

    private string? GetDownloadBadgeLabel(DexaAction a)
        => IsInProgress(a) ? null
         : a.Memo?.ToLower() != "true" ? "이전 버전"
         : a.ContentsChanged == true ? "새 버전"
         : "버전 유지";

    private string GetResultLabel(DexaAction a)
        => IsInProgress(a) ? "작업중"
         : a.Memo?.ToLower() != "true" ? "작업 실패"
         : a.ContentsChanged == true ? "백업 갱신"
         : "변경 없음";

    private void OnResultSelectChanged(ChangeEventArgs e)
    {
        _selectedResult = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        FilterActions();
        UpdateUrl();
    }

    private void OnHistoryLineChanged(ChangeEventArgs e)
    {
        _filterLine = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        FilterActions();
        FilterPingLogs();
        UpdateUrl();
    }

    private void SetSearchMode(string mode)
    {
        _searchMode = mode;
        FilterActions();
        FilterPingLogs();
        UpdateUrl();
    }

    private void OnSearchTextChanged()
    {
        FilterActions();
        FilterPingLogs();
        UpdateUrl();
    }

    private string GetSearchableText(DexaAction a)
        => string.Join(" ",
            GetAssetName(a.AssetId),
            GetAssetType(a.AssetId),
            a.Version.ToString(),
            a.Started?.ToString("yyyy-MM-dd HH:mm:ss") ?? "",
            a.Finished?.ToString("yyyy-MM-dd HH:mm:ss") ?? "",
            GetResultLabel(a));

    private void FilterActions()
    {
        var query = _allActions
            .Where(a => a.Started >= _startDate && a.Started < _endDate.AddDays(1));

        if (!string.IsNullOrEmpty(_selectedResult))
            query = query.Where(a => GetResultLabel(a) == _selectedResult);

        if (!string.IsNullOrEmpty(_filterLine))
            query = query.Where(a => GetAssetLine(a.AssetId) == _filterLine);

        if (!string.IsNullOrEmpty(_searchText))
        {
            var term = _searchText.Trim();
            query = _searchMode switch
            {
                "exact" => query.Where(a => GetSearchableText(a)
                    .Split(' ').Any(w => w.Equals(term, StringComparison.OrdinalIgnoreCase))),
                "exclude" => query.Where(a => !GetSearchableText(a)
                    .Contains(term, StringComparison.OrdinalIgnoreCase)),
                _ => query.Where(a => GetSearchableText(a)
                    .Contains(term, StringComparison.OrdinalIgnoreCase)),
            };
        }

        _actions = query.ToList();
        _historyError = _actions.Count == 0 ? "해당 기간에 이력 데이터가 없습니다." : null;
    }

    private async Task DownloadBackup(DexaAction action)
    {
        if (action.Version == null) return;
        var url = $"/api/download/backup/{action.AssetId}/{action.Version}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task OpenReport(DexaAction action)
    {
        var url = $"/report/{action.AssetId}/{action.Version}/index.html";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task ExportCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("\uFEFF자산,타입,라인,버전,작업 시작,작업 종료,결과");
        foreach (var a in _actions)
        {
            var name = EscapeCsv(GetAssetName(a.AssetId));
            var type = EscapeCsv(GetAssetType(a.AssetId));
            var line = EscapeCsv(GetAssetLine(a.AssetId));
            var ver = a.Version?.ToString() ?? "";
            var started = a.Started?.ToString("yyyy-MM-dd HH:mm:ss") ?? "";
            var finished = a.Finished?.ToString("yyyy-MM-dd HH:mm:ss") ?? "";
            var result = GetResultLabel(a);
            sb.AppendLine($"{name},{type},{line},{ver},{started},{finished},{result}");
        }
        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"백업이력_{_startDate:yyyyMMdd}_{_endDate:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("eval",
            $"((d,n)=>{{const b=atob(d),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);const u=URL.createObjectURL(new Blob([a],{{type:'text/csv'}})),l=document.createElement('a');l.href=u;l.download=n;l.click();URL.revokeObjectURL(u)}})('{base64}','{fileName}')");
    }

    // ─── 탭 3: 통신 이력 로직 ───
    private async Task LoadPingLogsAsync()
    {
        _pingLoading = true;
        try
        {
            _allPingLogs = await TwmDb.GetPingLogsAsync(_startDate, _endDate);
            FilterPingLogs();
        }
        finally
        {
            _pingLoading = false;
        }
    }

    private void FilterPingLogs()
    {
        var query = _allPingLogs.AsEnumerable();

        if (!string.IsNullOrEmpty(_pingStatusFilter))
        {
            var reachable = _pingStatusFilter == "online";
            query = query.Where(x => x.Reachable == reachable);
        }

        if (!string.IsNullOrEmpty(_filterLine))
            query = query.Where(x => GetAssetLine(x.DexaAssetId) == _filterLine);

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            query = _searchMode switch
            {
                "exact" => query.Where(x =>
                    GetAssetName(x.DexaAssetId).Equals(term, StringComparison.OrdinalIgnoreCase) ||
                    GetAssetIp(x.DexaAssetId).Equals(term, StringComparison.OrdinalIgnoreCase)),
                "exclude" => query.Where(x =>
                    !GetAssetName(x.DexaAssetId).Contains(term, StringComparison.OrdinalIgnoreCase) &&
                    !GetAssetIp(x.DexaAssetId).Contains(term, StringComparison.OrdinalIgnoreCase)),
                _ => query.Where(x =>
                    GetAssetName(x.DexaAssetId).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    GetAssetIp(x.DexaAssetId).Contains(term, StringComparison.OrdinalIgnoreCase)),
            };
        }

        _pingLogs = query.ToList();
    }

    private void OnPingStatusChanged(ChangeEventArgs e)
    {
        _pingStatusFilter = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();
        FilterPingLogs();
        UpdateUrl();
    }


    private async Task ExportPingCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("\uFEFF자산,타입,라인,IP,상태,변경 시각");
        foreach (var p in _pingLogs)
        {
            var name = EscapeCsv(GetAssetName(p.DexaAssetId));
            var type = EscapeCsv(GetAssetType(p.DexaAssetId));
            var line = EscapeCsv(GetAssetLine(p.DexaAssetId));
            var ip = EscapeCsv(GetAssetIp(p.DexaAssetId));
            var status = p.Reachable ? "온라인" : "오프라인";
            var time = p.CheckedAt.ToString("yyyy-MM-dd HH:mm:ss");
            sb.AppendLine($"{name},{type},{line},{ip},{status},{time}");
        }
        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"온라인이력_{_startDate:yyyyMMdd}_{_endDate:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("eval",
            $"((d,n)=>{{const b=atob(d),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);const u=URL.createObjectURL(new Blob([a],{{type:'text/csv'}})),l=document.createElement('a');l.href=u;l.download=n;l.click();URL.revokeObjectURL(u)}})('{base64}','{fileName}')");
    }

    private static string EscapeCsv(string value)
        => value.Contains(',') || value.Contains('"') || value.Contains('\n')
            ? $"\"{value.Replace("\"", "\"\"")}\"" : value;

    private async Task ShowLogs(DexaAction action)
    {
        var parameters = new DialogParameters<BackupLog>
        {
            { x => x.ActionId, action.Id },
            { x => x.AssetId, action.AssetId }
        };

        await DialogService.ShowAsync<BackupLog>(
            $"액션 #{action.Id} 로그",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }
