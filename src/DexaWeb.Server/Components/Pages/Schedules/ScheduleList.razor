@page "/schedules"
@inject ScheduleService ScheduleService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>TWM - 스케줄 관리</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">스케줄 관리</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h6">트리거 목록</MudText>
        <MudSpacer />
        <AuthorizeView>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog">
                트리거 추가
            </MudButton>
        </AuthorizeView>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadTriggers">
            새로고침
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudDataGrid Items="_triggers" Dense="true" Hover="true" Bordered="true">
            <Columns>
                <PropertyColumn Property="x => x.Id" Title="ID" />
                <PropertyColumn Property="x => x.Name" Title="이름" />
                <PropertyColumn Property="x => x.CronExpression" Title="Cron" />
                <TemplateColumn Title="상태">
                    <CellTemplate>
                        @if (context.Item.Enabled)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">활성</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">비활성</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Description" Title="설명" />
                <TemplateColumn Title="작업">
                    <CellTemplate>
                        <AuthorizeView Context="auth">
                            <Authorized>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                                                   Size="Size.Small" Color="Color.Success"
                                                   OnClick="() => ExecuteTrigger(context.Item)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small" Color="Color.Error"
                                                   OnClick="() => DeleteTrigger(context.Item)" />
                                </MudStack>
                            </Authorized>
                        </AuthorizeView>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }
</MudPaper>

@code {
    private List<Trigger> _triggers = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await LoadTriggers();
    }

    private async Task LoadTriggers()
    {
        _loading = true;
        _triggers = await ScheduleService.GetTriggersAsync();
        _loading = false;
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters<TriggerEditor>();
        var dialog = await DialogService.ShowAsync<TriggerEditor>("트리거 추가", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadTriggers();
            Snackbar.Add("트리거가 추가되었습니다.", Severity.Success);
        }
    }

    private async Task ExecuteTrigger(Trigger trigger)
    {
        var ok = await ScheduleService.ExecuteTriggerAsync(trigger.Id);
        if (ok)
            Snackbar.Add($"트리거 '{trigger.Name}' 실행 요청됨", Severity.Success);
        else
            Snackbar.Add("트리거 실행 실패", Severity.Error);
    }

    private async Task DeleteTrigger(Trigger trigger)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"트리거 '{trigger.Name}'을(를) 삭제하시겠습니까?" },
            { x => x.ButtonText, "삭제" },
            { x => x.ButtonColor, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("삭제 확인", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            var ok = await ScheduleService.DeleteTriggerAsync(trigger.Id);
            if (ok)
            {
                await LoadTriggers();
                Snackbar.Add("트리거가 삭제되었습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add("트리거 삭제 실패", Severity.Error);
            }
        }
    }
}
