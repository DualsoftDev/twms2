<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Twms2.Dexa</RootNamespace>
    <AssemblyName>Twms2.Dexa</AssemblyName>

	<NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Utilities/EmDns.fs" />
    <Compile Include="Utilities/ActorErrors.fs" />
    <Compile Include="Models/NullableDateTimeHandler.fs" />
    <Compile Include="Models/ActorBase.fs" />
    <Compile Include="Models/User.fs" />
    <Compile Include="Models/AssetType.fs" />
    <Compile Include="Models/ProjectFile.fs" />
    <Compile Include="Models/Asset.fs" />
    <Compile Include="Models/ViewAsset.fs" />
    <Compile Include="Models/Trigger.fs" />
    <Compile Include="Models/Schedule.fs" />
    <Compile Include="Models/Permission.fs" />
    <Compile Include="Models/Action.fs" />
    <Compile Include="Models/ActionLog.fs" />
    <Compile Include="Models/Agent.fs" />
    <Compile Include="Models/DeepPingError.fs" />
    <Compile Include="Models/Storage.fs" />
    <Compile Include="Models/AssetStatus.fs" />
    <Compile Include="Models/Client.fs" />
    <Compile Include="Models/BackupLog.fs" />
    <Compile Include="Messages/DEXActorGlobal.fs" />
    <Compile Include="Messages/ActorType.fs" />
    <Compile Include="Messages/Base/ActorMessage.fs" />
    <Compile Include="Messages/Base/AmReply.fs" />
    <Compile Include="Messages/Base/AmReplyError.fs" />
    <Compile Include="Messages/Locker.fs" />
    <Compile Include="Messages/ActorInfo.fs" />
    <Compile Include="Messages/HardwarePerformance.fs" />
    <Compile Include="Messages/AgentInfo.fs" />
    <Compile Include="Messages/AmC2STrigger.fs" />
    <Compile Include="Messages/AmExecuteBackup.fs" />
    <Compile Include="Messages/Notifications.fs" />
    <Compile Include="Messages/C2SMessages.fs" />
    <Compile Include="Messages/A2SMessages.fs" />
    <Compile Include="Messages/S2CMessages.fs" />
    <Compile Include="DexaClientOptions.fs" />
    <Compile Include="DexaPortPatch.fs" />
    <Compile Include="IDexaClient.fs" />
    <Compile Include="DexaDirectClient.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- DEXA 설치 경로의 Akka 1.4.24 + DEXA DLL 직접 참조 -->
    <Reference Include="Akka">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\Akka.dll</HintPath>
    </Reference>
    <Reference Include="Akka.Remote">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\Akka.Remote.dll</HintPath>
    </Reference>
    <Reference Include="DEXA.Client">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DEXA.Client.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DEXA.Common">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DEXA.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DEXA.Common.Akka">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DEXA.Common.Akka.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- DEXA.Common.Core 제거: KeyValueConfigurationCollection 의존성 문제.
         DEX.Common.Core 타입은 F#에서 직접 정의 (HardwarePerformance.fs 등) -->
    <Reference Include="DEXA.Core.Actor">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DEXA.Core.Actor.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DEXA.Core.Database">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DEXA.Core.Database.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DEXA.Interfaces">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DEXA.Interfaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DEXA.Storage">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DEXA.Storage.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Hocon">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\Hocon.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DotNetty.Buffers">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DotNetty.Buffers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DotNetty.Codecs">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DotNetty.Codecs.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DotNetty.Common">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DotNetty.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DotNetty.Handlers">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DotNetty.Handlers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DotNetty.Transport">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\DotNetty.Transport.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>C:\Program Files (x86)\LS\DEXA\Client\Google.Protobuf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- DEXA DLL의 하드코딩 포트(50011) 런타임 패치용 (DexaPortPatch.fs) -->
    <PackageReference Include="Lib.Harmony" Version="2.*" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.*" />
    <PackageReference Include="System.Reactive" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
    <PackageReference Include="Dapper" Version="2.*" />
  </ItemGroup>

</Project>
