@inject DexaFileImportService DexaImportService
@inject TwmDbService TwmDb
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog Style="max-width: 800px;">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.FileUpload" />
            <MudText Typo="Typo.h6">이전 TWMS 레이아웃 가져오기</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            이전 버전 TWMS의 DEXA.sqlite3에서 라인 배치·자산 좌표·그룹 정보를 현재 도면(<b>@LayoutName</b>)에 가져옵니다.
            레이아웃 테이블(layoutLine, layoutGroup)이 없는 새 버전 DEXA 파일은 지원하지 않습니다.
        </MudText>

        @* ── Step 1: 파일 선택 + 미리보기 ── *@
        <InputFile id="dexa-dialog-import-input" OnChange="OnPositionFileSelected"
                   accept=".sqlite3,.sqlite,.db"
                   style="display:none;" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AttachFile"
                       OnClick="@(() => JS.InvokeVoidAsync("eval", "document.getElementById('dexa-dialog-import-input').click()"))">
                파일 선택
            </MudButton>
            @if (_posImportFile != null)
            {
                <MudChip T="string" Color="Color.Info" Size="Size.Small">@_posImportFileName</MudChip>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Preview"
                       OnClick="PreviewLinesAsync"
                       Disabled="@(_posImportFile == null || _importing)">
                @(_importing && _previewLines == null ? "읽는 중..." : "미리보기")
            </MudButton>
        </MudStack>

        @* ── Step 2: 라인 선택 ── *@
        @if (_previewLines != null && _previewLines.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                선택한 라인의 라인 영역·자산 배치·그룹이 현재 도면에 덮어쓰기됩니다.
            </MudAlert>

            <MudSelect T="int?" @bind-Value="_refLineId" Label="기준 도면 라인 (좌표 공간)"
                       Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-3"
                       HelperText="모든 자산 좌표의 기준이 되는 배경 도면 라인을 선택하세요.">
                @foreach (var line in _previewLines)
                {
                    <MudSelectItem T="int?" Value="@((int?)line.Id)">
                        @line.Name (@($"{line.SelfW:F0}×{line.SelfH:F0}"))
                    </MudSelectItem>
                }
            </MudSelect>

            <MudStack Row="true" Spacing="2" Class="mb-2">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">배치할 라인</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.SelectAll"
                           OnClick="SelectAllLines">
                    전체 선택
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                           OnClick="DeselectAllLines">
                    전체 해제
                </MudButton>
            </MudStack>

            <MudTable Items="_previewLines" Dense="true" Hover="true" Class="mb-4"
                      Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <HeaderContent>
                    <MudTh Style="width: 60px;">선택</MudTh>
                    <MudTh>DEXA 라인</MudTh>
                    <MudTh>도면 크기</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudCheckBox T="bool" Value="_lineSelections[context.Id]"
                                     ValueChanged="@(v => _lineSelections[context.Id] = v)"
                                     Dense="true" />
                    </MudTd>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@($"{context.SelfW:F0} × {context.SelfH:F0}")</MudTd>
                </RowTemplate>
            </MudTable>
        }

        @* ── 결과 표시 ── *@
        @if (_importResult != null)
        {
            <MudAlert Severity="@(_importResult.HasFatalError ? Severity.Error : Severity.Success)"
                      Variant="Variant.Outlined">
                @if (_importResult.HasFatalError)
                {
                    <span>오류: @_importResult.FatalError</span>
                }
                else
                {
                    <span>
                        자산 배치 <b>@_importResult.AssetPositionsImported</b>개,
                        그룹 <b>@_importResult.GroupsImported</b>개 가져옴
                        @if (_importResult.Skipped > 0)
                        {
                            <span> (건너뜀: @_importResult.Skipped)</span>
                        }
                    </span>
                }
            </MudAlert>
        }

        @if (_importing)
        {
            <MudStack AlignItems="AlignItems.Center" Class="my-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.body2">가져오는 중...</MudText>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @if (_importResult != null && !_importResult.HasFatalError)
        {
            <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">닫기</MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">취소</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="RunImportAsync"
                       Disabled="@(_importing || _previewLines == null || !_lineSelections.Values.Any(v => v))">
                가져오기
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int LayoutId { get; set; }
    [Parameter] public string? LayoutName { get; set; }

    private IBrowserFile? _posImportFile;
    private string? _posImportFileName;
    private string? _posTempPath;
    private bool _importing;
    private List<DexaLinePreview>? _previewLines;
    private Dictionary<int, bool> _lineSelections = new();
    private int? _refLineId;
    private DexaPositionImportResult? _importResult;

    private void OnPositionFileSelected(InputFileChangeEventArgs e)
    {
        _posImportFile = e.File;
        _posImportFileName = e.File.Name;
        _previewLines = null;
        _lineSelections.Clear();
        _importResult = null;
        CleanupTempFile();
    }

    private async Task PreviewLinesAsync()
    {
        if (_posImportFile == null) return;
        _importing = true;
        _previewLines = null;
        _importResult = null;
        CleanupTempFile();

        try
        {
            _posTempPath = Path.Combine(Path.GetTempPath(), $"dexa_pos_{Guid.NewGuid():N}.sqlite3");
            await using var fs = File.Create(_posTempPath);
            await _posImportFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024).CopyToAsync(fs);
            fs.Close();

            _previewLines = await DexaImportService.PreviewLinesFromFileAsync(_posTempPath);
            _lineSelections = _previewLines.ToDictionary(l => l.Id, _ => true);

            // 기준 도면 라인 자동 감지
            _refLineId = null;
            if (_previewLines.Count > 0)
            {
                var config = await TwmDb.GetBlueprintConfigAsync(LayoutId);
                if (config?.ImageWidth is > 0 && config?.ImageHeight is > 0)
                {
                    var imgRatio = config.ImageWidth.Value / config.ImageHeight.Value;
                    _refLineId = _previewLines
                        .OrderBy(l => Math.Abs(l.SelfW / l.SelfH - imgRatio))
                        .First().Id;
                }
                else
                {
                    _refLineId = _previewLines.OrderBy(l => l.SelfW).First().Id;
                }
            }

            if (_previewLines.Count == 0)
                Snackbar.Add("DEXA 파일에 레이아웃 라인 정보가 없습니다. 구 TWMS용 DEXA 파일인지 확인하세요.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"미리보기 오류: {ex.Message}", Severity.Error);
            CleanupTempFile();
        }
        finally
        {
            _importing = false;
        }
    }

    private void SelectAllLines()
    {
        foreach (var key in _lineSelections.Keys.ToList())
            _lineSelections[key] = true;
    }

    private void DeselectAllLines()
    {
        foreach (var key in _lineSelections.Keys.ToList())
            _lineSelections[key] = false;
    }

    private async Task RunImportAsync()
    {
        if (_posTempPath == null || _previewLines == null) return;

        var map = _lineSelections
            .Where(kv => kv.Value)
            .ToDictionary(kv => kv.Key, _ => LayoutId);
        if (map.Count == 0) return;

        _importing = true;
        _importResult = null;

        try
        {
            _importResult = await DexaImportService.ImportPositionsFromFileAsync(_posTempPath, map, _refLineId);

            if (_importResult.HasFatalError)
                Snackbar.Add($"좌표 가져오기 실패: {_importResult.FatalError}", Severity.Error);
            else
                Snackbar.Add(
                    $"완료 — 자산 {_importResult.AssetPositionsImported}개, 그룹 {_importResult.GroupsImported}개",
                    Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            CleanupTempFile();
            _importing = false;
        }
    }

    private void CleanupTempFile()
    {
        if (_posTempPath != null)
        {
            try { if (File.Exists(_posTempPath)) File.Delete(_posTempPath); } catch { }
            _posTempPath = null;
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() { CleanupTempFile(); MudDialog.Cancel(); }
}
