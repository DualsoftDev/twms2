@using static Twms2.Server.Helpers.LayoutHelpers
@using Twms2.Server.Models.Dashboard
@using Twms2.Server.Models.Twm
@using System.Text.Json
@inject NavigationManager Nav

@if (Lines.Count == 0)
{
    <MudPaper Class="pa-8" Elevation="2">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.ViewModule" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Color="Color.Secondary">등록된 라인이 없습니다</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                관리 > 라인 설정에서 라인을 먼저 등록해 주세요.
            </MudText>
        </MudStack>
    </MudPaper>
}
else
{
    @* ── 범례 ── *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.Center">
            @foreach (var (label, color) in _legendItems)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <div class="topology-legend-dot" style="background: @color;"></div>
                    <MudText Typo="Typo.body2">@label</MudText>
                </MudStack>
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div class="topology-legend-dot" style="background: var(--mud-palette-success);"></div>
                <MudText Typo="Typo.body2">온라인</MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div class="topology-legend-dot" style="background: var(--mud-palette-error);"></div>
                <MudText Typo="Typo.body2">오프라인</MudText>
            </MudStack>
            <MudSpacer />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @Lines.Count 개 라인 · @AssetStatuses.Count 개 자산
            </MudText>
        </MudStack>
    </MudPaper>

    @foreach (var line in Lines)
    {
        var lineAssets = AssetStatuses.Where(a => a.AugLineId == line.Id).ToList();
        var lineGroups = GetGroupsForLine(line.Id, lineAssets);
        var assignedIds = new HashSet<int>(lineGroups.SelectMany(g => g.AssetIds));
        var ungrouped = lineAssets.Where(a => !assignedIds.Contains(a.AssetId)).ToList();
        var lineHealthColor = AggregateHealthColor(lineAssets);

        <MudPaper Class="pa-4 mb-4" Elevation="2">
            @* ── 라인 헤더 ── *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <div style="width: 4px; height: 24px; border-radius: 2px; background: @lineHealthColor;"></div>
                <MudIcon Icon="@Icons.Material.Filled.LinearScale" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Style="font-weight: 600;">@line.Name</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                    @lineAssets.Count 자산
                </MudChip>
                <MudSpacer />
            </MudStack>

            @* ── 그룹(함)별 표시 ── *@
            @foreach (var grp in lineGroups)
            {
                <div class="layout-group-container mb-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small"
                                 Color="Color.Secondary" />
                        <MudText Typo="Typo.subtitle2" Class="layout-group-title">
                            함 @grp.GroupId @(grp.Floor.HasValue ? $"({grp.Floor}F)" : "")
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                            @grp.Members.Count 자산
                        </MudChip>
                    </MudStack>
                    <div class="layout-asset-grid">
                        @foreach (var asset in grp.Members)
                        {
                            <div class="layout-asset-card" @onclick="() => NavigateToAsset(asset.AssetId)">
                                <div class="d-flex align-center gap-2 mb-1">
                                    <img src="@GetAssetIcon(asset.AssetTypeName)" class="asset-type-icon-sm" />
                                    <span class="layout-asset-name">@asset.Name</span>
                                    <MudSpacer />
                                    @if (asset.LatestPing != null)
                                    {
                                        <span class="layout-ping-dot"
                                              style="background: var(--mud-palette-@(asset.LatestPing.Reachable ? "success" : "error"));">
                                        </span>
                                    }
                                </div>
                                <div class="d-flex align-center gap-2">
                                    @if (!string.IsNullOrEmpty(asset.Ip))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@asset.Ip</MudText>
                                    }
                                    <MudSpacer />
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                             Color="@GetHealthChipColor(asset.Health)"
                                             Style="height: 20px; font-size: 0.7rem;">
                                        @GetHealthLabelShort(asset.Health)
                                    </MudChip>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ── 미배정 자산 ── *@
            @if (ungrouped.Count > 0)
            {
                @if (lineGroups.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Secondary">
                        <MudIcon Icon="@Icons.Material.Filled.DevicesOther" Size="Size.Small" Class="mr-1" />
                        미배정 자산
                    </MudText>
                }
                <div class="layout-asset-grid">
                    @foreach (var asset in ungrouped)
                    {
                        <div class="layout-asset-card" @onclick="() => NavigateToAsset(asset.AssetId)">
                            <div class="d-flex align-center gap-2 mb-1">
                                <img src="@GetAssetIcon(asset.AssetTypeName)" class="asset-type-icon-sm" />
                                <span class="layout-asset-name">@asset.Name</span>
                                <MudSpacer />
                                @if (asset.LatestPing != null)
                                {
                                    <span class="layout-ping-dot"
                                          style="background: var(--mud-palette-@(asset.LatestPing.Reachable ? "success" : "error"));">
                                    </span>
                                }
                            </div>
                            <div class="d-flex align-center gap-2">
                                @if (!string.IsNullOrEmpty(asset.Ip))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@asset.Ip</MudText>
                                }
                                <MudSpacer />
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                         Color="@GetHealthChipColor(asset.Health)"
                                         Style="height: 20px; font-size: 0.7rem;">
                                    @GetHealthLabelShort(asset.Health)
                                </MudChip>
                            </div>
                        </div>
                    }
                </div>
            }

            @* 라인에 자산이 없을 때 *@
            @if (lineAssets.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="py-4">
                    이 라인에 배정된 자산이 없습니다.
                </MudText>
            }
        </MudPaper>
    }

    @* ── 미배정 라인 자산 ── *@
    @if (GetUnassignedAssets() is { Count: > 0 } noLineAssets)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <div style="width: 4px; height: 24px; border-radius: 2px; background: #999;"></div>
                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Style="font-weight: 600;" Color="Color.Secondary">미배정</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                    @noLineAssets.Count 자산
                </MudChip>
            </MudStack>
            <div class="layout-asset-grid">
                @foreach (var asset in noLineAssets)
                {
                    <div class="layout-asset-card" @onclick="() => NavigateToAsset(asset.AssetId)">
                        <div class="d-flex align-center gap-2 mb-1">
                            <img src="@GetAssetIcon(asset.AssetTypeName)" class="asset-type-icon-sm" />
                            <span class="layout-asset-name">@asset.Name</span>
                            <MudSpacer />
                            @if (asset.LatestPing != null)
                            {
                                <span class="layout-ping-dot"
                                      style="background: var(--mud-palette-@(asset.LatestPing.Reachable ? "success" : "error"));">
                                </span>
                            }
                        </div>
                        <div class="d-flex align-center gap-2">
                            @if (!string.IsNullOrEmpty(asset.Ip))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@asset.Ip</MudText>
                            }
                            <MudSpacer />
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Color="@GetHealthChipColor(asset.Health)"
                                     Style="height: 20px; font-size: 0.7rem;">
                                @GetHealthLabelShort(asset.Health)
                            </MudChip>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    }
}

@code {
    [Parameter] public List<TwmsLayoutLine> Lines { get; set; } = [];
    [Parameter] public List<TwmsLayoutGroup> LayoutGroups { get; set; } = [];
    [Parameter] public List<AssetStatusInfo> AssetStatuses { get; set; } = [];

    private List<AssetStatusInfo> GetUnassignedAssets()
    {
        var allLineIds = Lines.Select(l => l.Id).ToHashSet();
        return AssetStatuses
            .Where(a => a.AugLineId == null || !allLineIds.Contains(a.AugLineId.Value))
            .ToList();
    }

    private static readonly (string Label, string Color)[] _legendItems =
    [
        ("갱신", "#65B991"),
        ("유지", "#6BA0DE"),
        ("실패", "#E67E7E"),
        ("내역없음", "#999"),
    ];

    private record GroupDisplay(int GroupId, int? Floor, HashSet<int> AssetIds, List<AssetStatusInfo> Members);

    private List<GroupDisplay> GetGroupsForLine(int lineId, List<AssetStatusInfo> lineAssets)
    {
        var lineAssetIds = lineAssets.Select(a => a.AssetId).ToHashSet();
        var result = new List<GroupDisplay>();

        foreach (var grp in LayoutGroups)
        {
            var assetIds = ParseGroupAssets(grp.Assets);
            // 그룹의 자산 중 이 라인에 속한 것이 있으면 이 라인의 그룹
            var members = lineAssets.Where(a => assetIds.Contains(a.AssetId)).ToList();
            if (members.Count > 0)
            {
                result.Add(new GroupDisplay(grp.Id, grp.Floor, assetIds, members));
            }
        }

        return result;
    }

    private static HashSet<int> ParseGroupAssets(string? assetsJson)
    {
        if (string.IsNullOrWhiteSpace(assetsJson)) return [];
        try
        {
            var ids = JsonSerializer.Deserialize<List<int>>(assetsJson);
            return ids?.ToHashSet() ?? [];
        }
        catch { return []; }
    }

    private void NavigateToAsset(int assetId)
    {
        Nav.NavigateTo($"/assets/{assetId}");
    }

    private static string GetAssetIcon(string? typeName) => typeName switch
    {
        var n when n != null && n.Contains("PLC")   => "images/icons/plc.png",
        var n when n != null && n.Contains("Servo")  => "images/icons/servo.png",
        var n when n != null && (n.Contains("HMI") || n.Contains("XP")) => "images/icons/hmi.png",
        var n when n != null && n.Contains("Drive")  => "images/icons/drive.png",
        var n when n != null && n.Contains("FTP")    => "images/icons/ftp.png",
        _ => "images/icons/plc.png",
    };
}
