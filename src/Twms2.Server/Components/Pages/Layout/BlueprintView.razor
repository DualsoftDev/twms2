@using static Twms2.Server.Helpers.LayoutHelpers
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@* ── 범례 ── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.Center">
        @foreach (var (label, color) in _legendItems)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <div class="topology-legend-dot" style="background: @color;"></div>
                <MudText Typo="Typo.body2">@label</MudText>
            </MudStack>
        }
        <MudSpacer />
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @Lines.Count 개 라인 · 클릭하여 자산 목록 보기 · 휠로 확대/축소
        </MudText>
    </MudStack>
</MudPaper>

@* ── 도면 컨테이너 ── *@
<MudPaper Class="pa-0 blueprint-container" Elevation="2">
    <div id="bv-container" class="blueprint-viewport"
         style="background-color: @(BlueprintConfig?.BgColor ?? "#1a1a2e")">
        <svg class="drawing-editor-svg" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid meet">
            @* ── 도면 이미지 배경 ── *@
            @if (!string.IsNullOrEmpty(BlueprintConfig?.ImagePath))
            {
                var ir = CalcImageRect(BlueprintConfig);
                <image href="@BlueprintConfig.ImagePath"
                       x="@F(ir.X)" y="@F(ir.Y)" width="@F(ir.W)" height="@F(ir.H)"
                       preserveAspectRatio="none" opacity="0.85" />
            }

            @* ── 라인 영역 clipPath 정의 ── *@
            <defs>
                @foreach (var rect in BlueprintRects)
                {
                    <clipPath id="line-clip-@rect.LineId">
                        <rect x="@F(rect.X)" y="@F(rect.Y)"
                              width="@F(rect.Width)" height="@F(rect.Height)" rx="6" />
                    </clipPath>
                }
            </defs>

            @* ── 라인 영역 사각형 + 내부 자산 아이콘 (PLC + standalone만) ── *@
            @foreach (var rect in BlueprintRects)
            {
                var line = Lines.FirstOrDefault(l => l.Id == rect.LineId);
                if (line == null) continue;
                var lineAssets = AssetStatuses.Where(a => a.AugLineId == rect.LineId).ToList();
                var topLevel = lineAssets.Where(a => !_childAssetIds.Contains(a.AssetId)).ToList();
                var childCount = lineAssets.Count - topLevel.Count;
                var healthColor = AggregateHealthColor(lineAssets);
                var isSelected = (_dialogKind == DialogKind.Line && _dialogTargetId == rect.LineId)
                    || (_dialogKind != DialogKind.None && lineAssets.Any(a => a.AssetId == _dialogTargetId));

                <g class="blueprint-rect-group @(isSelected ? "active" : "")"
                   @onclick="() => OnRectClick(rect.LineId)"
                   @onclick:stopPropagation="true">
                    @* 영역 배경 *@
                    <rect x="@F(rect.X)" y="@F(rect.Y)"
                          width="@F(rect.Width)" height="@F(rect.Height)"
                          rx="6" ry="6"
                          fill="@(healthColor)10"
                          stroke="@healthColor"
                          stroke-width="@(isSelected ? "1.5" : "0.7")"
                          stroke-opacity="@(isSelected ? "1" : "0.6")" />

                    @* 라인 이름 (상단 가운데) + 자산 수 배지 *@
                    @{
                        var labelText = line.Name;
                        var totalAssetCount = lineAssets.Count;
                        // 텍스트 폭 추정 (한글≈12, 영숫자≈7)
                        var estW = labelText.Sum(c => c > 127 ? 12.0 : 7.0);
                        var badgeCx = rect.X + rect.Width / 2 + estW / 2 + 8;
                        var badgeCy = rect.Y + 11;
                    }
                    <text x="@F(rect.X + rect.Width / 2)" y="@F(rect.Y + 15)"
                          text-anchor="middle" class="blueprint-rect-label"
                          fill="white" font-size="12" font-weight="bold"
                          stroke="@healthColor" stroke-width="0.3" paint-order="stroke">
                        @labelText
                    </text>
                    @if (totalAssetCount > 0)
                    {
                        <circle cx="@F(badgeCx)" cy="@F(badgeCy)" r="5.5"
                                fill="@healthColor" stroke="white" stroke-width="0.4" />
                        @(RenderBadgeText(badgeCx, badgeCy + 2.5, totalAssetCount))
                    }

                    @* 자산 아이콘 (PLC 카드 + standalone) - clipPath로 영역 내 제한 *@
                    @{
                        var (standalones, plcCards) = LayoutLineAssets(rect, topLevel);
                    }
                    <g clip-path="url(#line-clip-@rect.LineId)">

                    @* ── PLC 카드 ── *@
                    @foreach (var card in plcCards)
                    {
                        var plcColor = GetHealthColor(card.Plc.Health);
                        var dr = Math.Max(2.0, card.PlcSize * 0.12);
                        var plcIx = card.X + 2;
                        var plcIy = card.Vertical ? card.Y + 2 : card.Y + (card.CardH - card.PlcSize) / 2;

                        @* PLC 카드 영역 클릭 → 자산 상세 *@
                        <g @onclick="() => OnAssetClick(card.Plc.AssetId)" @onclick:stopPropagation="true"
                           style="cursor:pointer">
                            <rect x="@F(card.X)" y="@F(card.Y)"
                                  width="@F(card.CardW)" height="@F(card.CardH)"
                                  rx="5" fill="#1e1e38"
                                  stroke="rgba(255,255,255,0.25)" stroke-width="0.8" />
                            <g class="blueprint-asset-icon">
                                @{
                                    var plcOffline = card.Plc.LatestPing is { Reachable: false };
                                    var plcBg = GetIconBgColor(card.Plc.Health, plcOffline);
                                }
                                @(RenderSvgTitle(card.Plc))
                                <rect x="@F(plcIx)" y="@F(plcIy)"
                                      width="@F(card.PlcSize)" height="@F(card.PlcSize)"
                                      rx="4" fill="@plcBg" stroke="@plcColor" stroke-width="0.7" opacity="0.95" />
                                <image href="@GetAssetIcon(card.Plc.AssetTypeName, card.Plc.AugIsRobotPLC)"
                                       x="@F(plcIx + 2)" y="@F(plcIy + 2)"
                                       width="@F(card.PlcSize - 4)" height="@F(card.PlcSize - 4)" />
                            </g>
                            @if (card.HasIp && !string.IsNullOrEmpty(card.Ip))
                            {
                                @* IP 인셋 배경 *@
                                <rect x="@F(card.IpBgX)" y="@F(card.IpBgY)"
                                      width="@F(card.IpBgW)" height="@F(card.IpBgH)"
                                      rx="2" fill="rgba(0,0,0,0.3)"
                                      stroke="rgba(0,0,0,0.2)" stroke-width="0.5" />
                                @(RenderIpLabel(card.IpX, card.IpY, card.Ip))
                                @if (card.Groups.Count > 0)
                                {
                                    @* IP ↔ 자식 구분선 *@
                                    <line x1="@F(card.DivX1)" y1="@F(card.DivY)"
                                          x2="@F(card.DivX2)" y2="@F(card.DivY)"
                                          stroke="rgba(255,255,255,0.15)" stroke-width="0.5" />
                                }
                            }
                        </g>

                        @* 종류별 2단 자산 그룹 (각각 클릭 → 그룹 상세) *@
                        @foreach (var grp in card.Groups)
                        {
                            var grpBg = GetIconBgColorFromHex(grp.Color);
                            <g @onclick="() => OnGroupClick(card.Plc.AssetId, grp.GroupIcon)"
                               @onclick:stopPropagation="true" style="cursor:pointer">
                                <g class="blueprint-asset-icon">
                                    <rect x="@F(grp.X)" y="@F(grp.Y)"
                                          width="@F(grp.Size)" height="@F(grp.Size)"
                                          rx="2" fill="@grpBg" stroke="@grp.Color" stroke-width="1" opacity="0.9" />
                                    <image href="@GetAssetIcon(grp.Rep.AssetTypeName, grp.Rep.AugIsRobotPLC)"
                                           x="@F(grp.X + 1)" y="@F(grp.Y + 1)"
                                           width="@F(grp.Size - 2)" height="@F(grp.Size - 2)" />
                                    <circle cx="@F(grp.X + grp.Size - 2)" cy="@F(grp.Y + 2)" r="5"
                                            fill="#555" stroke="white" stroke-width="0.8" />
                                    @(RenderBadgeText(grp.X + grp.Size - 2, grp.Y + 4.5, grp.Count))
                                </g>
                            </g>
                        }
                    }

                    @* ── Standalone 자산 아이콘 (클릭 → 자산 상세) ── *@
                    @foreach (var item in standalones)
                    {
                        var ac = GetHealthColor(item.Asset.Health);
                        var offline = item.Asset.LatestPing is { Reachable: false };
                        var stBg = GetIconBgColor(item.Asset.Health, offline);

                        <g @onclick="() => OnAssetClick(item.Asset.AssetId)" @onclick:stopPropagation="true"
                           style="cursor:pointer">
                            <g class="blueprint-asset-icon">
                                @(RenderSvgTitle(item.Asset))
                                <rect x="@F(item.X)" y="@F(item.Y)"
                                      width="@F(item.Size)" height="@F(item.Size)"
                                      rx="4" fill="@stBg" stroke="@ac" stroke-width="0.7" opacity="0.95" />
                                <image href="@GetAssetIcon(item.Asset.AssetTypeName, item.Asset.AugIsRobotPLC)"
                                       x="@F(item.X + 2)" y="@F(item.Y + 2)"
                                       width="@F(item.Size - 4)" height="@F(item.Size - 4)" />
                            </g>
                        </g>
                    }
                    </g>@* end clip-path *@
                </g>
            }
        </svg>

        @* ── 줌 컨트롤 ── *@
        <div class="blueprint-zoom-controls">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                           OnClick="ZoomIn" Title="확대" />
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                           OnClick="ZoomOut" Title="축소" />
            <MudIconButton Icon="@Icons.Material.Filled.CenterFocusWeak" Size="Size.Small"
                           OnClick="ZoomReset" Title="초기화" />
            <MudIconButton Icon="@(_isFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                           Size="Size.Small" OnClick="ToggleFullscreen" Title="전체화면" />
        </div>
    </div>

    @* ── 클릭 다이얼로그 (Line / Asset / ChildGroup) ── *@
    @if (_dialogKind != DialogKind.None)
    {
        <div class="blueprint-backdrop" @onclick="CloseDialog"></div>
        <div class="blueprint-dialog">
            <div class="blueprint-popover-inner">

                @* ━━━ 라인 클릭 ━━━ *@
                @if (_dialogKind == DialogKind.Line)
                {
                    var selLine = Lines.FirstOrDefault(l => l.Id == _dialogTargetId);
                    var selAssets = AssetStatuses.Where(a => a.AugLineId == _dialogTargetId).ToList();
                    var top = selAssets.Where(a => !_childAssetIds.Contains(a.AssetId)).ToList();
                    var child = selAssets.Where(a => _childAssetIds.Contains(a.AssetId))
                        .OrderBy(a => a.AugIpVia).ThenBy(a => a.AugBaseNumber).ThenBy(a => a.AugSlotNumber).ToList();

                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@selLine?.Name</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDialog" />
                    </div>
                    @if (top.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">1단 자산</MudText>
                        @foreach (var a in top)
                        {
                            @(RenderAssetRow(a))
                        }
                    }
                    @if (child.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 mb-1">2단 경유 자산</MudText>
                        @(RenderChildTable(child))
                    }
                    @if (selAssets.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">배정된 자산이 없습니다.</MudText>
                    }
                }

                @* ━━━ 자산 클릭 (1단 PLC/Standalone) ━━━ *@
                else if (_dialogKind == DialogKind.Asset)
                {
                    var asset = AssetStatuses.FirstOrDefault(a => a.AssetId == _dialogTargetId);
                    if (asset != null)
                    {
                        <div class="d-flex align-center justify-space-between mb-2">
                            <div class="d-flex align-center gap-2">
                                <img src="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)" class="asset-type-icon-sm" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@asset.Name</MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDialog" />
                        </div>
                        @(RenderAssetRow(asset))
                        @if (_plcChildren.TryGetValue(asset.AssetId, out var ch) && ch.Count > 0)
                        {
                            var sorted = ch.OrderBy(a => a.AugBaseNumber).ThenBy(a => a.AugSlotNumber).ToList();
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 mb-1">
                                경유 자산 (@sorted.Count)
                            </MudText>
                            @(RenderChildTable(sorted))
                        }
                    }
                }

                @* ━━━ 2단 자산 그룹 클릭 ━━━ *@
                else if (_dialogKind == DialogKind.ChildGroup)
                {
                    var plc = AssetStatuses.FirstOrDefault(a => a.AssetId == _dialogTargetId);
                    var children = _plcChildren.GetValueOrDefault(_dialogTargetId)?
                        .Where(c => GetAssetIcon(c.AssetTypeName, c.AugIsRobotPLC) == _dialogGroupIcon)
                        .OrderBy(a => a.AugBaseNumber).ThenBy(a => a.AugSlotNumber).ToList() ?? [];

                    <div class="d-flex align-center justify-space-between mb-2">
                        <div class="d-flex align-center gap-2">
                            @if (children.Count > 0)
                            {
                                <img src="@_dialogGroupIcon" class="asset-type-icon-sm" />
                            }
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">
                                @(children.FirstOrDefault()?.AssetTypeName ?? "자산") (@children.Count)
                            </MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseDialog" />
                    </div>
                    @if (plc != null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">경유 PLC</MudText>
                        @(RenderAssetRow(plc))
                    }
                    @if (children.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 mb-1">자산 목록</MudText>
                        @(RenderChildTable(children))
                    }
                }

            </div>
        </div>
    }
</MudPaper>

@code {
    [Parameter] public List<TwmsLayoutLine> Lines { get; set; } = [];
    [Parameter] public List<TwmsBlueprintRect> BlueprintRects { get; set; } = [];
    [Parameter] public TwmsBlueprintConfig? BlueprintConfig { get; set; }
    [Parameter] public List<AssetStatusInfo> AssetStatuses { get; set; } = [];
    [Parameter] public EventCallback<int> OnAssetEditRequested { get; set; }

    private enum DialogKind { None, Line, Asset, ChildGroup }
    private DialogKind _dialogKind;
    private int _dialogTargetId;
    private string? _dialogGroupIcon;
    private bool _jsInitialized;
    private bool _isFullscreen;

    // PLC 계층 구조
    private HashSet<int> _childAssetIds = new();
    private Dictionary<int, List<AssetStatusInfo>> _plcChildren = new();

    private static readonly (string Label, string Color)[] _legendItems =
    [
        ("갱신", "#65B991"),
        ("유지", "#6BA0DE"),
        ("실패", "#E67E7E"),
        ("내역없음", "#999"),
    ];

    protected override void OnParametersSet()
    {
        BuildPlcHierarchy();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_jsInitialized)
        {
            _jsInitialized = true;
            try { await JS.InvokeVoidAsync("blueprintZoom.init", "bv-container"); }
            catch (JSDisconnectedException) { }
        }
    }

    private void BuildPlcHierarchy()
    {
        _childAssetIds.Clear();
        _plcChildren.Clear();

        // IP → Asset 맵
        var ipToAsset = new Dictionary<string, AssetStatusInfo>(StringComparer.OrdinalIgnoreCase);
        foreach (var a in AssetStatuses)
        {
            if (!string.IsNullOrEmpty(a.Ip))
                ipToAsset.TryAdd(a.Ip, a);
        }

        // AugIpVia로 자식 그룹핑
        foreach (var a in AssetStatuses)
        {
            if (string.IsNullOrEmpty(a.AugIpVia)) continue;
            if (ipToAsset.TryGetValue(a.AugIpVia, out var plc) && plc.AssetId != a.AssetId)
            {
                if (!_plcChildren.ContainsKey(plc.AssetId))
                    _plcChildren[plc.AssetId] = [];
                _plcChildren[plc.AssetId].Add(a);
                _childAssetIds.Add(a.AssetId);
            }
        }
    }

    private void OnRectClick(int lineId)
    {
        if (_dialogKind == DialogKind.Line && _dialogTargetId == lineId) CloseDialog();
        else { _dialogKind = DialogKind.Line; _dialogTargetId = lineId; _dialogGroupIcon = null; }
    }

    private void OnAssetClick(int assetId)
    {
        if (_dialogKind == DialogKind.Asset && _dialogTargetId == assetId) CloseDialog();
        else { _dialogKind = DialogKind.Asset; _dialogTargetId = assetId; _dialogGroupIcon = null; }
    }

    private void OnGroupClick(int plcAssetId, string groupIcon)
    {
        if (_dialogKind == DialogKind.ChildGroup && _dialogTargetId == plcAssetId && _dialogGroupIcon == groupIcon) CloseDialog();
        else { _dialogKind = DialogKind.ChildGroup; _dialogTargetId = plcAssetId; _dialogGroupIcon = groupIcon; }
    }

    private void CloseDialog()
    {
        _dialogKind = DialogKind.None;
    }

    private async Task ZoomIn()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.zoomIn", "bv-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomOut()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.zoomOut", "bv-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomReset()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.reset", "bv-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            _isFullscreen = !_isFullscreen;
            await JS.InvokeVoidAsync("blueprintZoom.toggleFullscreen", "bv-container", _isFullscreen);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.dispose", "bv-container"); }
        catch (JSDisconnectedException) { }
    }

    private static MarkupString RenderBadgeText(double x, double y, int count) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"middle\" font-size=\"6\" fill=\"white\" font-weight=\"bold\">{count}</text>");

    private static MarkupString RenderIpLabel(double x, double y, string ip) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" font-size=\"6.5\" fill=\"rgba(200,220,255,0.9)\" font-family=\"'Consolas','Monaco',monospace\" letter-spacing=\"0.3\">{ip}</text>");

    private void NavigateToAsset(int assetId)
    {
        Navigation.NavigateTo($"/assets/{assetId}");
    }

    private RenderFragment RenderAssetRow(AssetStatusInfo a) => __builder =>
    {
        <div class="blueprint-popover-item">
            <img src="@GetAssetIcon(a.AssetTypeName, a.AugIsRobotPLC)" class="asset-type-icon-sm" />
            <span class="flex-grow-1 blueprint-asset-link" style="min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                  @onclick="() => NavigateToAsset(a.AssetId)" @onclick:stopPropagation="true">
                @a.Name
            </span>
            @if (!string.IsNullOrEmpty(a.Ip))
            {
                <code style="font-size:0.75rem; color:var(--mud-palette-text-secondary);">@a.Ip</code>
            }
            @{ var (hLabel, hColor) = GetHealthLabelAndColor(a.Health); }
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                     Style="@($"height:20px; font-size:0.7rem; background:{hColor}; color:white;")">
                @hLabel
            </MudChip>
            @if (a.LatestPing != null)
            {
                <MudChip T="string" Size="Size.Small"
                         Color="@(a.LatestPing.Reachable ? Color.Success : Color.Error)"
                         Variant="Variant.Outlined" Style="height:20px; font-size:0.7rem;">
                    @(a.LatestPing.Reachable ? "온라인" : "오프라인")
                </MudChip>
            }
        </div>
    };

    private RenderFragment RenderChildTable(List<AssetStatusInfo> children) => __builder =>
    {
        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="font-size:0.8rem;">
            <thead>
                <tr>
                    <th style="width:28px;"></th>
                    <th>이름</th>
                    <th>IP</th>
                    <th>경유IP</th>
                    <th>Base</th>
                    <th>Slot</th>
                    <th>상태</th>
                    <th>연결</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in children)
                {
                    var (cLabel, cColor) = GetHealthLabelAndColor(c.Health);
                    <tr>
                        <td><img src="@GetAssetIcon(c.AssetTypeName, c.AugIsRobotPLC)" style="width:22px;height:22px;" /></td>
                        <td class="blueprint-asset-link" style="white-space:nowrap; max-width:140px; overflow:hidden; text-overflow:ellipsis;"
                            @onclick="() => NavigateToAsset(c.AssetId)" @onclick:stopPropagation="true">@c.Name</td>
                        <td style="font-family:monospace; font-size:0.75rem;">@c.Ip</td>
                        <td style="font-family:monospace; font-size:0.75rem;">@c.AugIpVia</td>
                        <td>@c.AugBaseNumber</td>
                        <td>@c.AugSlotNumber</td>
                        <td>
                            <span style="font-size:0.7rem; font-weight:600; color:@cColor;">@cLabel</span>
                        </td>
                        <td>
                            @if (c.LatestPing != null)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(c.LatestPing.Reachable ? Color.Success : Color.Error)"
                                         Variant="Variant.Outlined" Style="height:18px; font-size:0.65rem;">
                                    @(c.LatestPing.Reachable ? "온라인" : "오프라인")
                                </MudChip>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    };

    private record struct StandaloneInfo(double X, double Y, double Size, AssetStatusInfo Asset);
    private record struct ChildGroupInfo(double X, double Y, double Size, AssetStatusInfo Rep, int Count, string Color, string GroupIcon);

    private class PlcCardInfo
    {
        public double X, Y, CardW, CardH, PlcSize;
        public AssetStatusInfo Plc = null!;
        public string? Ip;
        public double IpX, IpY; // IP 라벨 위치
        public bool Vertical;   // true이면 세로 배치 (IP/자식이 아래)
        public bool HasIp;
        public double IpBgX, IpBgY, IpBgW, IpBgH; // IP 인셋 배경
        public double DivX1, DivX2, DivY;           // IP-자식 구분선
        public List<ChildGroupInfo> Groups = [];
    }

    private (List<StandaloneInfo>, List<PlcCardInfo>) LayoutLineAssets(
        TwmsBlueprintRect rect, List<AssetStatusInfo> topLevel)
    {
        var standalones = new List<StandaloneInfo>();
        var plcCards = new List<PlcCardInfo>();
        var pad = 4.0;
        var headerH = 20.0;
        var maxX = rect.X + rect.Width - pad;
        var maxY = rect.Y + rect.Height - 2;
        var availW = rect.Width - pad * 2;
        var availH = rect.Height - headerH - 2;
        int totalSlots = topLevel.Count;

        if (availH < 2 || totalSlots == 0) return (standalones, plcCards);

        // 영역 비율에 맞는 최적 아이콘 크기
        var aspectRatio = availW / Math.Max(1, availH);
        var bestCols = Math.Max(1, (int)Math.Round(Math.Sqrt(totalSlots * aspectRatio)));
        var cols = Math.Min(bestCols, totalSlots);
        var rows = (int)Math.Ceiling((double)totalSlots / cols);
        var gap = 3.0;
        var cellH = (availH - gap * Math.Max(0, rows - 1)) / Math.Max(1, rows);

        var sz = Math.Max(6, Math.Min(cellH, 36));

        // PLC 세로 카드: 높이 = 1.45*sz + 16 → sz ≤ (cellH - 16) / 1.45
        var plcCount = topLevel.Count(a => _plcChildren.ContainsKey(a.AssetId));
        if (plcCount > 0)
        {
            var testHorizW = sz + 80; // 가로 카드 최소 폭 추정
            if (testHorizW > availW || availH > availW * 1.5)
                sz = Math.Max(6, Math.Min(sz, (cellH - 16) / 1.45));
        }
        var childSz = Math.Round(Math.Min(sz * 0.45, sz * 0.5), 1);
        var ipFontSz = 7.0;
        var innerGap = 4.0;
        var ipLineH = 10.0;

        var x = rect.X + pad;
        var y = rect.Y + headerH;

        foreach (var asset in topLevel)
        {
            if (_plcChildren.TryGetValue(asset.AssetId, out var children))
            {
                var groups = children
                    .GroupBy(c => GetAssetIcon(c.AssetTypeName, c.AugIsRobotPLC))
                    .ToList();

                var ipLen = !string.IsNullOrEmpty(asset.Ip) ? asset.Ip.Length : 0;
                var ipTextW = ipLen * ipFontSz * 0.62 + 8;
                var childrenW = groups.Count * (childSz + gap) + gap + 8;
                var rightW = Math.Max(Math.Max(childrenW, ipTextW), 40);
                var horizCardW = sz + innerGap + rightW;

                // 가로 카드가 영역 폭에 안 맞으면 → 세로 배치
                var useVertical = horizCardW > availW || availH > availW * 1.5;

                if (useVertical)
                {
                    // ── 세로 배치: PLC 아이콘 위, IP 중간, 자식 아이콘 아래 ──
                    var childRowH = groups.Count > 0 ? childSz + 2 : 0;
                    var hasIp = !string.IsNullOrEmpty(asset.Ip);
                    var cardW = Math.Max(sz, Math.Min(availW, Math.Max(ipTextW, groups.Count * (childSz + gap))));
                    var cardH = sz + (hasIp ? ipLineH : 0) + childRowH + 4;
                    var rowH = cardH + gap;

                    if (x + cardW > maxX && x > rect.X + pad) { x = rect.X + pad; y += rowH; }
                    if (cardW > availW) cardW = availW;

                    var card = new PlcCardInfo
                    {
                        X = x, Y = y, CardW = cardW, CardH = cardH,
                        PlcSize = sz, Plc = asset, Ip = asset.Ip,
                        Vertical = true,
                    };

                    // IP 위치: PLC 아이콘 바로 아래
                    var belowY = y + sz + 2;
                    if (hasIp)
                    {
                        card.HasIp = true;
                        card.IpBgX = x + 1;
                        card.IpBgY = belowY - 1;
                        card.IpBgW = cardW - 2;
                        card.IpBgH = ipLineH;
                        card.IpX = x + 4;
                        card.IpY = belowY + 7;
                        card.DivX1 = x + 3;
                        card.DivX2 = x + cardW - 3;
                        card.DivY = belowY + ipLineH - 1;
                        belowY += ipLineH;
                    }

                    // 자식 아이콘: IP 아래에 가로 배열
                    var childX = x + 2;
                    foreach (var grp in groups)
                    {
                        if (childX + childSz > x + cardW - 2) break;
                        var grpIcon = GetAssetIcon(grp.First().AssetTypeName, grp.First().AugIsRobotPLC);
                        card.Groups.Add(new(childX, belowY, childSz,
                            grp.First(), grp.Count(), AggregateHealthColor(grp.ToList()), grpIcon));
                        childX += childSz + gap;
                    }

                    plcCards.Add(card);
                    x += cardW + gap;
                    // 세로 카드가 높으므로 다음 줄 y 보정
                    if (x > maxX) { x = rect.X + pad; y += rowH; }
                }
                else
                {
                    // ── 가로 배치: 기존 방식 (PLC 왼쪽, IP+자식 오른쪽) ──
                    var cardW = horizCardW;
                    var cardH = sz;
                    var rowH = sz + gap;

                    if (x + cardW > maxX && x > rect.X + pad) { x = rect.X + pad; y += rowH; }
                    if (cardW > availW) cardW = availW;

                    var hasIpH = !string.IsNullOrEmpty(asset.Ip);
                    var card = new PlcCardInfo
                    {
                        X = x, Y = y, CardW = cardW, CardH = cardH,
                        PlcSize = sz, Plc = asset, Ip = asset.Ip,
                        Vertical = false,
                        HasIp = hasIpH,
                        IpX = x + sz + 6,
                        IpY = y + 10,
                        IpBgX = x + sz + 2,
                        IpBgY = y + 1,
                        IpBgW = cardW - sz - 4,
                        IpBgH = ipLineH + 2,
                        DivX1 = x + sz + 4,
                        DivX2 = x + cardW - 4,
                        DivY = y + ipLineH + 3,
                    };

                    var childX = x + sz + innerGap;
                    var childY = y + cardH - childSz - 3;
                    var childMaxX = x + cardW - 3;
                    foreach (var grp in groups)
                    {
                        if (childX + childSz > childMaxX) break;
                        var grpIcon = GetAssetIcon(grp.First().AssetTypeName, grp.First().AugIsRobotPLC);
                        card.Groups.Add(new(childX, childY, childSz,
                            grp.First(), grp.Count(), AggregateHealthColor(grp.ToList()), grpIcon));
                        childX += childSz + gap;
                    }

                    plcCards.Add(card);
                    x += cardW + gap;
                }
            }
            else
            {
                var rowH = sz + gap;
                if (x + sz > maxX && x > rect.X + pad) { x = rect.X + pad; y += rowH; }
                standalones.Add(new(x, y, sz, asset));
                x += sz + gap;
            }
        }

        return (standalones, plcCards);
    }


}
