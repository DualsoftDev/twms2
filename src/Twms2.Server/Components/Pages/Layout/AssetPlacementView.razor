@using static Twms2.Server.Helpers.LayoutHelpers
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@* ── 범례(건강 상태 필터) + 필터 ── *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="flex-wrap">
        @foreach (var fi in _healthFilterItems)
        {
            var f = fi;
            var isChecked = !_hiddenHealthStatuses.Contains(f.Status);
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="apv-filter-item">
                <MudCheckBox T="bool" Value="isChecked" Size="Size.Small" Dense="true"
                             Color="Color.Primary"
                             ValueChanged="@(v => ToggleHealthFilter(f.Status, v))" />
                <div class="topology-legend-dot" style="background: @f.Color;"></div>
                <MudText Typo="Typo.body2">@f.Label</MudText>
            </MudStack>
        }
        <MudDivider Vertical="true" FlexItem="true" />

        @* ── 자산 타입별 필터 (PLC/Robot 구분) ── *@
        @foreach (var ft in VisibleAssetTypeFilters)
        {
            var f = ft;
            var isChecked = !_hiddenAssetTypeKeys.Contains(f.Key);
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="apv-filter-item">
                <MudCheckBox T="bool" Value="isChecked" Size="Size.Small" Dense="true"
                             Color="Color.Primary"
                             ValueChanged="@(v => ToggleAssetTypeKeyFilter(f.Key, v))" />
                <img src="@f.Icon" class="apv-filter-icon" />
                <MudText Typo="Typo.caption">@f.Label</MudText>
            </MudStack>
        }

        @if (PlacementGroups.Count > 0)
        {
            <MudDivider Vertical="true" FlexItem="true" />

            @* ── 그룹 필터: 체크박스 + 층별 상세 메뉴 ── *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="apv-filter-item">
                <MudCheckBox T="bool" Value="_groupsVisible" Size="Size.Small" Dense="true"
                             Color="Color.Primary"
                             ValueChanged="ToggleAllGroups" />
                <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small"
                         Style="color: #4a90d9; margin-right: 2px;" />
                <MudText Typo="Typo.caption">그룹</MudText>
            </MudStack>
            @if (AllFloors.Count > 0)
            {
                <MudMenu Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small"
                         Dense="true" AnchorOrigin="Origin.BottomLeft">
                    @foreach (var floor in AllFloors)
                    {
                        var fl = floor;
                        var flChecked = !_hiddenFloors.Contains(fl);
                        <MudMenuItem AutoClose="false" OnClick="@(() => ToggleFloorFilter(fl))">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudCheckBox T="bool" Value="flChecked" Size="Size.Small" Dense="true"
                                             Color="Color.Secondary" ReadOnly="true" />
                                <MudText Typo="Typo.body2">@FormatFloorLabel(fl)</MudText>
                            </MudStack>
                        </MudMenuItem>
                    }
                </MudMenu>
            }
        }

        <MudSpacer />
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @FilteredVisibleCount / @VisiblePositions.Count 개 표시 · 휠로 확대/축소
        </MudText>
    </MudStack>
</MudPaper>

@* ── 배치도 뷰 ── *@
<MudPaper Class="pa-0 blueprint-container" Elevation="2">
    <div id="apv-container" class="blueprint-viewport"
         style="background-color: @(BlueprintConfig?.BgColor ?? "#1a1a2e")">
        <svg class="drawing-editor-svg" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid meet">
            @* ── 도면 이미지 배경 ── *@
            @if (!string.IsNullOrEmpty(BlueprintConfig?.ImagePath))
            {
                var ir = CalcImageRect(BlueprintConfig);
                <image href="@($"/{BlueprintConfig.ImagePath.TrimStart('/')}")"
                       x="@F(ir.X)" y="@F(ir.Y)" width="@F(ir.W)" height="@F(ir.H)"
                       preserveAspectRatio="none" opacity="0.85" />
            }

            @* ── 그룹 clipPath / 3D 필터 정의 ── *@
            <defs>
                @foreach (var grp in PlacementGroups)
                {
                    <clipPath id="grp-clip-@grp.Id">
                        <rect x="@F(grp.X)" y="@F(grp.Y)"
                              width="@F(grp.Width)" height="@F(grp.Height)" rx="6" />
                    </clipPath>
                }
                @* 튀어나온 효과 (외부 그림자: 우하단 어둠 + 좌상단 하이라이트) *@
                <filter id="apv-outset" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur in="SourceAlpha" stdDeviation="3" />
                    <feOffset dx="3" dy="4" result="offOut" />
                    <feFlood flood-color="#000" flood-opacity="0.6" />
                    <feComposite in2="offOut" operator="in" result="darkOut" />
                    <feGaussianBlur in="SourceAlpha" stdDeviation="2" />
                    <feOffset dx="-1.5" dy="-1.5" result="offHi" />
                    <feFlood flood-color="#fff" flood-opacity="0.15" />
                    <feComposite in2="offHi" operator="in" result="hiOut" />
                    <feMerge>
                        <feMergeNode in="darkOut" />
                        <feMergeNode in="hiOut" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
                @* 들어간 효과 (내부 그림자: 좌상단 어둠 + 우하단 하이라이트) *@
                <filter id="apv-inset" x="-5%" y="-5%" width="110%" height="110%">
                    <feGaussianBlur in="SourceAlpha" stdDeviation="2.5" />
                    <feOffset dx="2.5" dy="3" result="offDk" />
                    <feComposite in="offDk" in2="SourceAlpha" operator="arithmetic"
                                 k2="-1" k3="1" result="insDk" />
                    <feFlood flood-color="#000" flood-opacity="0.75" />
                    <feComposite in2="insDk" operator="in" result="darkIn" />
                    <feGaussianBlur in="SourceAlpha" stdDeviation="2" />
                    <feOffset dx="-1.5" dy="-1.5" result="offLt" />
                    <feComposite in="offLt" in2="SourceAlpha" operator="arithmetic"
                                 k2="-1" k3="1" result="insLt" />
                    <feFlood flood-color="#fff" flood-opacity="0.18" />
                    <feComposite in2="insLt" operator="in" result="lightIn" />
                    <feMerge>
                        <feMergeNode in="SourceGraphic" />
                        <feMergeNode in="darkIn" />
                        <feMergeNode in="lightIn" />
                    </feMerge>
                </filter>
            </defs>

            @* ── 그룹 컨테이너 + 내부 자산 아이콘 (동적 배치) ── *@
            @foreach (var grp in PlacementGroups)
            {
                if (!_groupsVisible) continue;
                var memberAssets = GetFilteredGroupMemberAssets(grp.Id);
                if (memberAssets.Count == 0) continue;
                var grpColor = grp.Color ?? "#4a90d9";
                var isRaised = grp.Floor >= 2;
                var isSunken = grp.Floor < 0;
                <g class="apv-group-container">
                    @* 그룹 배경: 층에 따라 3D 필터 적용 *@
                    @if (isRaised)
                    {
                        <rect x="@F(grp.X)" y="@F(grp.Y)"
                              width="@F(grp.Width)" height="@F(grp.Height)"
                              rx="6" fill="@(grpColor)35" filter="url(#apv-outset)" />
                    }
                    else if (isSunken)
                    {
                        <rect x="@F(grp.X)" y="@F(grp.Y)"
                              width="@F(grp.Width)" height="@F(grp.Height)"
                              rx="6" fill="@(grpColor)25" filter="url(#apv-inset)" />
                    }
                    else
                    {
                        <rect x="@F(grp.X)" y="@F(grp.Y)"
                              width="@F(grp.Width)" height="@F(grp.Height)"
                              rx="6"
                              fill="@(grpColor)10"
                              stroke="@grpColor"
                              stroke-width="0.7" stroke-dasharray="6 3" />
                    }

                    @* 그룹 내 멤버 자산 아이콘 - clipPath로 영역 안에 가둠 *@
                    <g clip-path="url(#grp-clip-@grp.Id)">
                        @{
                            var items = LayoutGroupAssets(grp, memberAssets);
                        }
                        @foreach (var item in items)
                        {
                            var healthColor = GetHealthColor(item.Asset.Health);
                            var isOffline = item.Asset.LatestPing is { Reachable: false };
                            var bgColor = GetIconBgColor(item.Asset.Health, isOffline);
                            <g transform="translate(@F(item.X), @F(item.Y))" class="apv-asset-icon"
                               @onclick="() => NavigateToAsset(item.Asset.AssetId)"
                               @onclick:stopPropagation="true" style="cursor:pointer">
                                @(RenderSvgTitle(item.Asset, grp.Floor))
                                <rect width="@F(item.Size)" height="@F(item.Size)" rx="3"
                                      fill="@bgColor" stroke="@healthColor" stroke-width="1" opacity="0.9" />
                                <image href="@GetAssetIcon(item.Asset.AssetTypeName, item.Asset.AugIsRobotPLC)"
                                       width="@F(item.Size - 2)" height="@F(item.Size - 2)" x="1" y="1" />
                            </g>
                        }
                    </g>
                </g>
            }

            @* ── 배치된 자산 아이콘 (그룹에 속하지 않은 것) ── *@
            @foreach (var pos in UngroupedVisiblePositions)
            {
                var asset = AssetStatuses.FirstOrDefault(a => a.AssetId == pos.AssetId);
                if (asset == null) continue;
                if (_hiddenAssetTypeKeys.Contains(GetAssetTypeKey(asset))) continue;
                if (_hiddenHealthStatuses.Contains(asset.Health)) continue;

                var healthColor = GetHealthColor(asset.Health);
                var isOffline = asset.LatestPing is { Reachable: false };
                var bgColor = GetIconBgColor(asset.Health, isOffline);
                var s = pos.Scale;
                var sz = 36 * s;
                var imgSz = 28 * s;
                var imgOff = 4 * s;
                <g transform="translate(@F(pos.X - sz / 2), @F(pos.Y - sz / 2))" class="apv-asset-icon"
                   @onclick="() => NavigateToAsset(asset.AssetId)"
                   @onclick:stopPropagation="true" style="cursor:pointer">
                    @(RenderSvgTitle(asset, AssetFloorMap.GetValueOrDefault(asset.AssetId)))
                    <rect width="@F(sz)" height="@F(sz)" rx="@F(Math.Max(1, 4 * s))"
                          fill="@bgColor" stroke="@healthColor" stroke-width="@F(Math.Max(0.5, 1.5 * s))" opacity="0.9" />
                    <image href="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                           width="@F(imgSz)" height="@F(imgSz)" x="@F(imgOff)" y="@F(imgOff)" />
                </g>
            }
        </svg>

        @* ── 줌 컨트롤 ── *@
        <div class="blueprint-zoom-controls">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                           OnClick="ZoomIn" Title="확대" />
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                           OnClick="ZoomOut" Title="축소" />
            <MudIconButton Icon="@Icons.Material.Filled.CenterFocusWeak" Size="Size.Small"
                           OnClick="ZoomReset" Title="초기화" />
            <MudIconButton Icon="@(_isFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                           Size="Size.Small" OnClick="ToggleFullscreen" Title="전체화면" />
        </div>
    </div>
</MudPaper>

@if (VisiblePositions.Count == 0 && PlacementGroups.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
        배치된 자산이 없습니다. 관리 > 레이아웃 관리에서 자산을 배치해 주세요.
    </MudAlert>
}

@code {
    [Parameter] public TwmsBlueprintConfig? BlueprintConfig { get; set; }
    [Parameter] public List<TwmsAssetPosition> AssetPositions { get; set; } = [];
    [Parameter] public List<AssetStatusInfo> AssetStatuses { get; set; } = [];
    [Parameter] public List<TwmsPlacementGroup> PlacementGroups { get; set; } = [];
    [Parameter] public List<TwmsPlacementGroupMember> PlacementGroupMembers { get; set; } = [];
    [Parameter] public List<TwmsLayoutGroup> LayoutGroups { get; set; } = [];
    private bool _jsInitialized;
    private bool _isFullscreen;

    // ──────────── 필터 상태 ────────────
    private HashSet<string> _hiddenAssetTypeKeys = new();
    private HashSet<AssetHealthStatus> _hiddenHealthStatuses = new();
    private bool _groupsVisible = true;
    private HashSet<int> _hiddenFloors = new();
    private bool _floorFilterInitialized;

    protected override void OnParametersSet()
    {
        _assetFloorMap = null!;
        if (!_floorFilterInitialized && LayoutGroups.Count > 0)
        {
            _floorFilterInitialized = true;
            // 기본값: 1층만 표시, 나머지 숨김
            var floors = LayoutGroups
                .Select(g => g.Floor).Where(f => f.HasValue).Select(f => f!.Value)
                .Distinct().ToList();
            _hiddenFloors = floors.Where(f => f != 1).ToHashSet();
        }
    }

    private void NavigateToAsset(int assetId) => Navigation.NavigateTo($"/assets/{assetId}");

    private List<TwmsAssetPosition> VisiblePositions =>
        AssetPositions.Where(p => p.Visible).ToList();

    private HashSet<int> GroupedAssetIds =>
        PlacementGroupMembers.Select(m => m.AssetId).ToHashSet();

    private List<TwmsAssetPosition> UngroupedVisiblePositions =>
        VisiblePositions.Where(p => !GroupedAssetIds.Contains(p.AssetId)).ToList();

    // ──────────── 필터: 자산 타입 (PLC/Robot 구분) ────────────

    private record AssetTypeFilter(string Key, string Label, string Icon);

    private static string GetAssetTypeKey(AssetStatusInfo a) =>
        a.AssetTypeName != null && a.AssetTypeName.Contains("PLC") && a.AugIsRobotPLC is > 0
            ? $"{a.AssetTypeName}__robot"
            : a.AssetTypeName ?? "_unknown";

    private List<AssetTypeFilter> VisibleAssetTypeFilters
    {
        get
        {
            var visibleIds = AssetPositions.Where(p => p.Visible).Select(p => p.AssetId).ToHashSet();
            var seen = new HashSet<string>();
            var result = new List<AssetTypeFilter>();
            foreach (var a in AssetStatuses.Where(a => visibleIds.Contains(a.AssetId)))
            {
                var key = GetAssetTypeKey(a);
                if (!seen.Add(key)) continue;
                var isRobot = key.EndsWith("__robot");
                var label = isRobot ? "Robot" : a.AssetTypeName ?? "기타";
                var icon = GetAssetIcon(a.AssetTypeName, isRobot ? 1 : null);
                result.Add(new(key, label, icon));
            }
            return result.OrderBy(f => f.Label).ToList();
        }
    }

    private void ToggleAssetTypeKeyFilter(string key, bool show)
    {
        if (show) _hiddenAssetTypeKeys.Remove(key);
        else _hiddenAssetTypeKeys.Add(key);
    }

    // ──────────── 필터: 그룹 & 층 ────────────

    private void ToggleAllGroups(bool show) => _groupsVisible = show;

    private void ToggleFloorFilter(int floor)
    {
        if (!_hiddenFloors.Remove(floor))
            _hiddenFloors.Add(floor);
    }

    private Dictionary<int, int?> _assetFloorMap = null!;

    private Dictionary<int, int?> AssetFloorMap =>
        _assetFloorMap ??= LayoutGroups.ToDictionary(g => g.AssetId, g => g.Floor);

    private List<int> AllFloors =>
        PlacementGroupMembers
            .Select(m => AssetFloorMap.GetValueOrDefault(m.AssetId))
            .Where(f => f.HasValue)
            .Select(f => f!.Value)
            .Distinct()
            .OrderBy(f => f)
            .ToList();

    private List<AssetStatusInfo> GetFilteredGroupMemberAssets(int groupId)
    {
        var all = GetGroupMemberAssets(groupId);
        return all.Where(a =>
        {
            if (_hiddenHealthStatuses.Contains(a.Health)) return false;
            if (_hiddenAssetTypeKeys.Contains(GetAssetTypeKey(a))) return false;
            if (_hiddenFloors.Count > 0)
            {
                var floor = AssetFloorMap.GetValueOrDefault(a.AssetId);
                if (floor.HasValue && _hiddenFloors.Contains(floor.Value)) return false;
            }
            return true;
        }).ToList();
    }

    private int FilteredVisibleCount
    {
        get
        {
            var ungrouped = UngroupedVisiblePositions.Count(p =>
            {
                var asset = AssetStatuses.FirstOrDefault(a => a.AssetId == p.AssetId);
                return asset != null
                    && !_hiddenAssetTypeKeys.Contains(GetAssetTypeKey(asset))
                    && !_hiddenHealthStatuses.Contains(asset.Health);
            });
            var grouped = _groupsVisible
                ? PlacementGroups.Sum(g => GetFilteredGroupMemberAssets(g.Id).Count)
                : 0;
            return ungrouped + grouped;
        }
    }

    private record HealthFilterItem(string Label, string Color, AssetHealthStatus Status);

    private static readonly HealthFilterItem[] _healthFilterItems =
    [
        new("갱신", "#65B991", AssetHealthStatus.BackedUp),
        new("유지", "#6BA0DE", AssetHealthStatus.Unchanged),
        new("실패", "#E67E7E", AssetHealthStatus.Failed),
        new("내역없음", "#999", AssetHealthStatus.Unknown),
    ];

    private void ToggleHealthFilter(AssetHealthStatus status, bool show)
    {
        if (show) _hiddenHealthStatuses.Remove(status);
        else _hiddenHealthStatuses.Add(status);
    }

    // ──────────── 그룹 라벨: 멤버 자산의 층 정보 기반 ────────────

    private string GetGroupFloorLabel(int groupId)
    {
        var memberIds = PlacementGroupMembers
            .Where(m => m.GroupId == groupId)
            .Select(m => m.AssetId);
        var floors = memberIds
            .Select(id => AssetFloorMap.GetValueOrDefault(id))
            .Where(f => f.HasValue)
            .Select(f => f!.Value)
            .Distinct()
            .OrderBy(f => f)
            .ToList();
        if (floors.Count == 0) return $"그룹 #{groupId}";
        return string.Join(", ", floors.Select(FormatFloorLabel));
    }

    // ──────────── 그룹 멤버 자산 조회 ────────────

    private List<AssetStatusInfo> GetGroupMemberAssets(int groupId)
    {
        var memberIds = PlacementGroupMembers
            .Where(m => m.GroupId == groupId)
            .Select(m => m.AssetId)
            .ToHashSet();
        return AssetStatuses.Where(a => memberIds.Contains(a.AssetId)).ToList();
    }

    // ──────────── 그룹 내 동적 그리드 배치 ────────────

    private record struct GroupAssetItem(double X, double Y, double Size, AssetStatusInfo Asset);

    private static List<GroupAssetItem> LayoutGroupAssets(TwmsPlacementGroup grp, List<AssetStatusInfo> members)
    {
        var result = new List<GroupAssetItem>();
        if (members.Count == 0) return result;

        var pad = 2.0;
        var availW = grp.Width - pad * 2;
        var availH = grp.Height - pad * 2;
        if (availW < 4 || availH < 4) return result;

        var count = members.Count;
        var aspectRatio = availW / availH;

        // 최적 열/행 수: 영역 비율에 맞게
        var bestCols = Math.Max(1, (int)Math.Round(Math.Sqrt(count * aspectRatio)));
        var cols = Math.Min(bestCols, count);
        var rows = (int)Math.Ceiling((double)count / cols);

        // gap은 아이콘 크기에 비례 (최소 1px)
        var rawSz = Math.Min(availW / cols, availH / rows);
        var gap = Math.Max(1.0, Math.Min(rawSz * 0.1, 2.0));

        // 아이콘 크기: 영역에 꽉 차게
        var cellW = (availW - gap * (cols - 1)) / cols;
        var cellH = (availH - gap * (rows - 1)) / rows;
        var sz = Math.Max(4, Math.Min(cellW, cellH));

        // 중앙 정렬
        var totalW = cols * sz + (cols - 1) * gap;
        var totalH = rows * sz + (rows - 1) * gap;
        var startX = grp.X + pad + (availW - totalW) / 2;
        var startY = grp.Y + pad + (availH - totalH) / 2;

        for (var i = 0; i < count; i++)
        {
            var col = i % cols;
            var row = i / cols;
            var x = startX + col * (sz + gap);
            var y = startY + row * (sz + gap);
            result.Add(new(Math.Round(x, 2), Math.Round(y, 2), Math.Round(sz, 1), members[i]));
        }

        return result;
    }

    // ──────────── JS 줌 ────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_jsInitialized)
        {
            _jsInitialized = true;
            try { await JS.InvokeVoidAsync("blueprintZoom.init", "apv-container"); }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task ZoomIn()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.zoomIn", "apv-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomOut()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.zoomOut", "apv-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomReset()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.reset", "apv-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ToggleFullscreen()
    {
        try
        {
            _isFullscreen = !_isFullscreen;
            await JS.InvokeVoidAsync("blueprintZoom.toggleFullscreen", "apv-container", _isFullscreen);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.dispose", "apv-container"); }
        catch (JSDisconnectedException) { }
    }

}
