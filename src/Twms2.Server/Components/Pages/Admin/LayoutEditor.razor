@page "/admin/layout/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@using MudBlazor.Utilities
@using static Twms2.Server.Helpers.LayoutHelpers
@inject LayoutDbService LayoutDb
@inject IWebHostEnvironment WebHostEnv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>TWM - @(_layoutName ?? "레이아웃 편집")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/admin/layout" Size="Size.Small" />
    <MudText Typo="Typo.h5" Style="font-weight: 700;">@_layoutName</MudText>
</MudStack>

@if (_layout == null)
{
    <MudAlert Severity="Severity.Warning">레이아웃을 찾을 수 없습니다.</MudAlert>
}
else
{
    <MudTabs @ref="_tabs" Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
             PanelClass="pt-6" Border="true"
             ActivePanelIndex="_activeTabIndex"
             ActivePanelIndexChanged="OnTabChanged">
        <MudTabPanel Text="도면 설정" Icon="@Icons.Material.Filled.Image">
            @* ── 상단: 저장 버튼 ── *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6" Style="font-weight: 600;">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2"
                             Style="vertical-align: middle;" />
                    도면 설정
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save" Size="Size.Small"
                           OnClick="SaveSettingsAsync" Disabled="_saving">
                    @(_saving ? "저장 중..." : "도면 설정 저장")
                </MudButton>
            </MudStack>

            @* ── 도면 이미지 + 배경색 + 그리드색 설정 ── *@
            <MudGrid>
                @* ── 좌: 미리보기 + 도면 이미지 ── *@
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4 neu-card">
                        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Preview" Class="mr-2"
                                     Style="vertical-align: middle;" />
                            미리보기
                        </MudText>
                        <div style="border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08);">
                            <svg viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid meet"
                                 style="width: 100%; display: block;">
                                @{
                                    var gridSmallSize = _gridSize;
                                    var gridLargeSize = _gridSize * 5;
                                }
                                <defs>
                                    <pattern id="preview-grid-small" width="@gridSmallSize" height="@gridSmallSize" patternUnits="userSpaceOnUse">
                                        <path d="M @gridSmallSize 0 L 0 0 0 @gridSmallSize" fill="none"
                                              stroke="@_gridColor.ToString(MudColorOutputFormats.Hex)"
                                              stroke-width="0.5" opacity="0.2" />
                                    </pattern>
                                    <pattern id="preview-grid-large" width="@gridLargeSize" height="@gridLargeSize" patternUnits="userSpaceOnUse">
                                        <rect width="@gridLargeSize" height="@gridLargeSize" fill="url(#preview-grid-small)" />
                                        <path d="M @gridLargeSize 0 L 0 0 0 @gridLargeSize" fill="none"
                                              stroke="@_gridColor.ToString(MudColorOutputFormats.Hex)"
                                              stroke-width="0.8" opacity="0.3" />
                                    </pattern>
                                </defs>
                                <rect width="1000" height="600" fill="@_bgColor.ToString(MudColorOutputFormats.Hex)" />
                                @if (_gridEnabled)
                                {
                                    <rect width="1000" height="600" fill="url(#preview-grid-large)" />
                                }
                                @if (!string.IsNullOrEmpty(_previewImagePath))
                                {
                                    var ir = CalcImageRect(_config);
                                    <image href="@_previewImagePath"
                                           x="@F(ir.X)" y="@F(ir.Y)" width="@F(ir.W)" height="@F(ir.H)"
                                           preserveAspectRatio="none" opacity="0.85" />
                                }
                            </svg>
                        </div>
                    </MudPaper>

                    <MudPaper Class="pa-4 neu-card mt-4">
                        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Image" Class="mr-2"
                                     Style="vertical-align: middle;" />
                            도면 이미지
                        </MudText>

                        <InputFile id="blueprint-image-input" OnChange="OnImageFileSelected"
                                   accept="image/png,image/jpeg,image/webp,image/svg+xml"
                                   style="display:none;" />

                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Upload"
                                       OnClick="@(() => JS.InvokeVoidAsync("eval", "document.getElementById('blueprint-image-input').click()"))">
                                이미지 선택
                            </MudButton>
                            @if (_selectedFile != null)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">@_selectedFileName</MudChip>
                            }
                            @if (!string.IsNullOrEmpty(_currentImagePath))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Download"
                                           OnClick="DownloadImageAsync">
                                    다운로드
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="RemoveImageAsync">
                                    삭제
                                </MudButton>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">등록된 이미지 없음</MudText>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                @* ── 우: 배경색 + 그리드 ── *@
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4 neu-card">
                        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight: 600;">
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Class="mr-2"
                                     Style="vertical-align: middle;" />
                            배경색
                        </MudText>

                        <div class="d-flex align-center gap-3 mb-3">
                            <div style="width: 36px; height: 36px; border-radius: 8px; border: 2px solid rgba(255,255,255,0.15);
                                        background-color: @_bgColor.ToString(MudColorOutputFormats.Hex); flex-shrink: 0;" />
                            <div>
                                <MudText Typo="Typo.body1" Style="font-weight: 500;">@GetColorName(_bgColor)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@_bgColor.ToString(MudColorOutputFormats.HexA)</MudText>
                            </div>
                        </div>

                        <MudColorPicker @bind-Value="_bgColor" Label="청사진 배경색"
                                        Variant="Variant.Outlined"
                                        ColorPickerMode="ColorPickerMode.HEX" Class="mb-3" />

                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                                       OnClick="@(() => _bgColor = new MudColor("#1a1a2e"))">
                                기본 (다크 블루)
                            </MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                                       OnClick="@(() => _bgColor = new MudColor("#ffffff"))">
                                흰색
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Class="pa-4 neu-card mt-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudText Typo="Typo.h6" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Filled.GridOn" Class="mr-2"
                                         Style="vertical-align: middle;" />
                                그리드
                            </MudText>
                            <MudSpacer />
                            <MudSwitch @bind-Value="_gridEnabled" Color="Color.Primary"
                                       Label="@(_gridEnabled ? "사용" : "미사용")" />
                        </MudStack>

                        @if (_gridEnabled)
                        {
                            <MudStack Spacing="3">
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="mb-1" Color="Color.Secondary">그리드 크기</MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudSlider T="int" @bind-Value="_gridSize" Min="5" Max="100" Step="5"
                                                   Color="Color.Primary" Style="flex: 1;" />
                                        <MudText Typo="Typo.body2" Style="min-width: 40px; text-align: right;">@_gridSize px</MudText>
                                    </MudStack>
                                </div>

                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="mb-1" Color="Color.Secondary">그리드 색상</MudText>
                                    <div class="d-flex align-center gap-3 mb-2">
                                        <div style="width: 28px; height: 28px; border-radius: 6px; border: 2px solid rgba(255,255,255,0.15);
                                                    background-color: @_gridColor.ToString(MudColorOutputFormats.Hex); flex-shrink: 0;" />
                                        <MudText Typo="Typo.body2">@GetColorName(_gridColor)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_gridColor.ToString(MudColorOutputFormats.HexA)</MudText>
                                    </div>

                                    <MudColorPicker @bind-Value="_gridColor" Label="그리드 색상"
                                                    Variant="Variant.Outlined"
                                                    ColorPickerMode="ColorPickerMode.HEX" Class="mb-2" />

                                    <MudStack Row="true" Spacing="1">
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                                                   OnClick="@(() => _gridColor = new MudColor("#e0e0e0"))">
                                            기본 (밝은 회색)
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                                                   OnClick="@(() => _gridColor = new MudColor("#ffffff"))">
                                            흰색
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary"
                                                   OnClick="@(() => _gridColor = new MudColor("#4a90d9"))">
                                            파란색
                                        </MudButton>
                                    </MudStack>
                                </div>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="라인 영역" Icon="@Icons.Material.Filled.Map">
            <BlueprintEditor @ref="_blueprintEditor" LayoutId="Id" />
        </MudTabPanel>
        <MudTabPanel Text="자산 배치" Icon="@Icons.Material.Filled.GridView">
            <PlacementEditor @ref="_placementEditor" LayoutId="Id" />
        </MudTabPanel>
    </MudTabs>

    <MudOverlay Visible="_saving" DarkBackground="true" ZIndex="9999"
                Class="d-flex align-center justify-center">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Primary">저장 중...</MudText>
        </MudStack>
    </MudOverlay>
}

@code {
    [Parameter] public int Id { get; set; }

    private TwmsLayout? _layout;
    private string? _layoutName;
    private TwmsBlueprintConfig? _config;
    private string? _currentImagePath;
    private string? _previewImagePath;
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private MudColor _bgColor = new("#1a1a2e");
    private MudColor _gridColor = new("#e0e0e0");
    private bool _gridEnabled = true;
    private int _gridSize = 20;
    private bool _saving;

    // ── 탭/네비게이션 가드 ──
    private MudTabs? _tabs;
    private int _activeTabIndex;
    private BlueprintEditor? _blueprintEditor;
    private PlacementEditor? _placementEditor;
    private IDisposable? _navLock;
    private bool _openDexaOnRender;

    protected override async Task OnInitializedAsync()
    {
        var layouts = await LayoutDb.GetAllLayoutsAsync();
        _layout = layouts.FirstOrDefault(l => l.Id == Id);
        _layoutName = _layout?.Name ?? "알 수 없는 레이아웃";
        await LoadConfigAsync();

        _navLock = Navigation.RegisterLocationChangingHandler(OnLocationChanging);

        // ?tab=dexa → 다이얼로그 자동 열기 (OnAfterRender에서 처리)
        var uri = new Uri(Navigation.Uri);
        _openDexaOnRender = System.Web.HttpUtility.ParseQueryString(uri.Query)["tab"] == "dexa";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _openDexaOnRender)
        {
            _openDexaOnRender = false;
            await OpenDexaImportDialog();
        }
    }

    public async Task OpenDexaImportDialog()
    {
        var parameters = new DialogParameters<DexaImportDialog>
        {
            { x => x.LayoutId, Id },
            { x => x.LayoutName, _layoutName },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<DexaImportDialog>("이전 TWMS 레이아웃 가져오기", parameters, options);
        await dialog.Result;
    }

    private bool HasAnyUnsavedChanges() =>
        (_blueprintEditor?.HasUnsavedChanges ?? false) ||
        (_placementEditor?.HasUnsavedChanges ?? false);

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (HasAnyUnsavedChanges())
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "저장하지 않은 변경사항이 있습니다. 페이지를 떠나시겠습니까?");
            if (!confirmed)
                context.PreventNavigation();
        }
    }

    private async Task OnTabChanged(int newIndex)
    {
        if (newIndex != _activeTabIndex && HasAnyUnsavedChanges())
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", "저장하지 않은 변경사항이 있습니다. 탭을 전환하시겠습니까?");
            if (!confirmed)
            {
                // 원래 탭으로 되돌리기
                if (_tabs != null)
                    await InvokeAsync(() => { _tabs.ActivatePanel(_activeTabIndex); StateHasChanged(); });
                return;
            }
        }
        _activeTabIndex = newIndex;
    }

    public void Dispose()
    {
        _navLock?.Dispose();
    }

    private async Task LoadConfigAsync()
    {
        _config = await LayoutDb.GetBlueprintConfigAsync(Id);
        _selectedFile = null;
        _selectedFileName = null;
        if (_config != null)
        {
            _currentImagePath = _config.ImagePath;
            _previewImagePath = _config.ImagePath;
            if (!string.IsNullOrEmpty(_config.BgColor))
                _bgColor = new MudColor(_config.BgColor);
            else
                _bgColor = new MudColor("#1a1a2e");
            if (!string.IsNullOrEmpty(_config.GridColor))
                _gridColor = new MudColor(_config.GridColor);
            else
                _gridColor = new MudColor("#e0e0e0");
            _gridEnabled = _config.GridEnabled;
            _gridSize = _config.GridSize > 0 ? _config.GridSize : 20;
        }
        else
        {
            _currentImagePath = null;
            _previewImagePath = null;
            _bgColor = new MudColor("#1a1a2e");
            _gridColor = new MudColor("#e0e0e0");
            _gridEnabled = true;
            _gridSize = 20;
        }
    }

    // ──────────────── 도면 설정 ────────────────

    private void OnImageFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _selectedFileName = e.File.Name;
    }

    private async Task SaveSettingsAsync()
    {
        _saving = true;
        try
        {
            _config ??= new TwmsBlueprintConfig();
            _config.LayoutId = Id;

            if (_selectedFile != null)
            {
                var ext = Path.GetExtension(_selectedFile.Name).ToLowerInvariant();
                if (ext is not (".png" or ".jpg" or ".jpeg" or ".webp" or ".svg"))
                {
                    Snackbar.Add("PNG, JPG, SVG, WEBP 파일만 지원합니다.", Severity.Warning);
                    return;
                }

                var uploadsDir = TwmsDataPath.Uploads;

                foreach (var f in Directory.GetFiles(uploadsDir, $"blueprint-bg-{Id}.*"))
                    File.Delete(f);

                var filePath = Path.Combine(uploadsDir, $"blueprint-bg-{Id}{ext}");
                await using (var stream = File.Create(filePath))
                {
                    await _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(stream);
                }

                _config.ImagePath = $"uploads/blueprint-bg-{Id}{ext}";
                _currentImagePath = _config.ImagePath;
                _previewImagePath = _config.ImagePath;
                _selectedFile = null;
                _selectedFileName = null;

                var (imgW, imgH) = ReadImageSize(filePath);
                _config.ImageWidth = imgW > 0 ? imgW : null;
                _config.ImageHeight = imgH > 0 ? imgH : null;
            }

            _config.BgColor = _bgColor.ToString(MudColorOutputFormats.Hex);
            _config.GridColor = _gridColor.ToString(MudColorOutputFormats.Hex);
            _config.GridEnabled = _gridEnabled;
            _config.GridSize = _gridSize;

            await LayoutDb.UpsertBlueprintConfigAsync(_config);
            Snackbar.Add("도면 설정이 저장되었습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DownloadImageAsync()
    {
        if (string.IsNullOrEmpty(_currentImagePath)) return;
        var filePath = Path.Combine(TwmsDataPath.Base, _currentImagePath);
        if (!File.Exists(filePath)) { Snackbar.Add("이미지 파일을 찾을 수 없습니다.", Severity.Warning); return; }
        var bytes = await File.ReadAllBytesAsync(filePath);
        var base64 = Convert.ToBase64String(bytes);
        var ext = Path.GetExtension(filePath);
        var mime = ext switch { ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".webp" => "image/webp", _ => "application/octet-stream" };
        var fileName = $"{_layoutName ?? "layout"}{ext}";
        await JS.InvokeVoidAsync("eval",
            $"((d,m,n)=>{{const b=atob(d),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);const u=URL.createObjectURL(new Blob([a],{{type:m}})),l=document.createElement('a');l.href=u;l.download=n;l.click();URL.revokeObjectURL(u)}})('{base64}','{mime}','{fileName}')");
    }

    private async Task RemoveImageAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(_currentImagePath))
            {
                var fullPath = Path.Combine(TwmsDataPath.Base, _currentImagePath);
                if (File.Exists(fullPath))
                    File.Delete(fullPath);
            }

            _config ??= new TwmsBlueprintConfig();
            _config.LayoutId = Id;
            _config.ImagePath = null;
            _config.ImageWidth = null;
            _config.ImageHeight = null;
            _currentImagePath = null;
            _previewImagePath = null;

            await LayoutDb.UpsertBlueprintConfigAsync(_config);
            Snackbar.Add("도면 이미지가 삭제되었습니다.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"삭제 오류: {ex.Message}", Severity.Error);
        }
    }

    private static string GetColorName(MudColor color)
    {
        var hex = color.ToString(MudColorOutputFormats.Hex).ToLowerInvariant();
        return hex switch
        {
            "#000000" => "검정",
            "#ffffff" => "흰색",
            "#1a1a2e" => "다크 블루",
            "#e0e0e0" => "밝은 회색",
            "#4a90d9" => "파란색",
            "#ff0000" => "빨강",
            "#00ff00" => "초록",
            "#0000ff" => "파랑",
            _ => GetHslColorName(color),
        };
    }

    private static string GetHslColorName(MudColor color)
    {
        var r = color.R / 255.0;
        var g = color.G / 255.0;
        var b = color.B / 255.0;
        var max = Math.Max(r, Math.Max(g, b));
        var min = Math.Min(r, Math.Min(g, b));
        var l = (max + min) / 2.0;
        var s = max == min ? 0.0 : (l > 0.5 ? (max - min) / (2.0 - max - min) : (max - min) / (max + min));

        if (s < 0.1) return l < 0.2 ? "매우 어두운 색" : l < 0.4 ? "어두운 회색" : l < 0.6 ? "회색" : l < 0.8 ? "밝은 회색" : "매우 밝은 색";

        double h = 0;
        if (max == r) h = (g - b) / (max - min) + (g < b ? 6 : 0);
        else if (max == g) h = (b - r) / (max - min) + 2;
        else h = (r - g) / (max - min) + 4;
        h *= 60;

        var hueName = h switch
        {
            < 15 => "빨강",
            < 45 => "주황",
            < 75 => "노랑",
            < 150 => "초록",
            < 210 => "시안",
            < 270 => "파랑",
            < 330 => "보라",
            _ => "빨강",
        };

        var lightPrefix = l < 0.3 ? "어두운 " : l > 0.7 ? "밝은 " : "";
        return lightPrefix + hueName;
    }

    private static (double w, double h) ReadImageSize(string filePath)
    {
        try
        {
            var bytes = File.ReadAllBytes(filePath);
            if (bytes.Length > 24 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47)
            {
                int w = (bytes[16] << 24) | (bytes[17] << 16) | (bytes[18] << 8) | bytes[19];
                int h = (bytes[20] << 24) | (bytes[21] << 16) | (bytes[22] << 8) | bytes[23];
                return (w, h);
            }
            if (bytes.Length > 4 && bytes[0] == 0xFF && bytes[1] == 0xD8)
            {
                int i = 2;
                while (i + 8 < bytes.Length)
                {
                    if (bytes[i] != 0xFF) break;
                    byte marker = bytes[i + 1];
                    if (marker == 0xC0 || marker == 0xC2)
                    {
                        int h = (bytes[i + 5] << 8) | bytes[i + 6];
                        int w = (bytes[i + 7] << 8) | bytes[i + 8];
                        return (w, h);
                    }
                    int segLen = (bytes[i + 2] << 8) | bytes[i + 3];
                    i += 2 + segLen;
                }
            }
        }
        catch { /* ignore */ }
        return (0, 0);
    }
}
