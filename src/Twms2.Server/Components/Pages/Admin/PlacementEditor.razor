    // ──────────── 그룹 내 동적 그리드 배치 ────────────

    private record struct GroupAssetItem(double X, double Y, double Size, AssetStatusInfo Asset);

    private static List<GroupAssetItem> LayoutGroupAssets(TwmsPlacementGroup grp, List<AssetStatusInfo> members)
    {
        var result = new List<GroupAssetItem>();
        if (members.Count == 0) return result;

        var pad = 2.0;
        var availW = grp.Width - pad * 2;
        var availH = grp.Height - pad * 2;
        if (availW < 4 || availH < 4) return result;

        var count = members.Count;
        var aspectRatio = availW / availH;

        var bestCols = Math.Max(1, (int)Math.Round(Math.Sqrt(count * aspectRatio)));
        var cols = Math.Min(bestCols, count);
        var rows = (int)Math.Ceiling((double)count / cols);

        var rawSz = Math.Min(availW / cols, availH / rows);
        var gap = Math.Max(1.0, Math.Min(rawSz * 0.1, 2.0));

        var cellW = (availW - gap * (cols - 1)) / cols;
        var cellH = (availH - gap * (rows - 1)) / rows;
        var sz = Math.Max(4, Math.Min(cellW, cellH));

        var totalW = cols * sz + (cols - 1) * gap;
        var totalH = rows * sz + (rows - 1) * gap;
        var startX = grp.X + pad + (availW - totalW) / 2;
        var startY = grp.Y + pad + (availH - totalH) / 2;

        for (var i = 0; i < count; i++)
        {
            var col = i % cols;
            var row = i / cols;
            var x = startX + col * (sz + gap);
            var y = startY + row * (sz + gap);
            result.Add(new(Math.Round(x, 2), Math.Round(y, 2), Math.Round(sz, 1), members[i]));
        }

        return result;
    }

