@using static Twms2.Server.Helpers.LayoutHelpers
@inject TwmDbService TwmDb
@inject AssetStatusService AssetStatusService
@inject LayoutNotificationService LayoutNotification
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    @* ── 툴바 ── *@
    <MudPaper Class="pa-2 mb-2 d-flex align-center gap-2 flex-wrap" Elevation="1">
        <MudToggleIconButton Toggled="@(_activeTool == "pan")"
                             Icon="@Icons.Material.Filled.NearMe"
                             ToggledIcon="@Icons.Material.Filled.PanTool"
                             Size="Size.Small" Color="Color.Default" ToggledColor="Color.Primary"
                             ToggledChanged="@(v => SetTool(v ? "pan" : "select"))" />
        <MudDivider Vertical="true" FlexItem="true" />
        <MudToggleIconButton Toggled="_snapEnabled"
                             Icon="@Icons.Material.Filled.GridOff"
                             ToggledIcon="@Icons.Material.Filled.Grid4x4"
                             Size="Size.Small" Color="Color.Default" ToggledColor="Color.Info"
                             ToggledChanged="OnSnapToggled" />
        <MudNumericField T="int" Value="_snapGridSize" ValueChanged="OnSnapGridChanged"
                         Label="Grid" Variant="Variant.Text" Min="5" Max="100" Step="5"
                         Style="width: 60px;" Margin="Margin.Dense" HideSpinButtons="true" />
        <MudDivider Vertical="true" FlexItem="true" />
        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="ZoomOut" />
        <MudText Typo="Typo.caption" Style="min-width: 40px; text-align: center;">@(_zoomPercent)%</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="ZoomIn" />
        <MudIconButton Icon="@Icons.Material.Filled.CenterFocusWeak" Size="Size.Small" OnClick="ZoomReset" />
        <MudIconButton Icon="@Icons.Material.Filled.FitScreen" Size="Size.Small" OnClick="ZoomFit" />
        <MudDivider Vertical="true" FlexItem="true" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="ml-2" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.AspectRatio" Size="Size.Small" />
            <MudText Typo="Typo.caption">@($"{_globalScale:F1}x")</MudText>
            <MudSlider T="double" Value="_globalScale" ValueChanged="OnGlobalScaleChanged"
                       Min="0.3" Max="3.0" Step="0.1" Style="width: 80px;" />
        </MudStack>
        <MudSpacer />
        @if (_selectedAssetIds.Count + _selectedGroupIds.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Primary">
                @if (_selectedAssetIds.Count > 0) { @($"자산 {_selectedAssetIds.Count}") }
                @if (_selectedGroupIds.Count > 0) { @($" 그룹 {_selectedGroupIds.Count}") }
                선택
            </MudText>
            @if (_selectedAssetIds.Count > 1)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.GroupWork" OnClick="CreateGroupFromSelection">
                    그룹화
                </MudButton>
                <MudMenu Icon="@Icons.Material.Filled.ViewModule" Size="Size.Small"
                         Variant="Variant.Outlined" Color="Color.Info">
                    <MudMenuItem OnClick="@(() => AlignSelected("grid"))">그리드 정렬</MudMenuItem>
                    <MudMenuItem OnClick="@(() => AlignSelected("row"))">가로 정렬</MudMenuItem>
                    <MudMenuItem OnClick="@(() => AlignSelected("col"))">세로 정렬</MudMenuItem>
                </MudMenu>
            }
        }
        @if (_hasChanges)
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text">변경됨</MudChip>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Check"
                   OnClick="ApplyChangesAsync" Disabled="@(_saving || !_hasChanges)">
            @(_saving ? "적용 중..." : "적용")
        </MudButton>
    </MudPaper>

    @* ── 메인 레이아웃: 좌측 패널 + 캔버스 ── *@
    <div class="ap-editor-layout">
        @* ── 좌측 패널 ── *@
        <div class="ap-left-panel">
            @* 검색 + 라인 필터 *@
            <MudTextField @bind-Value="_searchText" Placeholder="자산 검색..."
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Class="mb-2" Margin="Margin.Dense" />
            <MudSelect T="int?" Value="_selectedLineId" ValueChanged="@(v => _selectedLineId = v)"
                       Label="라인" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-2">
                <MudSelectItem T="int?" Value="@((int?)null)">전체</MudSelectItem>
                @foreach (var line in _lines)
                {
                    <MudSelectItem T="int?" Value="@((int?)line.Key)">@line.Value</MudSelectItem>
                }
                <MudSelectItem T="int?" Value="@((int?)-1)">미지정</MudSelectItem>
            </MudSelect>

            @* 미배치 자산 목록 *@
            <div class="ap-panel-section">
                <div class="d-flex align-center gap-1 mb-1">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                        미배치 (@UnplacedAssets.Count)
                    </MudText>
                    <MudSpacer />
                    @if (_checkedAssetIds.Count > 0)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.GridView"
                                   OnClick="StartGridPlacement">
                            격자 배치 (@_checkedAssetIds.Count)
                        </MudButton>
                    }
                </div>
                <div class="ap-asset-list">
                    @foreach (var asset in UnplacedAssets)
                    {
                        var isChecked = _checkedAssetIds.Contains(asset.AssetId);
                        <div class="ap-list-item @(isChecked ? "checked" : "")"
                             @onclick="() => ToggleCheck(asset.AssetId)">
                            <MudCheckBox T="bool" Value="isChecked" Size="Size.Small" Color="Color.Success"
                                         ValueChanged="@(v => ToggleCheck(asset.AssetId))"
                                         @onclick:stopPropagation="true" />
                            <img src="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                                 class="asset-type-icon-sm" />
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="ap-list-name">@asset.Name</div>
                                <div class="ap-list-sub">
                                    @asset.Ip
                                    @if (!string.IsNullOrEmpty(asset.LayoutLineName))
                                    {
                                        <span class="ap-line-tag">@asset.LayoutLineName</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* 그룹 목록 *@
            @if (_groups.Count > 0)
            {
                <div class="ap-panel-section">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-1">
                        그룹 (@_groups.Count)
                    </MudText>
                    <div class="ap-group-list">
                        @foreach (var grp in _groups)
                        {
                            var isExpanded = _expandedGroupIds.Contains(grp.Id);
                            var isGrpSel = _selectedGroupIds.Contains(grp.Id);
                            var memberIds = GetGroupMemberIds(grp.Id);
                            <div class="ap-group-item @(isGrpSel ? "selected" : "")">
                                <div class="ap-group-header" @onclick="() => ToggleGroupExpand(grp.Id)">
                                    <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                             Size="Size.Small" />
                                    <span class="ap-group-color" style="background: @(grp.Color ?? "#4a90d9")"></span>
                                    <span class="flex-grow-1 ap-list-name">
                                        @(string.IsNullOrEmpty(grp.Name) ? $"그룹 #{grp.Id}" : grp.Name)
                                    </span>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@memberIds.Count</MudText>
                                    <span @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="() => DeleteGroup(grp.Id)" />
                                    </span>
                                </div>
                                @if (isExpanded)
                                {
                                    <div class="ap-group-members">
                                        @foreach (var aid in memberIds)
                                        {
                                            var asset = _allAssets.FirstOrDefault(a => a.AssetId == aid);
                                            if (asset == null) continue;
                                            <div class="ap-list-item small">
                                                <img src="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                                                     class="asset-type-icon-sm" />
                                                <span class="flex-grow-1 ap-list-name">@asset.Name</span>
                                                <span @onclick:stopPropagation="true">
                                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                                   Size="Size.Small" Color="Color.Warning"
                                                                   OnClick="() => RemoveFromGroup(grp.Id, aid)" />
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @* 배치된 자산 목록 *@
            <div class="ap-panel-section">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-1">
                    배치됨 (@PlacedUngroupedAssets.Count)
                </MudText>
                <div class="ap-asset-list">
                    @foreach (var asset in PlacedUngroupedAssets)
                    {
                        var isSel = _selectedAssetIds.Contains(asset.AssetId);
                        <div class="ap-list-item @(isSel ? "selected" : "")">
                            <img src="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                                 class="asset-type-icon-sm" />
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="ap-list-name">@asset.Name</div>
                                <div class="ap-list-sub">@asset.Ip</div>
                            </div>
                            <span @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small"
                                               Color="Color.Secondary" OnClick="() => UnplaceAsset(asset.AssetId)" />
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── 캔버스 ── *@
        <div class="ap-canvas-area">
            <div id="ap-editor-container" class="ap-canvas-container">
                <svg id="ap-editor-svg" class="ap-canvas-svg" viewBox="0 0 1000 600"
                     preserveAspectRatio="xMidYMid meet">
                    <defs>
                        <pattern id="ap-grid-sm" width="@_snapGridSize" height="@_snapGridSize" patternUnits="userSpaceOnUse">
                            <path d="M @_snapGridSize 0 L 0 0 0 @_snapGridSize" fill="none"
                                  stroke="#e0e0e0" stroke-width="0.3" opacity="0.3" />
                        </pattern>
                        <pattern id="ap-grid-lg" width="@(_snapGridSize * 5)" height="@(_snapGridSize * 5)" patternUnits="userSpaceOnUse">
                            <rect width="@(_snapGridSize * 5)" height="@(_snapGridSize * 5)" fill="url(#ap-grid-sm)" />
                            <path d="M @(_snapGridSize * 5) 0 L 0 0 0 @(_snapGridSize * 5)" fill="none"
                                  stroke="#ccc" stroke-width="0.5" opacity="0.3" />
                        </pattern>
                    </defs>
                    <rect width="1000" height="600" fill="@(_config?.BgColor ?? "#1a1a2e")" />
                    @if (_snapEnabled)
                    {
                        <rect width="1000" height="600" fill="url(#ap-grid-lg)" />
                    }
                    @if (!string.IsNullOrEmpty(_config?.ImagePath))
                    {
                        <image href="@_config.ImagePath" x="0" y="0" width="1000" height="600"
                               preserveAspectRatio="xMidYMid meet" opacity="0.5" />
                    }

                    @* ── 그룹 ── *@
                    @foreach (var grp in _groups)
                    {
                        var members = GetGroupMemberIds(grp.Id);
                        var isGrpSel = _selectedGroupIds.Contains(grp.Id);
                        <g class="ap-group-container @(isGrpSel ? "ap-group-selected" : "")"
                           data-group-id="@grp.Id"
                           data-x="@F(grp.X)" data-y="@F(grp.Y)"
                           data-w="@F(grp.Width)" data-h="@F(grp.Height)"
                           data-members="@string.Join(",", members)">
                            <rect x="@F(grp.X)" y="@F(grp.Y)" width="@F(grp.Width)" height="@F(grp.Height)"
                                  rx="6" fill="@(grp.Color ?? "#4a90d9")10"
                                  stroke="@(grp.Color ?? "#4a90d9")" stroke-width="1.5" stroke-dasharray="6 3" />
                            <text x="@F(grp.X + 4)" y="@F(grp.Y - 4)" font-size="10"
                                  fill="@(grp.Color ?? "#4a90d9")" class="ap-group-label">
                                @(string.IsNullOrEmpty(grp.Name) ? $"그룹 #{grp.Id}" : grp.Name)
                            </text>
                            <rect class="ap-group-resize"
                                  x="@F(grp.X + grp.Width - 8)" y="@F(grp.Y + grp.Height - 8)"
                                  width="16" height="16" rx="2"
                                  fill="@(grp.Color ?? "#4a90d9")" fill-opacity="0.4" />
                        </g>
                    }

                    @* ── 자산 아이콘 ── *@
                    @foreach (var asset in _allAssets)
                    {
                        var pos = GetPosition(asset.AssetId);
                        if (!pos.Visible) continue;
                        var s = pos.Scale;
                        var sz = 32 * s;
                        var imgSz = 24 * s;
                        var imgOff = 4 * s;
                        var isSel = _selectedAssetIds.Contains(asset.AssetId);

                        <g class="ap-asset-icon @(isSel ? "ap-selected" : "")"
                           data-asset-id="@asset.AssetId"
                           data-x="@F(pos.X)" data-y="@F(pos.Y)"
                           data-scale="@F(s)"
                           transform="translate(@F(pos.X), @F(pos.Y))"
                           style="cursor: grab;">
                            <rect width="@F(sz)" height="@F(sz)" rx="4" fill="white" stroke="#ccc"
                                  stroke-width="1" opacity="0.9" />
                            <image href="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                                   width="@F(imgSz)" height="@F(imgSz)" x="@F(imgOff)" y="@F(imgOff)" />
                            <text x="@F(sz / 2)" y="@F(sz + 12)" text-anchor="middle" font-size="9"
                                  fill="#333" class="ap-icon-label">@TruncName(asset.Name)</text>
                        </g>
                    }
                </svg>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int LayoutId { get; set; }

    // ═══ Loading ═══
    private bool _loading = true;
    private int _prevLayoutId;
    private DotNetObjectReference<PlacementEditor>? _dotNetRef;

    // ═══ Source data ═══
    private List<AssetStatusInfo> _allAssets = [];
    private TwmsBlueprintConfig? _config;
    private Dictionary<int, string> _lines = new();

    // ═══ Working copies (in-memory) ═══
    private Dictionary<int, TwmsAssetPosition> _positions = new();
    private List<TwmsPlacementGroup> _groups = [];
    private Dictionary<int, List<int>> _groupMembers = new();

    // ═══ Derived indexes ═══
    private HashSet<int> _groupedAssetIds = new();

    // ═══ UI state ═══
    private HashSet<int> _selectedAssetIds = new();
    private HashSet<int> _selectedGroupIds = new();
    private HashSet<int> _checkedAssetIds = new();
    private HashSet<int> _expandedGroupIds = new();
    private string? _searchText;
    private int? _selectedLineId;

    // ═══ Editor config ═══
    private double _globalScale = 1.0;
    private bool _snapEnabled = true;
    private int _snapGridSize = 20;
    private string _activeTool = "select";
    private int _zoomPercent = 100;

    // ═══ Change tracking ═══
    private bool _hasChanges;
    private bool _saving;
    private int _nextTempGroupId = -1;

    // ═══ Grid placement ═══
    private GridPlaceState? _gridPlaceState;

    private record GridPlaceState(List<int> AssetIds, int Cols, int Rows, double CellW, double CellH);

    // ═══════════════ Lifecycle ═══════════════

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _prevLayoutId = LayoutId;
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (LayoutId != _prevLayoutId && LayoutId > 0)
        {
            _prevLayoutId = LayoutId;
            _jsInitialized = false;
            await LoadDataAsync();
        }
    }

    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jsInitialized && !_loading)
        {
            _jsInitialized = true;
            await InitEditorJs();
        }
    }

    private async Task LoadDataAsync()
    {
        if (LayoutId == 0) return;
        _loading = true;
        try
        {
            var statusTask = AssetStatusService.GetAssetStatusesAsync();
            var posTask    = TwmDb.GetAllAssetPositionsAsync(LayoutId);
            var configTask = TwmDb.GetBlueprintConfigAsync(LayoutId);
            var groupTask  = TwmDb.GetAllPlacementGroupsAsync(LayoutId);
            var memberTask = TwmDb.GetPlacementGroupMembersAsync(LayoutId);
            var lineTask   = TwmDb.GetTwmsLayoutLineMapAsync();
            await Task.WhenAll(statusTask, posTask, configTask, groupTask, memberTask, lineTask);

            _allAssets = statusTask.Result;
            _positions = posTask.Result.ToDictionary(p => p.AssetId);
            _config = configTask.Result;
            _groups = groupTask.Result;
            _lines = lineTask.Result;
            _groupMembers = memberTask.Result
                .GroupBy(m => m.GroupId)
                .ToDictionary(g => g.Key, g => g.Select(m => m.AssetId).ToList());

            RebuildIndexes();
            _hasChanges = false;
            _nextTempGroupId = -1;

            var scales = _positions.Values.Where(p => p.Scale > 0).Select(p => p.Scale).ToList();
            _globalScale = scales.Count > 0 ? Math.Round(scales.Average(), 1) : 1.0;
        }
        finally { _loading = false; }
    }

    private async Task InitEditorJs()
    {
        try { await JS.InvokeVoidAsync("assetPlacementEditor.init", "ap-editor-container", _dotNetRef); }
        catch (JSDisconnectedException) { }
    }

    // ═══════════════ Indexes ═══════════════

    private void RebuildIndexes()
    {
        _groupedAssetIds = new HashSet<int>(_groupMembers.Values.SelectMany(ids => ids));
    }

    private TwmsAssetPosition GetPosition(int assetId)
    {
        if (_positions.TryGetValue(assetId, out var pos)) return pos;
        var newPos = new TwmsAssetPosition { LayoutId = LayoutId, AssetId = assetId, X = 100, Y = 100 };
        _positions[assetId] = newPos;
        return newPos;
    }

    private List<int> GetGroupMemberIds(int groupId) =>
        _groupMembers.TryGetValue(groupId, out var ids) ? ids : [];

    // ═══════════════ Computed Lists ═══════════════

    private List<AssetStatusInfo> UnplacedAssets
    {
        get
        {
            var result = _allAssets.Where(a => !GetPosition(a.AssetId).Visible);
            if (_selectedLineId.HasValue)
                result = _selectedLineId.Value == -1
                    ? result.Where(a => !a.AugLineId.HasValue)
                    : result.Where(a => a.AugLineId == _selectedLineId.Value);
            if (!string.IsNullOrWhiteSpace(_searchText))
                result = result.Where(a =>
                    (a.Name?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (a.Ip?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
            return result.ToList();
        }
    }

    private List<AssetStatusInfo> PlacedUngroupedAssets =>
        _allAssets.Where(a => GetPosition(a.AssetId).Visible && !_groupedAssetIds.Contains(a.AssetId)).ToList();

    // ═══════════════ Tool / Snap / Zoom ═══════════════

    private async Task SetTool(string tool)
    {
        _activeTool = tool;
        try { await JS.InvokeVoidAsync("assetPlacementEditor.setTool", "ap-editor-container", tool); }
        catch (JSDisconnectedException) { }
    }

    private async Task OnSnapToggled(bool toggled)
    {
        _snapEnabled = toggled;
        try { await JS.InvokeVoidAsync("assetPlacementEditor.setSnapConfig", "ap-editor-container", toggled, _snapGridSize); }
        catch (JSDisconnectedException) { }
    }

    private async Task OnSnapGridChanged(int size)
    {
        _snapGridSize = Math.Clamp(size, 5, 100);
        try { await JS.InvokeVoidAsync("assetPlacementEditor.setSnapConfig", "ap-editor-container", _snapEnabled, _snapGridSize); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomIn()
    {
        try { await JS.InvokeVoidAsync("assetPlacementEditor.zoomIn", "ap-editor-container"); await UpdateZoomPercent(); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomOut()
    {
        try { await JS.InvokeVoidAsync("assetPlacementEditor.zoomOut", "ap-editor-container"); await UpdateZoomPercent(); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomReset()
    {
        try { await JS.InvokeVoidAsync("assetPlacementEditor.resetZoom", "ap-editor-container"); _zoomPercent = 100; }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomFit()
    {
        try { await JS.InvokeVoidAsync("assetPlacementEditor.fitAll", "ap-editor-container"); await UpdateZoomPercent(); }
        catch (JSDisconnectedException) { }
    }

    private async Task UpdateZoomPercent()
    {
        try { _zoomPercent = await JS.InvokeAsync<int>("assetPlacementEditor.getZoomLevel", "ap-editor-container"); }
        catch (JSDisconnectedException) { }
    }

    private void OnGlobalScaleChanged(double newScale)
    {
        newScale = Math.Clamp(newScale, 0.3, 3.0);
        _globalScale = newScale;
        foreach (var pos in _positions.Values)
            pos.Scale = newScale;
        _hasChanges = true;
    }

    // ═══════════════ JS Callbacks ═══════════════

    [JSInvokable]
    public void OnSelectionChanged(int[] assetIds, int[] groupIds)
    {
        _selectedAssetIds = new HashSet<int>(assetIds);
        _selectedGroupIds = new HashSet<int>(groupIds);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnToggleAssetSelection(int assetId)
    {
        _selectedGroupIds.Clear();
        if (!_selectedAssetIds.Remove(assetId))
            _selectedAssetIds.Add(assetId);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnToggleGroupSelection(int groupId)
    {
        _selectedAssetIds.Clear();
        if (!_selectedGroupIds.Remove(groupId))
            _selectedGroupIds.Add(groupId);
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnItemsMoved(List<JsAssetPos> positions)
    {
        foreach (var jp in positions)
        {
            var pos = GetPosition(jp.AssetId);
            pos.X = jp.X;
            pos.Y = jp.Y;
        }
        _hasChanges = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnGroupMoved(int groupId, double x, double y, double w, double h)
    {
        var grp = _groups.FirstOrDefault(g => g.Id == groupId);
        if (grp != null)
        {
            grp.X = x; grp.Y = y; grp.Width = w; grp.Height = h;
            _hasChanges = true;
        }
    }

    [JSInvokable]
    public void OnAssetDroppedOnGroup(int assetId, int groupId)
    {
        if (_groupMembers.TryGetValue(groupId, out var members) && members.Contains(assetId)) return;

        // Remove from previous group
        foreach (var (gid, mems) in _groupMembers)
        {
            if (mems.Remove(assetId))
            {
                if (mems.Count == 0)
                {
                    _groups.RemoveAll(g => g.Id == gid);
                    _groupMembers.Remove(gid);
                }
                break;
            }
        }

        if (!_groupMembers.TryGetValue(groupId, out members))
        {
            members = [];
            _groupMembers[groupId] = members;
        }
        members.Add(assetId);
        RebuildIndexes();
        _hasChanges = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnAssetRemovedFromGroup(int assetId, int groupId)
    {
        if (!_groupMembers.TryGetValue(groupId, out var members)) return;
        if (!members.Remove(assetId)) return;
        if (members.Count == 0)
        {
            _groups.RemoveAll(g => g.Id == groupId);
            _groupMembers.Remove(groupId);
        }
        RebuildIndexes();
        _hasChanges = true;
        InvokeAsync(StateHasChanged);
    }

    // ═══════════════ Grid Placement ═══════════════

    [JSInvokable]
    public void OnGridPlaceConfirmed(double x, double y)
    {
        if (_gridPlaceState == null) return;
        var state = _gridPlaceState;

        for (int i = 0; i < state.AssetIds.Count; i++)
        {
            int col = i % state.Cols, row = i / state.Cols;
            var pos = GetPosition(state.AssetIds[i]);
            pos.Visible = true;
            pos.Scale = _globalScale;
            pos.X = Math.Round(x + col * state.CellW, 2);
            pos.Y = Math.Round(y + row * state.CellH, 2);
        }

        // Create group
        var tempId = _nextTempGroupId--;
        var lineName = _selectedLineId.HasValue && _selectedLineId.Value > 0 && _lines.TryGetValue(_selectedLineId.Value, out var ln)
            ? ln : "그룹";
        _groups.Add(new TwmsPlacementGroup
        {
            Id = tempId, LayoutId = LayoutId, Name = lineName,
            X = Math.Round(x - 12, 2), Y = Math.Round(y - 16, 2),
            Width = Math.Round(state.Cols * state.CellW + 24, 2),
            Height = Math.Round(state.Rows * state.CellH + 32, 2),
        });
        _groupMembers[tempId] = state.AssetIds;
        RebuildIndexes();

        _checkedAssetIds.Clear();
        _gridPlaceState = null;
        _hasChanges = true;

        Snackbar.Add($"{state.AssetIds.Count}개 자산이 배치되었습니다.", Severity.Success);
        InvokeAsync(StateHasChanged);
    }

    private async Task StartGridPlacement()
    {
        if (_checkedAssetIds.Count == 0) return;

        var assetIds = _checkedAssetIds
            .OrderBy(id => _allAssets.FirstOrDefault(a => a.AssetId == id)?.Name ?? "")
            .ToList();
        int count = assetIds.Count;
        int cols = (int)Math.Ceiling(Math.Sqrt(count));
        int rows = (int)Math.Ceiling((double)count / cols);
        double cellW = 32.0 * _globalScale + 16;
        double cellH = 32.0 * _globalScale + 28;

        _gridPlaceState = new GridPlaceState(assetIds, cols, rows, cellW, cellH);

        var names = assetIds
            .Select(id => TruncName(_allAssets.FirstOrDefault(a => a.AssetId == id)?.Name))
            .ToArray();

        try
        {
            await JS.InvokeVoidAsync("assetPlacementEditor.showGridPreview",
                "ap-editor-container", cols, rows, cellW, cellH, names);
        }
        catch (JSDisconnectedException) { }
    }

    // ═══════════════ Unplace / Check ═══════════════

    private void ToggleCheck(int assetId)
    {
        if (!_checkedAssetIds.Remove(assetId))
            _checkedAssetIds.Add(assetId);
    }

    private void UnplaceAsset(int assetId)
    {
        var pos = GetPosition(assetId);
        pos.Visible = false;
        // Remove from groups
        foreach (var (gid, members) in _groupMembers)
        {
            if (members.Remove(assetId))
            {
                if (members.Count == 0)
                {
                    _groups.RemoveAll(g => g.Id == gid);
                    _groupMembers.Remove(gid);
                }
                break;
            }
        }
        RebuildIndexes();
        _hasChanges = true;
    }

    // ═══════════════ Group Management ═══════════════

    private void ToggleGroupExpand(int groupId)
    {
        if (!_expandedGroupIds.Remove(groupId))
            _expandedGroupIds.Add(groupId);
    }

    private void CreateGroupFromSelection()
    {
        if (_selectedAssetIds.Count < 2) return;
        var memberIds = _selectedAssetIds.ToList();

        // Bounding box from positions
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var id in memberIds)
        {
            var p = GetPosition(id);
            var sz = 32.0 * p.Scale;
            minX = Math.Min(minX, p.X); minY = Math.Min(minY, p.Y);
            maxX = Math.Max(maxX, p.X + sz); maxY = Math.Max(maxY, p.Y + sz + 14);
        }

        var pad = 14.0;
        var tempId = _nextTempGroupId--;
        _groups.Add(new TwmsPlacementGroup
        {
            Id = tempId, LayoutId = LayoutId, Name = "그룹",
            X = Math.Round(minX - pad, 2), Y = Math.Round(minY - pad - 14, 2),
            Width = Math.Round(maxX - minX + pad * 2, 2),
            Height = Math.Round(maxY - minY + pad * 2 + 14, 2),
        });
        _groupMembers[tempId] = memberIds;
        RebuildIndexes();
        _selectedAssetIds.Clear();
        _hasChanges = true;
        Snackbar.Add("그룹이 생성되었습니다.", Severity.Success);
    }

    private void DeleteGroup(int groupId)
    {
        _groups.RemoveAll(g => g.Id == groupId);
        _groupMembers.Remove(groupId);
        _expandedGroupIds.Remove(groupId);
        RebuildIndexes();
        _hasChanges = true;
    }

    private void RemoveFromGroup(int groupId, int assetId)
    {
        if (_groupMembers.TryGetValue(groupId, out var members))
        {
            members.Remove(assetId);
            if (members.Count == 0)
            {
                _groups.RemoveAll(g => g.Id == groupId);
                _groupMembers.Remove(groupId);
                _expandedGroupIds.Remove(groupId);
            }
        }
        RebuildIndexes();
        _hasChanges = true;
    }

    // ═══════════════ Align ═══════════════

    private void AlignSelected(string mode)
    {
        if (_selectedAssetIds.Count < 2) return;
        var ids = _selectedAssetIds.OrderBy(id => _allAssets.FirstOrDefault(a => a.AssetId == id)?.Name ?? "").ToList();
        int count = ids.Count;
        double cx = 0, cy = 0;
        foreach (var id in ids) { var p = GetPosition(id); cx += p.X; cy += p.Y; }
        cx /= count; cy /= count;
        var cellW = 32.0 * _globalScale + 12;
        var cellH = 32.0 * _globalScale + 24;

        switch (mode)
        {
            case "grid":
                var cols = (int)Math.Ceiling(Math.Sqrt(count));
                var totalW = cols * cellW;
                var totalRows = (int)Math.Ceiling((double)count / cols);
                var baseX = Math.Max(0, cx - totalW / 2);
                var baseY = Math.Max(0, cy - totalRows * cellH / 2);
                for (int i = 0; i < count; i++)
                { var pos = GetPosition(ids[i]); pos.X = Math.Round(baseX + (i % cols) * cellW, 2); pos.Y = Math.Round(baseY + (i / cols) * cellH, 2); }
                break;
            case "row":
                var bx = Math.Max(0, cx - count * cellW / 2);
                for (int i = 0; i < count; i++)
                { var pos = GetPosition(ids[i]); pos.X = Math.Round(bx + i * cellW, 2); pos.Y = Math.Round(cy, 2); }
                break;
            case "col":
                var by = Math.Max(0, cy - count * cellH / 2);
                for (int i = 0; i < count; i++)
                { var pos = GetPosition(ids[i]); pos.X = Math.Round(cx, 2); pos.Y = Math.Round(by + i * cellH, 2); }
                break;
        }
        _hasChanges = true;
        Snackbar.Add($"{count}개 정렬됨", Severity.Success);
    }

    // ═══════════════ Apply ═══════════════

    private async Task ApplyChangesAsync()
    {
        _saving = true;
        try
        {
            var toSave = _positions.Values.Where(p => p.Visible).ToList();
            foreach (var p in toSave) p.LayoutId = LayoutId;
            if (toSave.Count > 0)
                await TwmDb.UpsertAssetPositionBatchAsync(toSave);

            await TwmDb.DeleteAllPlacementGroupsAsync(LayoutId);

            foreach (var grp in _groups)
            {
                grp.LayoutId = LayoutId;
                var oldId = grp.Id;
                var newId = await TwmDb.InsertPlacementGroupAsync(grp);
                grp.Id = newId;
                if (_groupMembers.TryGetValue(oldId, out var memberIds))
                {
                    await TwmDb.SetPlacementGroupMembersAsync(newId, memberIds);
                    _groupMembers.Remove(oldId);
                    _groupMembers[newId] = memberIds;
                }
            }

            _hasChanges = false;
            _nextTempGroupId = -1;
            LayoutNotification.NotifyLayoutChanged(LayoutId);
            Snackbar.Add($"{toSave.Count}개 자산, {_groups.Count}개 그룹 적용됨", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"적용 오류: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    // ═══════════════ Dispose ═══════════════

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("assetPlacementEditor.dispose", "ap-editor-container"); }
        catch (JSDisconnectedException) { }
        _dotNetRef?.Dispose();
    }

