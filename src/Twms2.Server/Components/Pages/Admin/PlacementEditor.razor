    private TwmsAssetPosition GetPosition(int assetId)
    {
        if (_positions.TryGetValue(assetId, out var pos)) return pos;
        var newPos = new TwmsAssetPosition { LayoutId = LayoutId, AssetId = assetId, X = 100, Y = 100 };
        _positions[assetId] = newPos;
