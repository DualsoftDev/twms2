    private List<AssetStatusInfo> UnplacedAssets
    {
        get
        {
            var result = _allAssets.Where(a => !GetPosition(a.AssetId).Visible && !_groupedAssetIds.Contains(a.AssetId));
            if (!_includeOtherLayouts)
                result = result.Where(a => !_placedOnOtherLayouts.Contains(a.AssetId));
            if (_selectedLineId.HasValue)
                result = _selectedLineId.Value == -1
                    ? result.Where(a => !a.AugLineId.HasValue)
                    : result.Where(a => a.AugLineId == _selectedLineId.Value);
            if (!string.IsNullOrWhiteSpace(_searchText))
                result = result.Where(a =>
                    (a.Name?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (a.Ip?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
            return result.ToList();
        }
    }

    private List<AssetStatusInfo> PlacedUngroupedAssets =>
        _allAssets.Where(a => GetPosition(a.AssetId).Visible && !_groupedAssetIds.Contains(a.AssetId)).ToList();

    private string SelectedLabel
    {
        get
        {
            var parts = new List<string>();
            if (_selectedAssetIds.Count > 0)
            {
                var names = _selectedAssetIds
                    .Select(id => _allAssets.FirstOrDefault(a => a.AssetId == id)?.Name ?? $"#{id}")
                    .OrderBy(n => n);
                parts.Add(string.Join(", ", names));
            }
            if (_selectedGroupIds.Count > 0)
            {
                var grpNames = _selectedGroupIds
                    .Select(id => _groups.FirstOrDefault(g => g.Id == id))
                    .Where(g => g != null)
                    .Select(g => string.IsNullOrEmpty(g!.Name) ? $"그룹 #{g.Id}" : g.Name);
                parts.Add(string.Join(", ", grpNames));
            }
            return string.Join(", ", parts);
        }
    }

