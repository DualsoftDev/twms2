    [JSInvokable]
    public void OnBulkMoved(List<JsAssetPos> positions, List<JsGroupPos> groups)
    {
        PushUndo();
        foreach (var gp in groups)
        {
            var grp = _groups.FirstOrDefault(g => g.Id == gp.GroupId);
            if (grp != null)
            {
                grp.X = gp.X; grp.Y = gp.Y; grp.Width = gp.W; grp.Height = gp.H;
            }
        }
        foreach (var jp in positions)
        {
            var pos = GetPosition(jp.AssetId);
            pos.X = jp.X;
            pos.Y = jp.Y;
        }
        _hasChanges = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnAssetDroppedOnGroup(int assetId, int groupId)
    {
        if (_groupMembers.TryGetValue(groupId, out var members) && members.Contains(assetId)) return;

        // Remove from previous group
        foreach (var (gid, mems) in _groupMembers)
        {
            if (mems.Remove(assetId))
            {
                if (mems.Count == 0)
                {
                    _groups.RemoveAll(g => g.Id == gid);
                    _groupMembers.Remove(gid);
                }
                break;
            }
        }

        if (!_groupMembers.TryGetValue(groupId, out members))
        {
            members = [];
            _groupMembers[groupId] = members;
        }
        members.Add(assetId);
        RebuildIndexes();
        _hasChanges = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnAssetRemovedFromGroup(int assetId, int groupId)
    {
        if (!_groupMembers.TryGetValue(groupId, out var members)) return;
        if (!members.Remove(assetId)) return;
        if (members.Count == 0)
        {
            _groups.RemoveAll(g => g.Id == groupId);
            _groupMembers.Remove(groupId);
        }
        RebuildIndexes();
        _hasChanges = true;
        InvokeAsync(StateHasChanged);
    }

