            pos.X = jp.X;
            pos.Y = jp.Y;
        }
        _hasChanges = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnGroupMoved(int groupId, double x, double y, double w, double h)
    {
        PushUndo();
        var grp = _groups.FirstOrDefault(g => g.Id == groupId);
        if (grp != null)
        {
            grp.X = x; grp.Y = y; grp.Width = w; grp.Height = h;
            _hasChanges = true;
        }
        InvokeAsync(StateHasChanged);
