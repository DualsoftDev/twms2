        await InvokeAsync(StateHasChanged);

        try
        {
            if (assetIds.Length > 0)
                await JS.InvokeVoidAsync("assetPlacementEditor.scrollListAssetIntoView", assetIds[0]);
            else if (groupIds.Length > 0)
                await JS.InvokeVoidAsync("assetPlacementEditor.scrollListGroupIntoView", groupIds[0]);
        }
        catch (JSDisconnectedException) { }
    }

