    private void ToggleCheck(int assetId)
    {
        if (!_checkedAssetIds.Remove(assetId))
        {
            _checkedAssetIds.Add(assetId);
            PlaceAssetIndividually(assetId);
        }
    }

    private void PlaceAssetIndividually(int assetId)
    {
        var pos = GetPosition(assetId);
        if (pos.Visible) return;

        PushUndo();
        var idx = _checkedAssetIds.Count - 1;
        var cols = 5;
        var spacing = 32.0 * _globalScale + 12;
        var col = idx % cols;
        var row = idx / cols;
        pos.Visible = true;
        pos.Scale = _globalScale;
        pos.X = Math.Round(40 + col * spacing, 2);
        pos.Y = Math.Round(40 + row * spacing, 2);
        _hasChanges = true;
    }

    private void UnplaceAsset(int assetId)
    {
        var pos = GetPosition(assetId);
        pos.Visible = false;
        // Remove from groups
        foreach (var (gid, members) in _groupMembers)
        {
            if (members.Remove(assetId))
            {
                if (members.Count == 0)
                {
                    _groups.RemoveAll(g => g.Id == gid);
                    _groupMembers.Remove(gid);
                }
                break;
            }
        }
        RebuildIndexes();
        _hasChanges = true;
    }

    // ═══════════════ Group Management ═══════════════

    private void ToggleGroupExpand(int groupId)
    {
        if (!_expandedGroupIds.Remove(groupId))
            _expandedGroupIds.Add(groupId);
    }

    private void CreateGroupFromSelection()
    {
        if (_selectedAssetIds.Count < 2) return;
        PushUndo();
        var memberIds = _selectedAssetIds.ToList();

        // Bounding box from positions
        double minX = double.MaxValue, minY = double.MaxValue;
        double maxX = double.MinValue, maxY = double.MinValue;
        foreach (var id in memberIds)
        {
            var p = GetPosition(id);
            var sz = 32.0 * p.Scale;
            minX = Math.Min(minX, p.X); minY = Math.Min(minY, p.Y);
            maxX = Math.Max(maxX, p.X + sz); maxY = Math.Max(maxY, p.Y + sz + 14);
        }

        var pad = 14.0;
        var tempId = _nextTempGroupId--;
        _groups.Add(new TwmsPlacementGroup
        {
            Id = tempId, LayoutId = LayoutId, Name = "그룹",
            X = Math.Round(minX - pad, 2), Y = Math.Round(minY - pad - 14, 2),
            Width = Math.Round(maxX - minX + pad * 2, 2),
            Height = Math.Round(maxY - minY + pad * 2 + 14, 2),
        });
        _groupMembers[tempId] = memberIds;
        RebuildIndexes();
        _selectedAssetIds.Clear();
        _hasChanges = true;
        Snackbar.Add("그룹이 생성되었습니다.", Severity.Success);
    }

    private void DeleteGroup(int groupId)
    {
        _groups.RemoveAll(g => g.Id == groupId);
        _groupMembers.Remove(groupId);
        _expandedGroupIds.Remove(groupId);
        RebuildIndexes();
        _hasChanges = true;
    }

    private void OnGroupFloorChanged(TwmsPlacementGroup group, int newFloor)
    {
        if (newFloor == 0) newFloor = 1;
        if (group.Floor == newFloor) return;
        PushUndo();
        group.Floor = newFloor;
        _hasChanges = true;
    }

    private int? SelectedGroupsSharedFloor
    {
        get
        {
            var floors = _groups.Where(g => _selectedGroupIds.Contains(g.Id))
                                .Select(g => g.Floor)
                                .Distinct()
                                .Take(2)
                                .ToList();
            return floors.Count == 1 ? floors[0] : null;
        }
    }

    private void OnSelectedGroupsFloorChanged(int? newFloor)
    {
        if (newFloor is null) return;
        var f = newFloor.Value == 0 ? 1 : newFloor.Value;
        var targets = _groups.Where(g => _selectedGroupIds.Contains(g.Id) && g.Floor != f).ToList();
        if (targets.Count == 0) return;
        PushUndo();
        foreach (var g in targets) g.Floor = f;
        _hasChanges = true;
    }

    private void RemoveFromGroup(int groupId, int assetId)
    {
        if (_groupMembers.TryGetValue(groupId, out var members))
        {
            members.Remove(assetId);
            if (members.Count == 0)
            {
                _groups.RemoveAll(g => g.Id == groupId);
                _groupMembers.Remove(groupId);
                _expandedGroupIds.Remove(groupId);
            }
        }
        RebuildIndexes();
        _hasChanges = true;
    }

    // ═══════════════ Align ═══════════════

    private void AlignSelected(string mode)
    {
        if (_selectedAssetIds.Count < 2) return;
        var ids = _selectedAssetIds.OrderBy(id => _allAssets.FirstOrDefault(a => a.AssetId == id)?.Name ?? "").ToList();
        int count = ids.Count;
        double cx = 0, cy = 0;
        foreach (var id in ids) { var p = GetPosition(id); cx += p.X; cy += p.Y; }
        cx /= count; cy /= count;
        var cellW = 32.0 * _globalScale + 12;
        var cellH = 32.0 * _globalScale + 24;

        switch (mode)
        {
            case "grid":
                var cols = (int)Math.Ceiling(Math.Sqrt(count));
                var totalW = cols * cellW;
                var totalRows = (int)Math.Ceiling((double)count / cols);
                var baseX = Math.Max(0, cx - totalW / 2);
                var baseY = Math.Max(0, cy - totalRows * cellH / 2);
                for (int i = 0; i < count; i++)
                { var pos = GetPosition(ids[i]); pos.X = Math.Round(baseX + (i % cols) * cellW + cellW / 2, 2); pos.Y = Math.Round(baseY + (i / cols) * cellH + cellH / 2, 2); }
                break;
            case "row":
                var bx = Math.Max(0, cx - count * cellW / 2);
                for (int i = 0; i < count; i++)
                { var pos = GetPosition(ids[i]); pos.X = Math.Round(bx + i * cellW + cellW / 2, 2); pos.Y = Math.Round(cy, 2); }
                break;
            case "col":
                var by = Math.Max(0, cy - count * cellH / 2);
                for (int i = 0; i < count; i++)
                { var pos = GetPosition(ids[i]); pos.X = Math.Round(cx, 2); pos.Y = Math.Round(by + i * cellH + cellH / 2, 2); }
                break;
        }
        _hasChanges = true;
        Snackbar.Add($"{count}개 정렬됨", Severity.Success);
    }

    // ═══════════════ Undo / Redo ═══════════════

    private void PushUndo()
    {
        var snap = new EditorSnapshot(
            _positions.ToDictionary(kv => kv.Key, kv => (kv.Value.X, kv.Value.Y, kv.Value.Scale, kv.Value.Visible)),
            _groups.Select(g => (g.Id, g.Name, g.X, g.Y, g.Width, g.Height, g.Color, g.Floor)).ToList(),
            _groupMembers.ToDictionary(kv => kv.Key, kv => kv.Value.ToList()));
        _undoStack.Add(snap);
        if (_undoStack.Count > MaxUndoSteps) _undoStack.RemoveAt(0);
        _redoStack.Clear();
    }

    private void Undo()
    {
        if (_undoStack.Count == 0) return;
        // Save current state to redo
        var current = new EditorSnapshot(
            _positions.ToDictionary(kv => kv.Key, kv => (kv.Value.X, kv.Value.Y, kv.Value.Scale, kv.Value.Visible)),
            _groups.Select(g => (g.Id, g.Name, g.X, g.Y, g.Width, g.Height, g.Color, g.Floor)).ToList(),
            _groupMembers.ToDictionary(kv => kv.Key, kv => kv.Value.ToList()));
        _redoStack.Add(current);

        var snap = _undoStack[^1];
        _undoStack.RemoveAt(_undoStack.Count - 1);
        RestoreSnapshot(snap);
    }

    private void Redo()
    {
        if (_redoStack.Count == 0) return;
        var current = new EditorSnapshot(
            _positions.ToDictionary(kv => kv.Key, kv => (kv.Value.X, kv.Value.Y, kv.Value.Scale, kv.Value.Visible)),
            _groups.Select(g => (g.Id, g.Name, g.X, g.Y, g.Width, g.Height, g.Color, g.Floor)).ToList(),
            _groupMembers.ToDictionary(kv => kv.Key, kv => kv.Value.ToList()));
        _undoStack.Add(current);

        var snap = _redoStack[^1];
        _redoStack.RemoveAt(_redoStack.Count - 1);
        RestoreSnapshot(snap);
    }

    private void RestoreSnapshot(EditorSnapshot snap)
    {
        foreach (var (aid, (x, y, scale, vis)) in snap.Positions)
        {
            var pos = GetPosition(aid);
            pos.X = x; pos.Y = y; pos.Scale = scale; pos.Visible = vis;
        }
        _groups = snap.Groups.Select(g => new TwmsPlacementGroup
        {
            Id = g.Id, LayoutId = LayoutId, Name = g.Name,
            X = g.X, Y = g.Y, Width = g.W, Height = g.H, Color = g.Color, Floor = g.Floor
        }).ToList();
        _groupMembers = snap.Members.ToDictionary(kv => kv.Key, kv => kv.Value.ToList());
        RebuildIndexes();
        _selectedAssetIds.Clear();
        _selectedGroupIds.Clear();
        _hasChanges = true;
    }

    // ═══════════════ 키보드 콜백 ═══════════════

    [JSInvokable]
    public void OnKeyAction(string action)
    {
        switch (action)
        {
            case "delete":
                PushUndo();
                UnplaceSelected();
                break;
            case "undo":
                Undo();
                break;
            case "redo":
                Redo();
                break;
            case "escape":
                _selectedAssetIds.Clear();
                _selectedGroupIds.Clear();
                break;
            case "selectAll":
                _selectedAssetIds = new HashSet<int>(
                    _allAssets.Where(a => GetPosition(a.AssetId).Visible).Select(a => a.AssetId));
                break;
            case "group":
                if (_selectedAssetIds.Count > 1)
                {
                    PushUndo();
                    CreateGroupFromSelection();
                }
                break;
        }
        InvokeAsync(StateHasChanged);
    }

    // ═══════════════ 균등 분배 ═══════════════

    private void DistributeSelected(string axis)
    {
        if (_selectedAssetIds.Count < 3) return;
        var ids = _selectedAssetIds.ToList();

        if (axis == "h")
        {
            ids = ids.OrderBy(id => GetPosition(id).X).ToList();
            var first = GetPosition(ids[0]).X;
            var last = GetPosition(ids[^1]).X;
            var step = (last - first) / (ids.Count - 1);
            for (int i = 1; i < ids.Count - 1; i++)
                GetPosition(ids[i]).X = Math.Round(first + i * step, 2);
        }
        else
        {
            ids = ids.OrderBy(id => GetPosition(id).Y).ToList();
            var first = GetPosition(ids[0]).Y;
            var last = GetPosition(ids[^1]).Y;
            var step = (last - first) / (ids.Count - 1);
            for (int i = 1; i < ids.Count - 1; i++)
                GetPosition(ids[i]).Y = Math.Round(first + i * step, 2);
        }
        _hasChanges = true;
        Snackbar.Add($"{ids.Count}개 균등 분배됨", Severity.Success);
    }

    // ═══════════════ 일괄 미배치 ═══════════════

    private void UnplaceSelected()
    {
        var count = 0;
        // 선택된 개별 자산 미배치
        foreach (var aid in _selectedAssetIds)
        {
            var pos = GetPosition(aid);
            if (pos.Visible) { pos.Visible = false; count++; }
            foreach (var (gid, members) in _groupMembers)
            {
                if (members.Remove(aid) && members.Count == 0)
                {
                    _groups.RemoveAll(g => g.Id == gid);
                    _groupMembers.Remove(gid);
                }
            }
        }
        // 선택된 그룹 해체 (그룹만 삭제, 멤버 자산은 개별 배치 유지)
        foreach (var gid in _selectedGroupIds)
        {
            _groups.RemoveAll(g => g.Id == gid);
            _groupMembers.Remove(gid);
            count++;
        }
        _selectedAssetIds.Clear();
        _selectedGroupIds.Clear();
        RebuildIndexes();
        _hasChanges = true;
        if (count > 0) Snackbar.Add($"{count}개 제거됨", Severity.Success);
    }

    // ═══════════════ 캔버스 필터 ═══════════════

    private void SetDisplayFilter(string? filter) { _displayFilter = filter; }

    // ═══════════════ 캔버스 포커스 ═══════════════

    private async Task FocusAssetOnCanvas(int assetId)
    {
        _selectedAssetIds = [assetId];
        _selectedGroupIds.Clear();
        try { await JS.InvokeVoidAsync("assetPlacementEditor.scrollToAsset", "ap-editor-container", assetId); }
        catch (JSDisconnectedException) { }
    }

    // ═══════════════ 전체 선택/해제 ═══════════════

    private void ToggleCheckAll(bool check)
    {
        if (check)
        {
            PushUndo();
            var unplaced = UnplacedAssets;
            var spacing = 32.0 * _globalScale + 12;
            var cols = 5;
            for (int i = 0; i < unplaced.Count; i++)
            {
                var a = unplaced[i];
                _checkedAssetIds.Add(a.AssetId);
                var pos = GetPosition(a.AssetId);
                if (!pos.Visible)
                {
                    pos.Visible = true;
                    pos.Scale = _globalScale;
                    pos.X = Math.Round(40 + (i % cols) * spacing, 2);
                    pos.Y = Math.Round(40 + (i / cols) * spacing, 2);
                }
            }
            _hasChanges = true;
        }
        else
        {
            _checkedAssetIds.Clear();
        }
    }

    // ═══════════════ Apply ═══════════════

    private async Task ApplyChangesAsync()
    {
        _saving = true;
        try
        {
            // 적용 전 스냅샷 저장
            var snapData = new EditorSnapshot(
                _positions.ToDictionary(kv => kv.Key, kv => (kv.Value.X, kv.Value.Y, kv.Value.Scale, kv.Value.Visible)),
                _groups.Select(g => (g.Id, g.Name, g.X, g.Y, g.Width, g.Height, g.Color, g.Floor)).ToList(),
                _groupMembers.ToDictionary(kv => kv.Key, kv => kv.Value.ToList()));
            _snapshots.Insert(0, new LayoutSnapshot(DateTime.Now, snapData));
            if (_snapshots.Count > 10) _snapshots.RemoveRange(10, _snapshots.Count - 10);

            var toSave = _positions.Values.Where(p => p.Visible).ToList();
            foreach (var p in toSave) p.LayoutId = LayoutId;
            if (toSave.Count > 0)
                await LayoutDb.UpsertAssetPositionBatchAsync(toSave);

            await LayoutDb.DeleteAllPlacementGroupsAsync(LayoutId);

            foreach (var grp in _groups)
            {
                grp.LayoutId = LayoutId;
                var oldId = grp.Id;
                var newId = await LayoutDb.InsertPlacementGroupAsync(grp);
                grp.Id = newId;
                if (_groupMembers.TryGetValue(oldId, out var memberIds))
                {
                    await LayoutDb.SetPlacementGroupMembersAsync(newId, memberIds);
                    _groupMembers.Remove(oldId);
                    _groupMembers[newId] = memberIds;
                }
            }

            _hasChanges = false;
            _nextTempGroupId = -1;
            LayoutNotification.NotifyLayoutChanged(LayoutId);
            Snackbar.Add($"{toSave.Count}개 자산, {_groups.Count}개 그룹 적용됨", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"적용 오류: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }

    // ═══════════════ 스냅샷 복원 ═══════════════

    private void RestoreLayoutSnapshot(LayoutSnapshot snapshot)
    {
        PushUndo();
        RestoreSnapshot(snapshot.Data);
        Snackbar.Add($"{snapshot.CreatedAt:HH:mm} 시점으로 복원됨", Severity.Success);
    }

    // ═══════════════ Dispose ═══════════════

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("assetPlacementEditor.dispose", "ap-editor-container"); }
        catch (JSDisconnectedException) { }
        _dotNetRef?.Dispose();
    }

    public record JsAssetPos(int AssetId, double X, double Y);
    public record JsGroupPos(int GroupId, double X, double Y, double W, double H);
}
