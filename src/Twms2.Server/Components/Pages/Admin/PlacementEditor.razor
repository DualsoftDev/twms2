@using static Twms2.Server.Helpers.LayoutHelpers
@inject LayoutDbService LayoutDb
@inject AssetStatusService AssetStatusService
@inject LayoutNotificationService LayoutNotification
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    @* ── 툴바 ── *@
    <MudPaper Class="pa-2 mb-2 d-flex align-center gap-2 flex-wrap" Elevation="1">
        <MudToggleIconButton Toggled="@(_activeTool == "pan")"
                             Icon="@Icons.Material.Filled.NearMe"
                             ToggledIcon="@Icons.Material.Filled.PanTool"
                             Size="Size.Small" Color="Color.Default" ToggledColor="Color.Primary"
                             ToggledChanged="@(v => SetTool(v ? "pan" : "select"))" />
        <MudDivider Vertical="true" FlexItem="true" />
        <MudToggleIconButton Toggled="_snapEnabled"
                             Icon="@Icons.Material.Filled.GridOff"
                             ToggledIcon="@Icons.Material.Filled.Grid4x4"
                             Size="Size.Small" Color="Color.Default" ToggledColor="Color.Info"
                             ToggledChanged="OnSnapToggled" />
        <MudNumericField T="int" Value="_snapGridSize" ValueChanged="OnSnapGridChanged"
                         Label="Grid" Variant="Variant.Text" Min="5" Max="100" Step="5"
                         Style="width: 60px;" Margin="Margin.Dense" HideSpinButtons="true" />
        <MudDivider Vertical="true" FlexItem="true" />
        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="ZoomOut" />
        <MudText Typo="Typo.caption" Style="min-width: 40px; text-align: center;">@(_zoomPercent)%</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="ZoomIn" />
        <MudIconButton Icon="@Icons.Material.Filled.CenterFocusWeak" Size="Size.Small" OnClick="ZoomReset" />
        <MudIconButton Icon="@Icons.Material.Filled.FitScreen" Size="Size.Small" OnClick="ZoomFit" />
        <MudDivider Vertical="true" FlexItem="true" />
        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                       Disabled="@(_undoStack.Count == 0)" OnClick="@(() => { Undo(); })" />
        <MudIconButton Icon="@Icons.Material.Filled.Redo" Size="Size.Small"
                       Disabled="@(_redoStack.Count == 0)" OnClick="@(() => { Redo(); })" />
        <MudDivider Vertical="true" FlexItem="true" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="ml-2" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.AspectRatio" Size="Size.Small" />
            <MudNumericField T="double" Value="_globalScale" ValueChanged="OnGlobalScaleChanged"
                             Min="0.1" Max="5.0" Step="0.01" Format="F2"
                             Variant="Variant.Text" Margin="Margin.Dense"
                             Style="width: 60px;" HideSpinButtons="true" />
            <MudSlider T="double" Value="_globalScale" ValueChanged="OnGlobalScaleChanged"
                       Min="0.1" Max="5.0" Step="0.01" Style="width: 160px;" />
        </MudStack>
        <MudSpacer />
        @if (_selectedAssetIds.Count + _selectedGroupIds.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Primary" Style="max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                @SelectedLabel
            </MudText>
            @if (_selectedAssetIds.Count > 1)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.GroupWork" OnClick="CreateGroupFromSelection">
                    그룹화
                </MudButton>
                <MudMenu Icon="@Icons.Material.Filled.ViewModule" Size="Size.Small"
                         Variant="Variant.Outlined" Color="Color.Info">
                    <MudMenuItem OnClick="@(() => AlignSelected("grid"))">그리드 정렬</MudMenuItem>
                    <MudMenuItem OnClick="@(() => AlignSelected("row"))">가로 정렬</MudMenuItem>
                    <MudMenuItem OnClick="@(() => AlignSelected("col"))">세로 정렬</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="@(() => DistributeSelected("h"))">가로 균등 분배</MudMenuItem>
                    <MudMenuItem OnClick="@(() => DistributeSelected("v"))">세로 균등 분배</MudMenuItem>
                </MudMenu>
            }
            @if (_selectedGroupIds.Count > 0)
            {
                <span class="ap-floor-input">
                    <MudNumericField T="int?" Value="SelectedGroupsSharedFloor"
                                     ValueChanged="OnSelectedGroupsFloorChanged"
                                     Min="-20" Max="100" Step="1"
                                     HideSpinButtons="true" Margin="Margin.Dense"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.End" AdornmentText="층"
                                     Placeholder="혼합"
                                     Style="width: 80px;" />
                </span>
            }
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete" OnClick="UnplaceSelected">
                삭제
            </MudButton>
        }
        @if (_snapshots.Count > 0)
        {
            <MudMenu Icon="@Icons.Material.Filled.History" Size="Size.Small" Dense="true">
                @foreach (var snap in _snapshots.Take(5))
                {
                    var s = snap;
                    <MudMenuItem OnClick="@(() => RestoreLayoutSnapshot(s))">
                        복원: @s.CreatedAt.ToString("MM/dd HH:mm")
                    </MudMenuItem>
                }
            </MudMenu>
        }
        @if (_hasChanges)
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text">변경됨</MudChip>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Check"
                   OnClick="ApplyChangesAsync" Disabled="@(_saving || !_hasChanges)">
            @(_saving ? "적용 중..." : "적용")
        </MudButton>
    </MudPaper>

    @* ── 메인 레이아웃: 좌측 패널 + 캔버스 ── *@
    <div class="ap-editor-layout">
        @* ── 좌측 패널 ── *@
        <div class="ap-left-panel">
            @* 검색 + 라인 필터 *@
            <MudTextField @bind-Value="_searchText" Placeholder="자산 검색..."
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Class="mb-2" Margin="Margin.Dense" />
            <MudSelect T="int?" Value="_selectedLineId" ValueChanged="@(v => _selectedLineId = v)"
                       Label="라인" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mb-2">
                <MudSelectItem T="int?" Value="@((int?)null)">전체</MudSelectItem>
                @foreach (var line in _lines)
                {
                    <MudSelectItem T="int?" Value="@((int?)line.Key)">@line.Value</MudSelectItem>
                }
                <MudSelectItem T="int?" Value="@((int?)-1)">미지정</MudSelectItem>
            </MudSelect>

            @* 캔버스 필터 *@
            <MudStack Row="true" Spacing="1" Class="mb-2">
                <MudMenu Label="표시" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                         StartIcon="@Icons.Material.Filled.FilterAlt" Dense="true">
                    <MudMenuItem OnClick="@(() => SetDisplayFilter(null))">
                        @(_displayFilter == null ? "● " : "")전체 표시
                    </MudMenuItem>
                    @foreach (var typeName in _allAssets.Select(a => a.AssetTypeName).Where(t => t != null).Distinct().OrderBy(t => t))
                    {
                        var t = typeName!;
                        <MudMenuItem OnClick="@(() => SetDisplayFilter(t))">
                            @(_displayFilter == t ? "● " : "")@t 만
                        </MudMenuItem>
                    }
                </MudMenu>
            </MudStack>

            @* 미배치 자산 목록 *@
            <div class="ap-panel-section">
                <div class="d-flex align-center gap-1 mb-1">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                        미배치 (@UnplacedAssets.Count)
                    </MudText>
                    <MudSpacer />
                    <MudCheckBox T="bool" Value="_includeOtherLayouts"
                                 ValueChanged="@((bool v) => { _includeOtherLayouts = v; _checkedAssetIds.Clear(); })"
                                 Size="Size.Small" Color="Color.Info"
                                 Label="다른도면포함" />
                    @if (UnplacedAssets.Count > 0)
                    {
                        <MudCheckBox T="bool" Value="@(_checkedAssetIds.Count > 0 && _checkedAssetIds.Count >= UnplacedAssets.Count)"
                                     ValueChanged="ToggleCheckAll" Size="Size.Small" Color="Color.Success"
                                     Label="전체" />
                    }
                </div>
                <div class="ap-asset-list">
                    @foreach (var asset in UnplacedAssets)
                    {
                        var isChecked = _checkedAssetIds.Contains(asset.AssetId);
                        <div class="ap-list-item @(isChecked ? "checked" : "")"
                             data-list-asset-id="@asset.AssetId"
                             @onclick="() => ToggleCheck(asset.AssetId)">
                            <MudCheckBox T="bool" Value="isChecked" Size="Size.Small" Color="Color.Success"
                                         ValueChanged="@(v => ToggleCheck(asset.AssetId))"
                                         @onclick:stopPropagation="true" />
                            <img src="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                                 class="asset-type-icon-sm" />
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="ap-list-name">@asset.Name</div>
                                <div class="ap-list-sub">
                                    @asset.Ip
                                    @if (!string.IsNullOrEmpty(asset.LayoutLineName))
                                    {
                                        <span class="ap-line-tag">@asset.LayoutLineName</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* 그룹 목록 *@
            @if (_groups.Count > 0)
            {
                <div class="ap-panel-section">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-1">
                        그룹 (@_groups.Count)
                    </MudText>
                    <div class="ap-group-list">
                        @foreach (var grp in _groups)
                        {
                            var isExpanded = _expandedGroupIds.Contains(grp.Id);
                            var isGrpSel = _selectedGroupIds.Contains(grp.Id);
                            var memberIds = GetGroupMemberIds(grp.Id);
                            <div class="ap-group-item @(isGrpSel ? "selected" : "")" data-list-group-id="@grp.Id">
                                <div class="ap-group-header" @onclick="() => ToggleGroupExpand(grp.Id)">
                                    <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                             Size="Size.Small" />
                                    <span class="ap-group-color" style="background: @(grp.Color ?? "#4a90d9")"></span>
                                    <span class="flex-grow-1 ap-list-name" style="font-size: 0.75rem;">
                                        @GetGroupDisplayLabel(grp.Id, memberIds)
                                    </span>
                                    <span @onclick:stopPropagation="true" class="ap-floor-input">
                                        <MudNumericField T="int" Value="grp.Floor"
                                                         ValueChanged="@((int v) => OnGroupFloorChanged(grp, v))"
                                                         Min="-20" Max="100" Step="1"
                                                         HideSpinButtons="true" Margin="Margin.Dense"
                                                         Variant="Variant.Outlined"
                                                         Adornment="Adornment.End" AdornmentText="층"
                                                         Style="width: 64px;" />
                                    </span>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@memberIds.Count</MudText>
                                    <span @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="() => DeleteGroup(grp.Id)" />
                                    </span>
                                </div>
                                @if (isExpanded)
                                {
                                    <div class="ap-group-members">
                                        @foreach (var aid in memberIds)
                                        {
                                            var asset = _allAssets.FirstOrDefault(a => a.AssetId == aid);
                                            if (asset == null) continue;
                                            <div class="ap-list-item small"
                                                 data-list-asset-id="@asset.AssetId">
                                                <img src="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                                                     class="asset-type-icon-sm" />
                                                <span class="flex-grow-1 ap-list-name">@asset.Name</span>
                                                <span @onclick:stopPropagation="true">
                                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                                   Size="Size.Small" Color="Color.Warning"
                                                                   OnClick="() => RemoveFromGroup(grp.Id, aid)" />
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @* 배치된 자산 목록 *@
            <div class="ap-panel-section">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-1">
                    배치됨 (@PlacedUngroupedAssets.Count)
                </MudText>
                <div class="ap-asset-list">
                    @foreach (var asset in PlacedUngroupedAssets)
                    {
                        var isSel = _selectedAssetIds.Contains(asset.AssetId);
                        var a = asset;
                        <div class="ap-list-item @(isSel ? "selected" : "")"
                             data-list-asset-id="@asset.AssetId"
                             @onclick="() => FocusAssetOnCanvas(a.AssetId)">
                            <img src="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                                 class="asset-type-icon-sm" />
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="ap-list-name">@asset.Name</div>
                                <div class="ap-list-sub">@asset.Ip</div>
                            </div>
                            <span @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small"
                                               Color="Color.Secondary" OnClick="() => UnplaceAsset(asset.AssetId)" />
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── 캔버스 ── *@
        <div class="ap-canvas-area">
            <div id="ap-editor-container" class="ap-canvas-container">
                <svg id="ap-editor-svg" class="ap-canvas-svg" viewBox="0 0 1000 600"
                     preserveAspectRatio="xMidYMid meet">
                    <defs>
                        <pattern id="ap-grid-sm" width="@_snapGridSize" height="@_snapGridSize" patternUnits="userSpaceOnUse">
                            <path d="M @_snapGridSize 0 L 0 0 0 @_snapGridSize" fill="none"
                                  stroke="#e0e0e0" stroke-width="0.3" opacity="0.3" />
                        </pattern>
                        <pattern id="ap-grid-lg" width="@(_snapGridSize * 5)" height="@(_snapGridSize * 5)" patternUnits="userSpaceOnUse">
                            <rect width="@(_snapGridSize * 5)" height="@(_snapGridSize * 5)" fill="url(#ap-grid-sm)" />
                            <path d="M @(_snapGridSize * 5) 0 L 0 0 0 @(_snapGridSize * 5)" fill="none"
                                  stroke="#ccc" stroke-width="0.5" opacity="0.3" />
                        </pattern>
                        @foreach (var grp in _groups)
                        {
                            <clipPath id="ap-grp-clip-@grp.Id">
                                <rect x="@F(grp.X)" y="@F(grp.Y)"
                                      width="@F(grp.Width)" height="@F(grp.Height)" rx="6" />
                            </clipPath>
                        }
                    </defs>
                    <rect width="1000" height="600" fill="@(_config?.BgColor ?? "#1a1a2e")" />
                    @if (_snapEnabled)
                    {
                        <rect width="1000" height="600" fill="url(#ap-grid-lg)" />
                    }
                    @if (!string.IsNullOrEmpty(_config?.ImagePath))
                    {
                        var ir = CalcImageRect(_config);
                        <image href="@($"/{_config.ImagePath.TrimStart('/')}")"
                               x="@F(ir.X)" y="@F(ir.Y)" width="@F(ir.W)" height="@F(ir.H)"
                               preserveAspectRatio="none" opacity="0.5" />
                    }

                    @* ── 그룹 + 내부 자산 아이콘 ── *@
                    @foreach (var grp in _groups)
                    {
                        var memberIds = GetGroupMemberIds(grp.Id);
                        var memberAssets = GetGroupMemberAssets(grp.Id);
                        var isGrpSel = _selectedGroupIds.Contains(grp.Id);
                        var grpColor = grp.Color ?? "#4a90d9";
                        <g class="ap-group-container @(isGrpSel ? "ap-group-selected" : "")"
                           data-group-id="@grp.Id"
                           data-x="@F(grp.X)" data-y="@F(grp.Y)"
                           data-w="@F(grp.Width)" data-h="@F(grp.Height)"
                           data-members="@string.Join(",", memberIds)">
                            <rect x="@F(grp.X)" y="@F(grp.Y)" width="@F(grp.Width)" height="@F(grp.Height)"
                                  rx="6" fill="@(grpColor)10"
                                  stroke="@grpColor" stroke-width="1.5" stroke-dasharray="6 3" />
                            @* 그룹 내 멤버 자산 아이콘 *@
                            <g clip-path="url(#ap-grp-clip-@grp.Id)">
                                @{
                                    var items = LayoutGroupAssets(grp, memberAssets);
                                }
                                @foreach (var item in items)
                                {
                                    var isSel = _selectedAssetIds.Contains(item.Asset.AssetId);
                                    <g class="ap-asset-icon @(isSel ? "ap-selected" : "")"
                                       data-asset-id="@item.Asset.AssetId"
                                       data-x="@F(item.X + item.Size / 2)" data-y="@F(item.Y + item.Size / 2)"
                                       data-scale="@F(item.Size / 32)"
                                       transform="translate(@F(item.X), @F(item.Y))"
                                       style="cursor: grab;">
                                        <title>@item.Asset.Name</title>
                                        <rect width="@F(item.Size)" height="@F(item.Size)" rx="3"
                                              fill="white" stroke="#ccc" stroke-width="1" opacity="0.9" />
                                        <image href="@GetAssetIcon(item.Asset.AssetTypeName, item.Asset.AugIsRobotPLC)"
                                               width="@F(item.Size - 2)" height="@F(item.Size - 2)" x="1" y="1" />
                                    </g>
                                }
                            </g>
                            @{
                                var rSz = Math.Clamp(Math.Min(grp.Width, grp.Height) * 0.15, 6, 16);
                                var rOff = rSz / 2;
                            }
                            <rect class="ap-group-resize"
                                  x="@F(grp.X + grp.Width - rOff)" y="@F(grp.Y + grp.Height - rOff)"
                                  width="@F(rSz)" height="@F(rSz)" rx="2"
                                  fill="@grpColor" fill-opacity="0.4" />
                        </g>
                    }

                    @* ── 자산 아이콘 (그룹에 속하지 않은 것만) ── *@
                    @foreach (var asset in _allAssets)
                    {
                        if (_groupedAssetIds.Contains(asset.AssetId)) continue;
                        var pos = GetPosition(asset.AssetId);
                        if (!pos.Visible) continue;
                        if (_displayFilter != null && asset.AssetTypeName != _displayFilter) continue;
                        var s = pos.Scale;
                        var sz = 32 * s;
                        var imgSz = 24 * s;
                        var imgOff = 4 * s;
                        var isSel = _selectedAssetIds.Contains(asset.AssetId);

                        <g class="ap-asset-icon @(isSel ? "ap-selected" : "")"
                           data-asset-id="@asset.AssetId"
                           data-x="@F(pos.X)" data-y="@F(pos.Y)"
                           data-scale="@F(s)"
                           transform="translate(@F(pos.X - sz / 2), @F(pos.Y - sz / 2))"
                           style="cursor: grab;">
                            <title>@asset.Name</title>
                            <rect width="@F(sz)" height="@F(sz)" rx="4" fill="white" stroke="#ccc"
                                  stroke-width="1" opacity="0.9" />
                            <image href="@GetAssetIcon(asset.AssetTypeName, asset.AugIsRobotPLC)"
                                   width="@F(imgSz)" height="@F(imgSz)" x="@F(imgOff)" y="@F(imgOff)" />
                        </g>
                    }
                </svg>
            </div>
        </div>
    </div>

    <MudOverlay Visible="_saving" DarkBackground="true" ZIndex="9999" Class="d-flex align-center justify-center">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Primary">적용 중...</MudText>
        </MudStack>
    </MudOverlay>
}

@code {
    [Parameter] public int LayoutId { get; set; }

    // ═══ Loading ═══
    private bool _loading = true;
    private int _prevLayoutId;
    private DotNetObjectReference<PlacementEditor>? _dotNetRef;

    // ═══ Source data ═══
    private List<AssetStatusInfo> _allAssets = [];
    private TwmsBlueprintConfig? _config;
    private Dictionary<int, string> _lines = new();
    private HashSet<int> _placedOnOtherLayouts = new();

    // ═══ Working copies (in-memory) ═══
    private Dictionary<int, TwmsAssetPosition> _positions = new();
    private List<TwmsPlacementGroup> _groups = [];
    private Dictionary<int, List<int>> _groupMembers = new();

    // ═══ Derived indexes ═══
    private HashSet<int> _groupedAssetIds = new();

    // ═══ UI state ═══
    private HashSet<int> _selectedAssetIds = new();
    private HashSet<int> _selectedGroupIds = new();
    private HashSet<int> _checkedAssetIds = new();
    private HashSet<int> _expandedGroupIds = new();
    private string? _searchText;
    private int? _selectedLineId;
    private string? _displayFilter; // null=전체, "PLC"/"HMI" 등
    private bool _includeOtherLayouts;

    // ═══ Snapshots (in-memory, 적용 시 자동 저장) ═══
    private readonly List<LayoutSnapshot> _snapshots = [];
    private record LayoutSnapshot(DateTime CreatedAt, EditorSnapshot Data);

    // ═══ Editor config ═══
    private double _globalScale = 1.0;
    private bool _snapEnabled = true;
    private int _snapGridSize = 20;
    private string _activeTool = "select";
    private int _zoomPercent = 100;

    // ═══ Change tracking ═══
    public bool HasUnsavedChanges => _hasChanges;
    private bool _hasChanges;
    private bool _saving;
    private int _nextTempGroupId = -1;

    // ═══ Undo / Redo ═══
    private readonly List<EditorSnapshot> _undoStack = [];
    private readonly List<EditorSnapshot> _redoStack = [];
    private const int MaxUndoSteps = 30;

    private record EditorSnapshot(
        Dictionary<int, (double X, double Y, double Scale, bool Visible)> Positions,
        List<(int Id, string? Name, double X, double Y, double W, double H, string? Color, int Floor)> Groups,
        Dictionary<int, List<int>> Members);

    // ═══════════════ Lifecycle ═══════════════

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _prevLayoutId = LayoutId;
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (LayoutId != _prevLayoutId && LayoutId > 0)
        {
            _prevLayoutId = LayoutId;
            _jsInitialized = false;
            await LoadDataAsync();
        }
    }

    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_jsInitialized && !_loading)
        {
            _jsInitialized = true;
            await InitEditorJs();
        }
    }

    private async Task LoadDataAsync()
    {
        if (LayoutId == 0) return;
        _loading = true;
        try
        {
            var statusTask = AssetStatusService.GetAssetStatusesAsync();
            var posTask    = LayoutDb.GetAllAssetPositionsAsync(LayoutId);
            var configTask = LayoutDb.GetBlueprintConfigAsync(LayoutId);
            var groupTask  = LayoutDb.GetAllPlacementGroupsAsync(LayoutId);
            var memberTask = LayoutDb.GetPlacementGroupMembersAsync(LayoutId);
            var lineTask   = LayoutDb.GetTwmsLayoutLineMapAsync();
            var otherTask  = LayoutDb.GetAssetIdsPlacedOnOtherLayoutsAsync(LayoutId);
            await Task.WhenAll(statusTask, posTask, configTask, groupTask, memberTask, lineTask, otherTask);

            _allAssets = statusTask.Result;
            _positions = posTask.Result.ToDictionary(p => p.AssetId);
            _config = configTask.Result;
            _groups = groupTask.Result;
            _lines = lineTask.Result;
            _placedOnOtherLayouts = otherTask.Result;
            _groupMembers = memberTask.Result
                .GroupBy(m => m.GroupId)
                .ToDictionary(g => g.Key, g => g.Select(m => m.AssetId).ToList());

            RebuildIndexes();
            _hasChanges = false;
            _nextTempGroupId = -1;

            var scales = _positions.Values.Where(p => p.Scale > 0).Select(p => p.Scale).ToList();
            _globalScale = scales.Count > 0 ? Math.Round(scales.Average(), 1) : 1.0;
        }
        finally { _loading = false; }
    }

