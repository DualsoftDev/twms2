@page "/admin/layout"
@attribute [Authorize(Roles = "Admin")]
@inject LayoutDbService LayoutDb
@inject AssetStatusService AssetStatusService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject LayoutNotificationService LayoutNotification

<PageTitle>TWM - 레이아웃 관리</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/admin" Size="Size.Small" />
    <MudText Typo="Typo.h5" Style="font-weight: 700;">레이아웃 관리</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add" OnClick="CreateLayoutAsync">
        새 레이아웃
    </MudButton>
    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.SwapVert" OnClick="ReorderLayoutsAsync"
               Disabled="_layouts.Count <= 1">
        순서 변경
    </MudButton>
</MudStack>

<MudTable Items="_layouts" Dense="true" Hover="true" Elevation="0"
          Style="border: 1px solid var(--mud-palette-lines-default);">
    <HeaderContent>
        <MudTh Style="width: 50px;">#</MudTh>
        <MudTh>이름</MudTh>
        <MudTh Style="width: 100px;">도면</MudTh>
        <MudTh Style="width: 160px;">수정일</MudTh>
        <MudTh Style="width: 340px;">액션</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="#">@(context.SortOrder + 1)</MudTd>
        <MudTd DataLabel="이름">
            <MudText Typo="Typo.body1" Style="font-weight: 600;">@context.Name</MudText>
        </MudTd>
        <MudTd DataLabel="도면">
            @if (_configMap.TryGetValue(context.Id, out var cfg) && !string.IsNullOrEmpty(cfg.ImagePath))
            {
                <a href="@($"/{cfg.ImagePath.TrimStart('/')}")" target="_blank" style="cursor: pointer;">
                    <img src="@($"/{cfg.ImagePath.TrimStart('/')}")" alt="도면" style="height: 40px; border-radius: 4px; object-fit: cover;" />
                </a>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Small" Color="Color.Default" />
            }
        </MudTd>
        <MudTd DataLabel="수정일">
            @(context.UpdatedAt == default ? "-" : context.UpdatedAt.ToString("yyyy-MM-dd HH:mm"))
        </MudTd>
        <MudTd DataLabel="액션">
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/admin/layout/{context.Id}")">
                    편집
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="@(async () => await DuplicateLayoutAsync(context))">
                    복제
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                           OnClick="@(async () => await RenameLayoutAsync(context))">
                    이름변경
                </MudButton>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                         Dense="true" Variant="Variant.Outlined">
                    <MudMenuItem Icon="@Icons.Material.Filled.FileDownload"
                                 OnClick="@(async () => await ExportLayoutAsync(context))">
                        JSON 내보내기
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.FileUpload"
                                 OnClick="@(() => TriggerImportFile(context.Id))">
                        JSON 가져오기
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Image"
                                 OnClick="@(async () => await DownloadImageAsync(context))"
                                 Disabled="@(!_configMap.TryGetValue(context.Id, out var imgCfg) || string.IsNullOrEmpty(imgCfg.ImagePath))">
                        이미지 내보내기
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.FileUpload"
                                 Href="@($"/admin/layout/{context.Id}?tab=dexa")">
                        이전 TWMS 레이아웃 가져오기
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                 OnClick="@(async () => await DeleteLayoutAsync(context))"
                                 Disabled="_layouts.Count <= 1">
                        삭제
                    </MudMenuItem>
                </MudMenu>
            </MudStack>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary">레이아웃이 없습니다. 새 레이아웃을 추가하세요.</MudText>
    </NoRecordsContent>
</MudTable>

<InputFile id="layout-json-import" OnChange="OnImportFileSelected" accept=".json" style="display:none;" />

<MudOverlay Visible="_importing" DarkBackground="true" ZIndex="9999" Class="d-flex align-center justify-center">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.body1" Color="Color.Primary">가져오는 중...</MudText>
    </MudStack>
</MudOverlay>

@code {
    private List<TwmsLayout> _layouts = [];
    private Dictionary<int, TwmsBlueprintConfig> _configMap = new();
    private int _importTargetLayoutId;
    private bool _importing;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _layouts = await LayoutDb.GetAllLayoutsAsync();
        _configMap.Clear();
        foreach (var layout in _layouts)
        {
            var cfg = await LayoutDb.GetBlueprintConfigAsync(layout.Id);
            if (cfg != null)
                _configMap[layout.Id] = cfg;
        }
    }

    // ──────────────── 레이아웃 CRUD ────────────────

    private async Task CreateLayoutAsync()
    {
        var name = await PromptNameAsync("새 레이아웃", "새 레이아웃 이름을 입력하세요.");
        if (string.IsNullOrWhiteSpace(name)) return;

        var newId = await LayoutDb.InsertLayoutAsync(new TwmsLayout { Name = name });
        await ReloadAsync();
        Snackbar.Add($"레이아웃 '{name}'이(가) 생성되었습니다.", Severity.Success);
    }

    private async Task DuplicateLayoutAsync(TwmsLayout layout)
    {
        var name = await PromptNameAsync("레이아웃 복제", $"'{layout.Name}' 복제본 이름을 입력하세요.", $"{layout.Name} (복사)");
        if (string.IsNullOrWhiteSpace(name)) return;

        await LayoutDb.DuplicateLayoutAsync(layout.Id, name);
        await ReloadAsync();
        Snackbar.Add($"레이아웃이 '{name}'(으)로 복제되었습니다.", Severity.Success);
    }

    private async Task RenameLayoutAsync(TwmsLayout layout)
    {
        var name = await PromptNameAsync("이름 변경", "새 이름을 입력하세요.", layout.Name);
        if (string.IsNullOrWhiteSpace(name)) return;

        layout.Name = name;
        await LayoutDb.UpdateLayoutAsync(layout);
        await ReloadAsync();
        Snackbar.Add($"레이아웃 이름이 '{name}'(으)로 변경되었습니다.", Severity.Success);
    }

    private async Task ReorderLayoutsAsync()
    {
        if (_layouts.Count <= 1) return;

        var parameters = new DialogParameters<LayoutReorderDialog>
        {
            { x => x.Layouts, _layouts.ToList() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LayoutReorderDialog>("레이아웃 순서 변경", parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;

        if (result.Data is List<TwmsLayout> reordered)
        {
            var sortOrders = reordered.Select((l, i) => (l.Id, SortOrder: i)).ToList();
            await LayoutDb.UpdateLayoutSortOrdersAsync(sortOrders);
            await ReloadAsync();
            LayoutNotification.NotifyLayoutChanged(0);
            Snackbar.Add("레이아웃 순서가 변경되었습니다.", Severity.Success);
        }
    }

    private async Task DeleteLayoutAsync(TwmsLayout layout)
    {
        if (_layouts.Count <= 1) return;

        var result = await DialogService.ShowMessageBox(
            "레이아웃 삭제",
            $"'{layout.Name}' 레이아웃과 모든 설정(도면, 라인 영역, 자산 배치)을 삭제하시겠습니까?",
            yesText: "삭제", cancelText: "취소");
        if (result != true) return;

        await LayoutDb.DeleteLayoutAsync(layout.Id);
        await ReloadAsync();
        Snackbar.Add("레이아웃이 삭제되었습니다.", Severity.Info);
    }

    private async Task<string?> PromptNameAsync(string title, string message, string? defaultValue = null)
    {
        var parameters = new DialogParameters<InputDialog>
        {
            { x => x.Message, message },
            { x => x.DefaultValue, defaultValue },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<InputDialog>(title, parameters, options);
        var dialogResult = await dialog.Result;
        if (dialogResult == null || dialogResult.Canceled) return null;
        return dialogResult.Data as string;
    }

    // ──────────────── 이미지 내보내기 ────────────────

    private async Task DownloadImageAsync(TwmsLayout layout)
    {
        if (!_configMap.TryGetValue(layout.Id, out var cfg) || string.IsNullOrEmpty(cfg.ImagePath)) return;
        var filePath = Path.Combine(TwmsDataPath.Base, cfg.ImagePath);
        if (!File.Exists(filePath)) { Snackbar.Add("이미지 파일을 찾을 수 없습니다.", Severity.Warning); return; }
        var bytes = await File.ReadAllBytesAsync(filePath);
        var base64 = Convert.ToBase64String(bytes);
        var ext = Path.GetExtension(filePath);
        var mime = ext switch { ".png" => "image/png", ".jpg" or ".jpeg" => "image/jpeg", ".webp" => "image/webp", _ => "application/octet-stream" };
        var fileName = $"{layout.Name}{ext}";
        await JS.InvokeVoidAsync("eval",
            $"((d,m,n)=>{{const b=atob(d),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);const u=URL.createObjectURL(new Blob([a],{{type:m}})),l=document.createElement('a');l.href=u;l.download=n;l.click();URL.revokeObjectURL(u)}})('{base64}','{mime}','{fileName}')");
    }

    // ──────────────── JSON Export / Import ────────────────

    private async Task ExportLayoutAsync(TwmsLayout layout)
    {
        try
        {
            var data = await LayoutDb.ExportLayoutAsync(layout.Id, layout.Name);
            var json = System.Text.Json.JsonSerializer.Serialize(data, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
            });
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
            var fileName = $"layout-{layout.Name}-{DateTime.Now:yyyyMMdd-HHmm}.json";
            await JS.InvokeVoidAsync("eval",
                $"((d,n)=>{{const b=atob(d),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);const u=URL.createObjectURL(new Blob([a],{{type:'application/json'}})),l=document.createElement('a');l.href=u;l.download=n;l.click();URL.revokeObjectURL(u)}})('{base64}','{fileName}')");
            Snackbar.Add($"'{layout.Name}' 레이아웃이 내보내기되었습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"내보내기 오류: {ex.Message}", Severity.Error);
        }
    }

    private async Task TriggerImportFile(int layoutId)
    {
        _importTargetLayoutId = layoutId;
        await JS.InvokeVoidAsync("eval", "document.getElementById('layout-json-import').click()");
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var layout = _layouts.FirstOrDefault(l => l.Id == _importTargetLayoutId);
        if (layout == null) return;

        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var data = await System.Text.Json.JsonSerializer.DeserializeAsync<LayoutExportData>(stream,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });

            if (data == null || data.Version < 1)
            {
                Snackbar.Add("유효하지 않은 JSON 파일입니다.", Severity.Error);
                return;
            }

            if (data.Positions.Count == 0 && data.Groups.Count == 0 && data.BlueprintRects.Count == 0)
            {
                Snackbar.Add("가져올 데이터가 없는 JSON 파일입니다.", Severity.Warning);
                return;
            }

            // 확인 다이얼로그
            var sourceInfo = $"원본: {data.LayoutName ?? "알 수 없음"} ({data.ExportedAt:yyyy-MM-dd HH:mm})";
            var contentInfo = $"자산 {data.Positions.Count}개, 그룹 {data.Groups.Count}개, 라인 영역 {data.BlueprintRects.Count}개";
            var confirm = await DialogService.ShowMessageBox(
                "레이아웃 데이터 가져오기",
                $"'{layout.Name}'에 다음 데이터를 덮어쓰시겠습니까?\n\n{sourceInfo}\n{contentInfo}\n\n기존 배치/그룹/라인 영역이 모두 교체됩니다.",
                yesText: "가져오기", cancelText: "취소");
            if (confirm != true) return;

            _importing = true;
            StateHasChanged();
            await Task.Yield();

            // 유효한 자산 ID 목록
            var allAssets = await AssetStatusService.GetAssetStatusesAsync();
            var validIds = allAssets.Select(a => a.AssetId).ToHashSet();

            var (positions, groups, rects, skipped) = await LayoutDb.ImportLayoutAsync(_importTargetLayoutId, data, validIds);

            _importing = false;
            var msg = $"완료 — 자산 {positions}개, 그룹 {groups}개, 라인 영역 {rects}개 가져옴";
            if (skipped > 0) msg += $" (건너뜀: {skipped})";
            Snackbar.Add(msg, Severity.Success);
            await ReloadAsync();
        }
        catch (System.Text.Json.JsonException)
        {
            Snackbar.Add("JSON 형식이 올바르지 않습니다. 레이아웃 내보내기 파일인지 확인하세요.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"가져오기 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }
}
