@using static Twms2.Server.Helpers.LayoutHelpers
@inject LayoutDbService LayoutDb
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

@* ── 툴바 ── *@
<MudPaper Class="pa-2 mb-2 d-flex align-center gap-2 flex-wrap" Elevation="1">
    <MudToggleIconButton Toggled="_snapEnabled"
                         Icon="@Icons.Material.Filled.GridOff"
                         ToggledIcon="@Icons.Material.Filled.Grid4x4"
                         Size="Size.Small" Color="Color.Default" ToggledColor="Color.Info"
                         ToggledChanged="OnSnapToggled" />
    <MudNumericField T="int" Value="_snapGridSize" ValueChanged="OnSnapGridChanged"
                     Label="Grid" Variant="Variant.Text" Min="5" Max="100" Step="5"
                     Style="width: 60px;" Margin="Margin.Dense" HideSpinButtons="true" />
    <MudDivider Vertical="true" FlexItem="true" />
    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" OnClick="ZoomOut" />
    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="ZoomIn" />
    <MudIconButton Icon="@Icons.Material.Filled.CenterFocusWeak" Size="Size.Small" OnClick="ZoomReset" />
    <MudDivider Vertical="true" FlexItem="true" />
    <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small"
                   Disabled="@(_undoStack.Count == 0)" OnClick="Undo" />
    <MudIconButton Icon="@Icons.Material.Filled.Redo" Size="Size.Small"
                   Disabled="@(_redoStack.Count == 0)" OnClick="Redo" />
    <MudSpacer />
    @if (_hasChanges)
    {
        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text">변경됨</MudChip>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Check"
               OnClick="SaveAllRectsAsync" Disabled="_saving">
        @(_saving ? "저장 중..." : "저장")
    </MudButton>
</MudPaper>

@* ── 메인 레이아웃: 좌측 패널 + 캔버스 ── *@
<div class="ap-editor-layout">
    @* ── 좌측 패널 ── *@
    <div class="ap-left-panel">
        @* ── 배치된 라인 목록 ── *@
            @if (_rects.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1" Style="font-weight: 600;">
                    배치된 라인 (@_rects.Count)
                </MudText>
                <div style="max-height: 300px; overflow-y: auto; margin-bottom: 8px;">
                    @foreach (var rect in _rects)
                    {
                        var line = _lines.FirstOrDefault(l => l.Id == rect.LineId);
                        var label = line?.Name ?? $"Line {rect.LineId}";
                        <div class="d-flex align-center gap-2 pa-2" style="border-bottom: 1px solid rgba(0,0,0,0.06);">
                            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Color="Color.Primary" />
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@label</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @($"{rect.Width:F0} × {rect.Height:F0}")
                                </MudText>
                            </div>
                        </div>
                    }
                </div>
            }

            @* ── 배치되지 않은 라인 ── *@
            @{ var unplaced = GetUnplacedLines(); }
            @if (unplaced.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1" Color="Color.Secondary" Style="font-weight: 600;">
                    미배치 라인 (@unplaced.Count)
                </MudText>
                <div style="max-height: 200px; overflow-y: auto;">
                    @foreach (var line in unplaced)
                    {
                        <div class="d-flex align-center gap-2 pa-1" style="border-bottom: 1px solid rgba(0,0,0,0.06);">
                            <MudIcon Icon="@Icons.Material.Filled.AddBox" Size="Size.Small" Color="Color.Default" />
                            <MudText Typo="Typo.body2" Class="flex-grow-1">@line.Name</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="() => AddRectForSpecificLine(line.Id)" />
                        </div>
                    }
                </div>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add" FullWidth="true" Class="mt-3"
                       OnClick="AddRectForLine" Disabled="_lines.Count == 0">
                라인 추가
            </MudButton>
        </div>

        @* ── 캔버스 ── *@
        <div class="ap-canvas-area">
            <div id="bp-editor-container" class="ap-canvas-container">
                <svg id="bp-editor-svg" class="drawing-editor-svg" viewBox="0 0 1000 600"
                     preserveAspectRatio="xMidYMid meet">
                @* 그리드 배경 *@
                @{
                    var bpGridSmall = _config?.GridSize > 0 ? _config.GridSize : 20;
                    var bpGridLarge = bpGridSmall * 5;
                    var bpGridEnabled = _config?.GridEnabled ?? true;
                }
                <defs>
                    <pattern id="bp-grid-small" width="@bpGridSmall" height="@bpGridSmall" patternUnits="userSpaceOnUse">
                        <path d="M @bpGridSmall 0 L 0 0 0 @bpGridSmall" fill="none"
                              stroke="@(_config?.GridColor ?? "#e0e0e0")"
                              stroke-width="0.5" opacity="0.2" />
                    </pattern>
                    <pattern id="bp-grid-large" width="@bpGridLarge" height="@bpGridLarge" patternUnits="userSpaceOnUse">
                        <rect width="@bpGridLarge" height="@bpGridLarge" fill="url(#bp-grid-small)" />
                        <path d="M @bpGridLarge 0 L 0 0 0 @bpGridLarge" fill="none"
                              stroke="@(_config?.GridColor ?? "#e0e0e0")"
                              stroke-width="0.8" opacity="0.3" />
                    </pattern>
                </defs>
                @* 넓은 배경 (줌아웃 대응) *@
                <rect x="-2000" y="-2000" width="5000" height="4000" fill="#111122" />
                @* 배경색 + 그리드 *@
                <rect width="1000" height="600" fill="@(_config?.BgColor ?? "#1a1a2e")" />
                @if (bpGridEnabled)
                {
                    <rect width="1000" height="600" fill="url(#bp-grid-large)" />
                }
                @* 도면 영역 경계선 *@
                <rect width="1000" height="600" fill="none"
                      stroke="#ffffff" stroke-width="2" stroke-dasharray="8 4" opacity="0.4" />

                @* ── 도면 이미지 배경 (읽기전용) ── *@
                @if (!string.IsNullOrEmpty(_config?.ImagePath))
                {
                    var ir = CalcImageRect(_config);
                    <image href="@_config.ImagePath"
                           x="@F(ir.X)" y="@F(ir.Y)" width="@F(ir.W)" height="@F(ir.H)"
                           preserveAspectRatio="none" opacity="0.5" />
                }

                @* ── 라인 영역 사각형 (편집 가능) ── *@
                @foreach (var rect in _rects)
                {
                    var line = _lines.FirstOrDefault(l => l.Id == rect.LineId);
                    var label = line?.Name ?? $"Line {rect.LineId}";

                    <g class="bp-edit-rect" data-line-id="@rect.LineId">
                        <rect class="bp-rect-fill"
                              x="@F(rect.X)" y="@F(rect.Y)"
                              width="@F(rect.Width)" height="@F(rect.Height)"
                              rx="3" ry="3" />
                        <rect class="bp-rect-border"
                              x="@F(rect.X)" y="@F(rect.Y)"
                              width="@F(rect.Width)" height="@F(rect.Height)"
                              rx="3" ry="3" />
                        <text x="@F(rect.X + rect.Width / 2)"
                              y="@F(rect.Y + rect.Height / 2)"
                              text-anchor="middle" dominant-baseline="central"
                              class="bp-rect-label">@label</text>
                    </g>
                }
                @* ── 핸들/삭제 버튼 (별도 레이어 — 항상 최상단) ── *@
                @foreach (var rect in _rects)
                {
                    <g class="bp-edit-rect" data-line-id="@rect.LineId">
                        @* 리사이즈 핸들 (우하단) *@
                        <rect class="bp-resize-handle"
                              x="@F(rect.X + rect.Width - 15)"
                              y="@F(rect.Y + rect.Height - 15)"
                              width="30" height="30" rx="3" />
                        @* 삭제 버튼 (우상단) *@
                        <g class="bp-delete-btn" data-delete="@rect.LineId">
                            <circle cx="@F(rect.X + rect.Width)" cy="@F(rect.Y)"
                                    r="15" />
                            <text x="@F(rect.X + rect.Width)" y="@F(rect.Y)"
                                  text-anchor="middle" dominant-baseline="central"
                                  class="bp-delete-text">×</text>
                        </g>
                    </g>
                }
                </svg>
            </div>
        </div>
    </div>

@code {
    [Parameter] public int LayoutId { get; set; }

    private TwmsBlueprintConfig? _config;
    private List<TwmsBlueprintRect> _rects = [];
    private List<TwmsLayoutLine> _lines = [];

    public bool HasUnsavedChanges => _hasChanges;
    private bool _saving;
    private bool _hasChanges;
    private int _prevLayoutId;
    private bool _snapEnabled = true;
    private int _snapGridSize = 20;
    private DotNetObjectReference<BlueprintEditor>? _dotNetRef;

    // ═══ Undo / Redo ═══
    private readonly List<List<RectSnapshot>> _undoStack = [];
    private readonly List<List<RectSnapshot>> _redoStack = [];
    private const int MaxUndoSteps = 30;
    private record RectSnapshot(int LineId, double X, double Y, double W, double H);

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _prevLayoutId = LayoutId;
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (LayoutId != _prevLayoutId && LayoutId > 0)
        {
            _prevLayoutId = LayoutId;
            await LoadDataAsync();
            StateHasChanged();
            await Task.Delay(50);
            await InitEditorJs();
        }
    }

    private async Task LoadDataAsync()
    {
        if (LayoutId == 0) return;
        var configTask = LayoutDb.GetBlueprintConfigAsync(LayoutId);
        var rectsTask  = LayoutDb.GetAllBlueprintRectsAsync(LayoutId);
        var linesTask  = LayoutDb.GetAllTwmsLayoutLinesAsync();
        await Task.WhenAll(configTask, rectsTask, linesTask);

        _config = configTask.Result;
        _rects  = rectsTask.Result;
        _lines  = linesTask.Result;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await InitEditorJs();
    }

    private async Task InitEditorJs()
    {
        try
        {
            await JS.InvokeVoidAsync("blueprintZoom.init", "bp-editor-container",
                new { clampMargin = 1.0 });
            await JS.InvokeVoidAsync("blueprintEditor.init", "bp-editor-container", _dotNetRef);
        }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomIn()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.zoomIn", "bp-editor-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomOut()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.zoomOut", "bp-editor-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ZoomReset()
    {
        try { await JS.InvokeVoidAsync("blueprintZoom.reset", "bp-editor-container"); }
        catch (JSDisconnectedException) { }
    }

    private async Task OnSnapToggled(bool toggled)
    {
        _snapEnabled = toggled;
        try { await JS.InvokeVoidAsync("blueprintEditor.setSnapConfig", "bp-editor-container", toggled, _snapGridSize); }
        catch (JSDisconnectedException) { }
    }

    private async Task OnSnapGridChanged(int size)
    {
        _snapGridSize = Math.Clamp(size, 5, 100);
        try { await JS.InvokeVoidAsync("blueprintEditor.setSnapConfig", "bp-editor-container", _snapEnabled, _snapGridSize); }
        catch (JSDisconnectedException) { }
    }

    // ═══════════════ Undo / Redo ═══════════════

    private List<RectSnapshot> TakeSnapshot() =>
        _rects.Select(r => new RectSnapshot(r.LineId, r.X, r.Y, r.Width, r.Height)).ToList();

    private void PushUndo()
    {
        _undoStack.Add(TakeSnapshot());
        if (_undoStack.Count > MaxUndoSteps) _undoStack.RemoveAt(0);
        _redoStack.Clear();
    }

    private async Task Undo()
    {
        if (_undoStack.Count == 0) return;
        _redoStack.Add(TakeSnapshot());
        var snap = _undoStack[^1];
        _undoStack.RemoveAt(_undoStack.Count - 1);
        RestoreSnapshot(snap);
        StateHasChanged();
        await Task.Delay(50);
        await InitEditorJs();
    }

    private async Task Redo()
    {
        if (_redoStack.Count == 0) return;
        _undoStack.Add(TakeSnapshot());
        var snap = _redoStack[^1];
        _redoStack.RemoveAt(_redoStack.Count - 1);
        RestoreSnapshot(snap);
        StateHasChanged();
        await Task.Delay(50);
        await InitEditorJs();
    }

    private void RestoreSnapshot(List<RectSnapshot> snap)
    {
        _rects.Clear();
        foreach (var s in snap)
        {
            _rects.Add(new TwmsBlueprintRect
            {
                LayoutId = LayoutId, LineId = s.LineId,
                X = s.X, Y = s.Y, Width = s.W, Height = s.H,
            });
        }
    }

    // ═══════════════ JS Callbacks ═══════════════

    [JSInvokable]
    public void OnRectMoved(int lineId, double x, double y, double w, double h)
    {
        var rect = _rects.FirstOrDefault(r => r.LineId == lineId);
        if (rect != null)
        {
            PushUndo();
            rect.X = Math.Round(x, 2);
            rect.Y = Math.Round(y, 2);
            rect.Width = Math.Round(Math.Max(30, w), 2);
            rect.Height = Math.Round(Math.Max(20, h), 2);
            _hasChanges = true;
            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnRectDeleted(int lineId)
    {
        PushUndo();
        _rects.RemoveAll(r => r.LineId == lineId);
        await LayoutDb.DeleteBlueprintRectAsync(LayoutId, lineId);
        _hasChanges = true;
        Snackbar.Add("라인 영역이 삭제되었습니다.", Severity.Info);
        await InvokeAsync(StateHasChanged);
        await InitEditorJs();
    }

    private async Task AddRectForLine()
    {
        var unplaced = GetUnplacedLines();
        if (unplaced.Count == 0)
        {
            Snackbar.Add("모든 라인이 이미 배치되었습니다.", Severity.Info);
            return;
        }
        await AddRectForSpecificLine(unplaced[0].Id);
    }

    private async Task AddRectForSpecificLine(int lineId)
    {
        if (_rects.Any(r => r.LineId == lineId)) return;
        PushUndo();

        var idx = _rects.Count;
        var newRect = new TwmsBlueprintRect
        {
            LayoutId = LayoutId,
            LineId = lineId,
            X = 50 + (idx % 4) * 220,
            Y = 50 + (idx / 4) * 150,
            Width = 180,
            Height = 120,
        };
        _rects.Add(newRect);
        _hasChanges = true;
        StateHasChanged();

        await Task.Delay(50);
        await InitEditorJs();
    }

    private List<TwmsLayoutLine> GetUnplacedLines()
    {
        var placedIds = _rects.Select(r => r.LineId).ToHashSet();
        return _lines.Where(l => !placedIds.Contains(l.Id)).ToList();
    }

    private async Task SaveAllRectsAsync()
    {
        _saving = true;
        try
        {
            var positions = await JS.InvokeAsync<List<RectPosition>>("blueprintEditor.getPositions",
                "bp-editor-container");
            if (positions != null)
            {
                foreach (var pos in positions)
                {
                    var rect = _rects.FirstOrDefault(r => r.LineId == pos.LineId);
                    if (rect != null)
                    {
                        rect.X = pos.X; rect.Y = pos.Y;
                        rect.Width = pos.W; rect.Height = pos.H;
                    }
                }
            }

            foreach (var rect in _rects)
            {
                rect.LayoutId = LayoutId;
                await LayoutDb.UpsertBlueprintRectAsync(rect);
            }

            _hasChanges = false;
            Snackbar.Add($"{_rects.Count}개 라인 영역이 저장되었습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장 중 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("blueprintEditor.dispose", "bp-editor-container");
            await JS.InvokeVoidAsync("blueprintZoom.dispose", "bp-editor-container");
        }
        catch (JSDisconnectedException) { }
        _dotNetRef?.Dispose();
    }

    private record RectPosition(int LineId, double X, double Y, double W, double H);
}
