@inject AssetService AssetService
@inject TwmDbService TwmDb
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject DexaReadService DexaRead
@inject AssetStatusService AssetStatus
@inject IJSRuntime JS
@using Twms2.Server.Models.Dashboard
@using Twms2.Server.Models.Dexa
@using Twms2.Server.Models.Twm

<MudPaper Class="pa-4" Elevation="2" Style="@($"height: {HeightOverride ?? "calc(100vh - 180px)"}; overflow-y: auto;")">
    @* ── 헤더 1행: 아이콘 + 이름 + 상태 ── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        @{ var detailIcon = GetTypeIcon(); }
        @if (!string.IsNullOrEmpty(detailIcon))
        {
            <img src="@detailIcon" class="asset-type-icon-lg" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Large" Color="@GetStatusColor()" />
        }
        <MudStack Spacing="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h5">@Asset.DisplayName</MudText>
                @if (_statusInfo != null)
                {
                    <BackupStatusBadge Health="@_statusInfo.Health" AgentOnline="@_statusInfo.AgentOnline" />
                    @if (_statusInfo.LatestPing != null)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_statusInfo.LatestPing.Reachable ? Color.Success : Color.Error)"
                                 Variant="Variant.Filled"
                                 Icon="@(_statusInfo.LatestPing.Reachable ? Icons.Material.Filled.Wifi : Icons.Material.Filled.WifiOff)"
                                 Style="font-weight: 600; letter-spacing: 0.3px;">
                            @(_statusInfo.LatestPing.Reachable ? "온라인" : "오프라인")
                        </MudChip>
                    }
                }
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @Asset.AssetTypeUserFriendlyName | ID: @Asset.AssetId
            </MudText>
        </MudStack>
    </MudStack>

    @* ── 헤더 2행: 배지 + 버튼 ── *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd"
              Class="mb-4" Style="flex-wrap:wrap; gap:6px;">
        @if (_lastBackupChangedTime != null)
        {
            <MudTooltip Text="마지막 변경 백업 일시">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                         Icon="@Icons.Material.Filled.Schedule">
                    @_lastBackupChangedTime.Value.ToString("yyyy-MM-dd HH:mm")
                </MudChip>
            </MudTooltip>
        }
        @if (_latestVersion != null)
        {
            <MudTooltip Text="최신 백업 버전">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                    v@(_latestVersion)
                </MudChip>
            </MudTooltip>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="DownloadLatestBackup">다운로드</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.History"
                   OnClick="GoToBackupHistory">백업 정보</MudButton>
    </MudStack>

    <MudDivider Class="mb-4" />

    <AuthorizeView>
        <Authorized>
            @if (_editRow != null)
            {
                @* ── 매뉴얼 (자산 정보 위) ── *@
                @if (_matchedManuals.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                        매뉴얼
                    </MudText>
                    <MudStack Spacing="1" Class="mb-4">
                        @foreach (var m in _matchedManuals)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@m.Keyword</MudChip>
                                <MudText Typo="Typo.body2" Style="flex:1;">@m.FileName</MudText>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           Href="@($"/manuals/{m.StoredFileName}")" Target="_blank">
                                    보기
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                    <MudDivider Class="mb-4" />
                }

                <MudGrid>
                    @* ── 왼쪽: 자산 정보 ── *@
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">자산 정보</MudText>
                        <MudStack Spacing="3">
                            <MudTextField @bind-Value="_editRow.Name" Label="자산명"
                                          Variant="Variant.Outlined" />
                            <MudTextField Value="@Asset.AssetTypeUserFriendlyName" Label="자산 타입"
                                          ReadOnly="true" Variant="Variant.Filled" />
                            <MudSelect Value="_editRow.LineId" T="int?"
                                       ValueChanged="OnLineChanged"
                                       Label="라인" Variant="Variant.Outlined"
                                       Clearable="true" Dense="true">
                                @foreach (var (id, name) in _lineMap)
                                {
                                    <MudSelectItem Value="@((int?)id)">@name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="_editRow.Vendor" Label="제조사"
                                          Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="_editRow.Spec" Label="사양"
                                          Variant="Variant.Outlined" />
                            <MudSelect @bind-Value="_editRow.Agent" T="string" Label="에이전트"
                                       Variant="Variant.Outlined" Clearable="true" Dense="true">
                                @foreach (var agent in _agents)
                                {
                                    <MudSelectItem Value="@agent.Name">@agent.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                    </MudItem>

                    @* ── 오른쪽: 연결 정보 ── *@
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">연결 정보</MudText>
                        <MudStack Spacing="3">
                            @if (_typeId is 4)
                            {
                                var viaDisabled = !_editRow.ConnViaEnabled;
                                <MudSwitch @bind-Value="_editRow.ConnViaEnabled" T="bool"
                                           Label="경유 연결 사용 (2단)" Color="Color.Primary" />
                                <MudTextField @bind-Value="_editRow.ConnIpVia" Label="경유 IP"
                                              Variant="Variant.Outlined" Disabled="viaDisabled" />
                            }
                            else if (_typeId is 6 or 7)
                            {
                                <MudTextField @bind-Value="_editRow.ConnIpVia" Label="경유 IP"
                                              Variant="Variant.Outlined" />
                            }
                            <MudTextField @bind-Value="_editRow.DisplayIp" Label="IP"
                                          Variant="Variant.Outlined" />
                            @if (_typeId is 4)
                            {
                                var viaOff = !_editRow.ConnViaEnabled;
                                <MudStack Row="true" Spacing="2">
                                    <MudNumericField @bind-Value="_editRow.ConnBase" T="int"
                                                     Label="Base" Variant="Variant.Outlined"
                                                     Style="flex:1;"
                                                     Disabled="viaOff" />
                                    <MudNumericField @bind-Value="_editRow.ConnSlot" T="int?"
                                                     Label="Slot" Variant="Variant.Outlined"
                                                     Style="flex:1;"
                                                     Disabled="viaOff" />
                                </MudStack>
                            }
                            else if (_typeId is 6 or 7)
                            {
                                <MudStack Row="true" Spacing="2">
                                    <MudNumericField @bind-Value="_editRow.ConnBase" T="int"
                                                     Label="Base" Variant="Variant.Outlined"
                                                     Style="flex:1;" />
                                    <MudNumericField @bind-Value="_editRow.ConnSlot" T="int?"
                                                     Label="Slot" Variant="Variant.Outlined"
                                                     Style="flex:1;" />
                                </MudStack>
                            }
                            <MudNumericField @bind-Value="_editRow.StationNumber" T="int?"
                                             Label="Station" Variant="Variant.Outlined"
                                             />
                            @if (_typeId is 4)
                            {
                                <MudStack Row="true" Spacing="2">
                                    <MudTextField @bind-Value="_editRow.ModelName" Label="모델명"
                                                  Variant="Variant.Outlined" Style="flex:1;" />
                                    <MudTextField @bind-Value="_editRow.ModelVersion" Label="버전"
                                                  Variant="Variant.Outlined" Style="flex:1;" />
                                </MudStack>
                            }
                            @if (_typeId is 6)
                            {
                                var isRobot = _editRow.ConnIsRobot == 1;
                                <MudCheckBox Value="@isRobot"
                                             ValueChanged="@((bool v) => _editRow.ConnIsRobot = v ? 1 : null)"
                                             T="bool" Label="로봇 PLC" />
                            }
                        </MudStack>
                    </MudItem>

                    @* ── 설명 (전체 너비) ── *@
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_editRow.Description" Label="설명"
                                      Lines="6" AutoGrow="true" MaxLines="15"
                                      Variant="Variant.Outlined"
                                      Placeholder="이 자산에 대한 설명을 입력하세요..." />
                    </MudItem>
                </MudGrid>

                @* 저장 버튼 *@
                <MudStack Row="true" Class="mt-4" Spacing="2">
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAll"
                               Disabled="@(!_editRow.IsModified || _saving)">
                        저장
                    </MudButton>
                </MudStack>

                @* ── 전체 매뉴얼 드롭다운 ── *@
                @if (_allManuals.Count > 0)
                {
                    <MudDivider Class="my-4" />
                    <MudExpansionPanels Elevation="0" Dense="true">
                        <MudExpansionPanel>
                            <TitleContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">전체 매뉴얼 목록</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default">@_allManuals.Count</MudChip>
                                </MudStack>
                            </TitleContent>
                            <ChildContent>
                                <MudStack Spacing="1">
                                    @foreach (var m in _allManuals)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@m.Keyword</MudChip>
                                            <MudText Typo="Typo.body2" Style="flex:1;">@m.FileName</MudText>
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                                       Href="@($"/manuals/{m.StoredFileName}")" Target="_blank">
                                                보기
                                            </MudButton>
                                        </MudStack>
                                    }
                                </MudStack>
                            </ChildContent>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            }
        </Authorized>
        <NotAuthorized>
            @* ── 매뉴얼 (자산 정보 위) ── *@
            @if (_matchedManuals.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                    매뉴얼
                </MudText>
                <MudStack Spacing="1" Class="mb-4">
                    @foreach (var m in _matchedManuals)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@m.Keyword</MudChip>
                            <MudText Typo="Typo.body2" Style="flex:1;">@m.FileName</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                       Href="@($"/manuals/{m.StoredFileName}")" Target="_blank">
                                보기
                            </MudButton>
                        </MudStack>
                    }
                </MudStack>
                <MudDivider Class="mb-4" />
            }

            <MudGrid>
                @* ── 왼쪽: 자산 정보 ── *@
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">자산 정보</MudText>
                    <MudStack Spacing="3">
                        <MudTextField Value="@Asset.Name" Label="자산명"
                                      ReadOnly="true" Variant="Variant.Filled" />
                        <MudTextField Value="@Asset.AssetTypeUserFriendlyName" Label="자산 타입"
                                      ReadOnly="true" Variant="Variant.Filled" />
                        @if (!string.IsNullOrEmpty(Asset.LayoutLineName))
                        {
                            <MudTextField Value="@Asset.LayoutLineName" Label="라인"
                                          ReadOnly="true" Variant="Variant.Filled" />
                        }
                        @if (!string.IsNullOrEmpty(Asset.AugVendor))
                        {
                            <MudTextField Value="@Asset.AugVendor" Label="제조사"
                                          ReadOnly="true" Variant="Variant.Filled" />
                        }
                        @if (!string.IsNullOrEmpty(Asset.AugSpec))
                        {
                            <MudTextField Value="@Asset.AugSpec" Label="사양"
                                          ReadOnly="true" Variant="Variant.Filled" />
                        }
                        @if (!string.IsNullOrEmpty(Asset.AssetAgentPreferences))
                        {
                            <MudTextField Value="@Asset.AssetAgentPreferences" Label="에이전트"
                                          ReadOnly="true" Variant="Variant.Filled" />
                        }
                    </MudStack>
                </MudItem>

                @* ── 오른쪽: 연결 정보 ── *@
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">연결 정보</MudText>
                    <MudStack Spacing="3">
                        @if (Asset.AssetTypeId is 4 && Asset.ViaEnabled == true)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="Color.Info">경유 연결 (2단)</MudChip>
                        }
                        @if (!string.IsNullOrEmpty(Asset.AugIpVia) && (Asset.AssetTypeId is not 4 || Asset.ViaEnabled == true))
                        {
                            <MudTextField Value="@Asset.AugIpVia" Label="경유 IP"
                                          ReadOnly="true" Variant="Variant.Filled" />
                        }
                        <MudTextField Value="@Asset.Ip" Label="IP"
                                      ReadOnly="true" Variant="Variant.Filled" />
                        @if (!string.IsNullOrEmpty(Asset.AugIpVia) && (Asset.AssetTypeId is not 4 || Asset.ViaEnabled == true))
                        {
                            <MudStack Row="true" Spacing="2">
                                <MudTextField Value="@(Asset.AugBaseNumber?.ToString() ?? "-")" Label="Base"
                                              ReadOnly="true" Variant="Variant.Filled" Style="flex:1;" />
                                <MudTextField Value="@(Asset.AugSlotNumber?.ToString() ?? "-")" Label="Slot"
                                              ReadOnly="true" Variant="Variant.Filled" Style="flex:1;" />
                            </MudStack>
                        }
                        @if (Asset.AugStationNumber.HasValue)
                        {
                            <MudTextField Value="@Asset.AugStationNumber.ToString()" Label="Station"
                                          ReadOnly="true" Variant="Variant.Filled" />
                        }
                        @if (!string.IsNullOrEmpty(Asset.ModelName) || !string.IsNullOrEmpty(Asset.ModelVersion))
                        {
                            <MudStack Row="true" Spacing="2">
                                <MudTextField Value="@(Asset.ModelName ?? "-")" Label="모델명"
                                              ReadOnly="true" Variant="Variant.Filled" Style="flex:1;" />
                                <MudTextField Value="@(Asset.ModelVersion ?? "-")" Label="버전"
                                              ReadOnly="true" Variant="Variant.Filled" Style="flex:1;" />
                            </MudStack>
                        }
                        @if (Asset.AssetTypeId is 6)
                        {
                            <MudTextField Value="@(Asset.AugIsRobotPLC is > 0 ? "Yes" : "No")" Label="로봇 PLC"
                                          ReadOnly="true" Variant="Variant.Filled" />
                        }
                    </MudStack>
                </MudItem>

                @* ── 설명 ── *@
                @if (!string.IsNullOrEmpty(Asset.Description))
                {
                    <MudItem xs="12">
                        <MudTextField Value="@Asset.Description" Label="설명"
                                      Lines="6" AutoGrow="true" MaxLines="15"
                                      ReadOnly="true" Variant="Variant.Filled" />
                    </MudItem>
                }
            </MudGrid>

            @* ── 전체 매뉴얼 드롭다운 ── *@
            @if (_allManuals.Count > 0)
            {
                <MudDivider Class="my-4" />
                <MudExpansionPanels Elevation="0" Dense="true">
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">전체 매뉴얼 목록</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default">@_allManuals.Count</MudChip>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="1">
                                @foreach (var m in _allManuals)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@m.Keyword</MudChip>
                                        <MudText Typo="Typo.body2" Style="flex:1;">@m.FileName</MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                                   Href="@($"/manuals/{m.StoredFileName}")" Target="_blank">
                                            보기
                                        </MudButton>
                                    </MudStack>
                                }
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </NotAuthorized>
    </AuthorizeView>
</MudPaper>

@code {
    [Parameter] public ViewAsset Asset { get; set; } = null!;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public string? HeightOverride { get; set; }

    private AssetEditRow? _editRow;
    private Dictionary<int, string> _lineMap = [];
    private List<Agent> _agents = [];
    private int _typeId;
    private bool _saving;

    private AssetStatusInfo? _statusInfo;
    private int? _latestVersion;
    private DateTime? _lastBackupChangedTime;
    private List<TwmsManual> _matchedManuals = [];
    private List<TwmsManual> _allManuals = [];

    protected override async Task OnParametersSetAsync()
    {
        _typeId = Asset.AssetTypeId ?? 0;
        await Task.WhenAll(LoadEditRowAsync(), LoadStatusAsync(), LoadManualsAsync());
    }

    private async Task LoadManualsAsync()
    {
        var matchedTask = TwmDb.GetManualsByKeywordMatchAsync(Asset.AugSpec ?? "");
        var allTask = TwmDb.GetAllManualsAsync();
        await Task.WhenAll(matchedTask, allTask);
        _matchedManuals = matchedTask.Result;
        _allManuals = allTask.Result;
    }

    private async Task LoadEditRowAsync()
    {
        var augTask = TwmDb.GetTwmsAssetAsync(Asset.AssetId);
        var connTask = TwmDb.GetTwmsAssetConnAsync(Asset.AssetId);
        var lineTask = TwmDb.GetTwmsLayoutLineMapAsync();
        var agentTask = DexaRead.GetAgentsAsync();
        await Task.WhenAll(augTask, connTask, lineTask, agentTask);

        _editRow = AssetEditRow.From(Asset, augTask.Result, connTask.Result);
        _lineMap = lineTask.Result;
        _agents = agentTask.Result;
        _editRow.LineName = _editRow.LineId.HasValue && _lineMap.TryGetValue(_editRow.LineId.Value, out var ln) ? ln : "";
    }

    private async Task LoadStatusAsync()
    {
        var statusTask = AssetStatus.GetAssetStatusesAsync();
        var latestTask = DexaRead.GetLatestActionPerAssetAsync();
        var allActionsTask = DexaRead.GetAllActionsAsync();
        await Task.WhenAll(statusTask, latestTask, allActionsTask);

        _statusInfo = statusTask.Result.FirstOrDefault(s => s.AssetId == Asset.AssetId);
        var latest = latestTask.Result.FirstOrDefault(a => a.AssetId == Asset.AssetId);
        _latestVersion = latest?.Version;

        _lastBackupChangedTime = allActionsTask.Result
            .Where(a => a.AssetId == Asset.AssetId && a.ContentsChanged == true)
            .OrderByDescending(a => a.Finished)
            .FirstOrDefault()?.Finished;
    }

    private void OnLineChanged(int? newLineId)
    {
        if (_editRow == null) return;
        _editRow.LineId = newLineId;
        _editRow.LineName = newLineId.HasValue && _lineMap.TryGetValue(newLineId.Value, out var name) ? name : "";
    }

    private async Task SaveAll()
    {
        if (_editRow == null || !_editRow.IsModified) return;

        _saving = true;
        StateHasChanged();

        try
        {
            var results = await AssetService.SaveAssetEditRowsAsync([_editRow]);
            var result = results.FirstOrDefault();

            if (result.Success)
            {
                Snackbar.Add("저장되었습니다.", Severity.Success);
                await OnSaved.InvokeAsync();
            }
            else
            {
                Snackbar.Add($"저장 실패: {result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장 중 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private string GetTypeIcon() => Asset.AssetTypeUserFriendlyName switch
    {
        var n when n != null && n.Contains("PLC") && Asset.AugIsRobotPLC is > 0 => "images/icons/robot.png",
        var n when n != null && n.Contains("PLC") => "images/icons/plc.png",
        var n when n != null && n.Contains("Servo") => "images/icons/servo.png",
        var n when n != null && (n.Contains("HMI") || n.Contains("XP")) => "images/icons/hmi.png",
        var n when n != null && n.Contains("Drive") => "images/icons/drive.png",
        var n when n != null && n.Contains("FTP") => "images/icons/ftp.png",
        _ => ""
    };

    private Color GetStatusColor() => Color.Primary;

    private async Task DownloadLatestBackup()
    {
        if (_latestVersion == null)
        {
            Snackbar.Add("백업 데이터가 없습니다.", Severity.Warning);
            return;
        }
        var url = $"/api/download/backup/{Asset.AssetId}/{_latestVersion}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void GoToBackupHistory()
    {
        var name = Uri.EscapeDataString(Asset.DisplayName ?? Asset.Name ?? "");
        var end = DateTime.Today.ToString("yyyy-MM-dd");
        Navigation.NavigateTo($"/history?tab=1&q={name}&mode=contains&start=2000-01-01&end={end}");
    }
}
