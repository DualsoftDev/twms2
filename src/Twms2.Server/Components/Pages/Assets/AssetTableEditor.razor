@page "/assets/table"
@attribute [Authorize]
@inject AssetService AssetService
@inject LayoutDbService LayoutDb
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>TWM - 자산 테이블 편집</PageTitle>

@* ── 헤더 바 ──────────────────────────────────────────── *@
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h4">자산 테이블 편집</MudText>
    <MudSpacer />
    @if (_loaded)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-3">
            총 @(_allRows.Count)건 / 수정 @(ModifiedCount)건
        </MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportCsv" Disabled="_saving"
                   Size="Size.Small">
            CSV 내보내기
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.FileUpload"
                   OnClick="TriggerCsvImport" Disabled="_saving"
                   Size="Size.Small">
            CSV 가져오기
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAll" Disabled="_saving">
            새로고침
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAll"
                   Disabled="@(ModifiedCount == 0 || _saving)">
            저장 (@(ModifiedCount)건)
        </MudButton>
    }
</MudStack>

@* ── 진행 / 결과 표시 ────────────────────────────────── *@
@if (_saving)
{
    <MudProgressLinear Value="_progressPercent" Color="Color.Primary" Class="mb-2" />
    <MudText Class="mb-2">저장 중... (@_completed / @_total)</MudText>
}
@if (_resultMsg != null)
{
    <MudAlert Severity="@_resultSeverity" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => _resultMsg = null">
        @_resultMsg
    </MudAlert>
}

@* ── 본문 ───────────────────────────────────────────── *@
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    <MudText Class="mt-2">자산 목록 로딩 중...</MudText>
}
else if (!_loaded)
{
    <MudAlert Severity="Severity.Error">
        자산 목록을 가져올 수 없습니다. DEXA 서버 연결을 확인하세요.
    </MudAlert>
}
else
{
    <MudTabs Elevation="1" Rounded="true" PanelClass="pt-3" @bind-ActivePanelIndex="_activeTab">

        @* 전체 *@
        <MudTabPanel Text='@AllTabLabel()'>
            <AssetEditGrid Rows="@_allRows"
                           ShowAllTypes="true"
                           LineMap="_lineMap"
                           OnFieldChanged="StateHasChanged" />
        </MudTabPanel>

        @* FTP (assetTypeId=3) *@
        <MudTabPanel Text='@TabLabel(3, "FTP")'>
            <AssetEditGrid Rows="@RowsOf(3)"
                           ShowIp="true"
                           LineMap="_lineMap"
                           OnFieldChanged="StateHasChanged" />
        </MudTabPanel>

        @* LS Drive (assetTypeId=4) *@
        <MudTabPanel Text='@TabLabel(4, "드라이브")'>
            <AssetEditGrid Rows="@RowsOf(4)"
                           ShowIp="true" ShowVia="true" ShowVersion="true"
                           LineMap="_lineMap"
                           OnFieldChanged="StateHasChanged" />
        </MudTabPanel>

        @* LS XP Series (assetTypeId=5) *@
        <MudTabPanel Text='@TabLabel(5, "XP Series")'>
            <AssetEditGrid Rows="@RowsOf(5)"
                           ShowIp="true"
                           LineMap="_lineMap"
                           OnFieldChanged="StateHasChanged" />
        </MudTabPanel>

        @* XGT PLC (assetTypeId=6) *@
        <MudTabPanel Text='@TabLabel(6, "XGT PLC")'>
            <AssetEditGrid Rows="@RowsOf(6)"
                           ShowIp="false" ShowConn="true" ShowVia="true" ShowRobot="true"
                           LineMap="_lineMap"
                           OnFieldChanged="StateHasChanged" />
        </MudTabPanel>

        @* LS Servo (assetTypeId=7) *@
        <MudTabPanel Text='@TabLabel(7, "서보")'>
            <AssetEditGrid Rows="@RowsOf(7)"
                           ShowIp="false" ShowConn="true" ShowVia="true"
                           LineMap="_lineMap"
                           OnFieldChanged="StateHasChanged" />
        </MudTabPanel>

    </MudTabs>

    <InputFile id="csv-import-input" OnChange="OnCsvFileSelected" style="display:none"
               accept=".csv" />
}

@code {
    private List<AssetEditRow>     _allRows = [];
    private Dictionary<int, IReadOnlyList<AssetEditRow>> _rowsByType = [];
    private Dictionary<int, string> _lineMap = [];
    private bool   _loaded;
    private bool   _loading = true;
    private bool   _saving;
    private int    _completed, _total;
    private double _progressPercent;
    private int    _activeTab;
    private string? _resultMsg;
    private Severity _resultSeverity = Severity.Success;

    private int ModifiedCount => _allRows.Count(r => r.IsModified);

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        _loading = true;
        _loaded = false;
        _resultMsg = null;
        StateHasChanged();

        try
        {
            var rowsTask = AssetService.GetAssetEditRowsAsync();
            var lineTask = LayoutDb.GetTwmsLayoutLineMapAsync();
            await Task.WhenAll(rowsTask, lineTask);

            _allRows = rowsTask.Result;
            _lineMap = lineTask.Result;
            foreach (var r in _allRows)
                r.LineName = r.LineId.HasValue && _lineMap.TryGetValue(r.LineId.Value, out var ln) ? ln : "";
            _rowsByType = _allRows
                .GroupBy(r => r.AssetTypeId)
                .ToDictionary(g => g.Key, g => (IReadOnlyList<AssetEditRow>)g.ToList());
            _loaded = true;
        }
        catch
        {
            _allRows = [];
            _rowsByType = [];
        }

        _loading = false;
    }

    private IReadOnlyList<AssetEditRow> RowsOf(int typeId) =>
        _rowsByType.TryGetValue(typeId, out var list) ? list : [];

    private string AllTabLabel()
    {
        var count = _allRows.Count;
        var mod   = ModifiedCount;
        return mod > 0 ? $"전체 ({count}) *" : $"전체 ({count})";
    }

    private string TabLabel(int typeId, string name)
    {
        var count = RowsOf(typeId).Count;
        var mod   = RowsOf(typeId).Count(r => r.IsModified);
        return mod > 0 ? $"{name} ({count}) *" : $"{name} ({count})";
    }

    private async Task SaveAll()
    {
        var modified = _allRows.Where(r => r.IsModified).ToList();
        if (modified.Count == 0) return;

        _saving = true;
        _completed = 0;
        _total = modified.Count;
        _progressPercent = 0;
        StateHasChanged();

        var progress = new Progress<(int completed, int total)>(p =>
        {
            _completed = p.completed;
            _total     = p.total;
            _progressPercent = _total > 0 ? (double)_completed / _total * 100 : 0;
            InvokeAsync(StateHasChanged);
        });

        var results = await AssetService.SaveAssetEditRowsAsync(modified, progress);
        _saving = false;

        var fail    = results.Count(r => !r.Success);
        var success = results.Count - fail;
        if (fail == 0)
        {
            _resultMsg      = $"{success}건 저장 완료";
            _resultSeverity = Severity.Success;
            Snackbar.Add(_resultMsg, Severity.Success);
        }
        else
        {
            _resultMsg      = $"성공 {success}건, 실패 {fail}건";
            _resultSeverity = Severity.Warning;
            Snackbar.Add(_resultMsg, Severity.Warning);
        }

        // 탭 레이블 갱신 (IsModified 상태 반영)
        StateHasChanged();
    }

    // ── CSV Export / Import ──────────────────────────────────

    private IReadOnlyList<AssetEditRow> CurrentTabRows => _activeTab switch
    {
        1 => RowsOf(3),
        2 => RowsOf(4),
        3 => RowsOf(5),
        4 => RowsOf(6),
        5 => RowsOf(7),
        _ => _allRows,
    };

    private string CurrentTabName => _activeTab switch
    {
        1 => "FTP",
        2 => "Drive",
        3 => "XP",
        4 => "PLC",
        5 => "Servo",
        _ => "All",
    };

    private async Task ExportCsv()
    {
        var rows = CurrentTabRows;
        if (rows.Count == 0) { Snackbar.Add("내보낼 데이터가 없습니다.", Severity.Warning); return; }

        var bytes = AssetService.ExportCsv(rows);
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"assets-{CurrentTabName}-{DateTime.Now:yyyyMMdd-HHmm}.csv";
        await JS.InvokeVoidAsync("eval",
            $"((d,n)=>{{const b=atob(d),a=new Uint8Array(b.length);for(let i=0;i<b.length;i++)a[i]=b.charCodeAt(i);const u=URL.createObjectURL(new Blob([a],{{type:'text/csv'}})),l=document.createElement('a');l.href=u;l.download=n;l.click();URL.revokeObjectURL(u)}})('{base64}','{fileName}')");
        Snackbar.Add($"{rows.Count}건 CSV 내보내기 완료", Severity.Success);
    }

    private async Task TriggerCsvImport()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('csv-import-input').click()");
    }

    private async Task OnCsvFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var result = AssetService.ApplyCsvImport(_allRows, ms, _lineMap);

            if (result.HasError)
            {
                Snackbar.Add($"CSV 오류: {result.Error}", Severity.Error);
                return;
            }

            var msg = $"CSV 가져오기: {result.Updated}건 변경, {result.Skipped}건 스킵";
            if (result.NotFound > 0) msg += $", {result.NotFound}건 ID 없음(무시)";

            _resultMsg = msg;
            _resultSeverity = result.NotFound > 0 ? Severity.Warning : Severity.Info;
            Snackbar.Add(msg, _resultSeverity);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"파일 읽기 오류: {ex.Message}", Severity.Error);
        }
    }
}
