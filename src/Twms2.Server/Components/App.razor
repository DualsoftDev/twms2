<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="/lib/fonts/fonts.css" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Twms2.Server.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/lib/gridstack/gridstack.min.css" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    @* 폐쇄망 대비 self-host (구 jsdelivr CDN — wwwroot/lib 로 로컬화) *@
    <script src="/lib/echarts/echarts.min.js"></script>
    <script src="/lib/d3/d3.min.js"></script>
    <script src="/lib/gridstack/gridstack-all.js"></script>
    <script src="js/sankey-chart.js"></script>
    <script src="js/dashboard-layout.js"></script>
    <script src="js/imagetracer.min.js"></script>
    <script src="js/logo-converter.js"></script>
    <script src="js/auth-session.js"></script>
    <script src="js/clipboard.js"></script>
    <script src="js/blueprint-editor.js"></script>
    <script src="js/asset-placement-editor.js"></script>
    <script src="js/blueprint-zoom.js"></script>
    <script>
        window.themeStorage = {
            get: () => localStorage.getItem('isDarkMode'),
            set: (v) => localStorage.setItem('isDarkMode', v)
        };
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
