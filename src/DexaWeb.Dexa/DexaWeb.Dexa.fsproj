    <Compile Include="Infrastructure/DexaGuardianActor.fs" />
    <Compile Include="Infrastructure/DexaClientGuardian.fs" />
    <Compile Include="IDexaClient.fs" />
    <Compile Include="DexaClient.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.4.24" />
    <PackageReference Include="Akka.Remote" Version="1.4.24" />
    <PackageReference Include="System.Reactive" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
