    <Compile Include="Messages/Base/AmPong.fs" />
    <Compile Include="Messages/Base/AmSubscribe.fs" />
    <Compile Include="Messages/Base/AmReplySubscription.fs" />
    <Compile Include="Messages/Locker.fs" />
    <Compile Include="Messages/AssetExplorerResult.fs" />
    <Compile Include="Messages/ActorInfo.fs" />
    <Compile Include="Messages/HardwarePerformance.fs" />
    <Compile Include="Messages/ClientInfo.fs" />
    <Compile Include="Messages/AgentInfo.fs" />
    <Compile Include="Messages/AmC2SRequestAssetExplorerBase.fs" />
    <Compile Include="Messages/AmC2SRequestAssetsToFolderBase.fs" />
    <Compile Include="Messages/AmC2STrigger.fs" />
    <Compile Include="Messages/AmExecuteBackup.fs" />
    <Compile Include="Messages/AmInjectSubscription.fs" />
    <Compile Include="Messages/Notifications.fs" />
