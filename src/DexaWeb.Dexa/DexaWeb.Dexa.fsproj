    <Compile Include="Models/Action.fs" />
    <Compile Include="Models/ActionLog.fs" />
    <Compile Include="Models/Agent.fs" />
    <Compile Include="Models/DeepPingError.fs" />
    <Compile Include="Models/DashboardAssetReport.fs" />
    <Compile Include="Models/ViewSchedule.fs" />
    <Compile Include="Messages/DEXActorGlobal.fs" />
    <Compile Include="Messages/ActorType.fs" />
    <Compile Include="Messages/Base/ActorMessage.fs" />
    <Compile Include="Messages/Base/AmReply.fs" />
    <Compile Include="Messages/Base/AmReplyError.fs" />
